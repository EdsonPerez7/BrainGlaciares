---
---

<section class="border-b border-slate-200 bg-white py-14 w-full">
  <div class="w-full px-4 sm:px-8 lg:px-12 xl:px-16 2xl:px-20 space-y-10">
    
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Explora</h2>
      <p class="text-sm text-slate-500 mt-1">Herramientas de análisis territorial y evidencia documental</p>
    </div>

    <!-- 3 Tarjetas de Exploración (Estilo sobrio, limpio y moderno) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1: Mi zona -->
      <div class="rounded-xl border border-slate-200 bg-slate-900 text-white p-6 shadow-sm flex flex-col justify-between hover:border-slate-700 transition">
        <div class="space-y-2">
          <div class="h-2 w-8 rounded-full bg-cyan-400"></div>
          <h3 class="text-lg font-bold tracking-tight text-white">Mi zona</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Las lagunas situadas aguas arriba de tu localidad, evaluando nivel de riesgo histórico, cuencas tributarias y estudios asociados.
          </p>
        </div>
        <div class="mt-6">
          <a href="#buscar" class="inline-flex items-center text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition">
            Buscar mi zona →
          </a>
        </div>
      </div>

      <!-- Card 2: Compara lagunas -->
      <div class="rounded-xl border border-slate-200 bg-slate-900 text-white p-6 shadow-sm flex flex-col justify-between hover:border-slate-700 transition">
        <div class="space-y-2">
          <div class="h-2 w-8 rounded-full bg-rose-400"></div>
          <h3 class="text-lg font-bold tracking-tight text-white">Compara lagunas</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Contraste métrico entre cuerpos de agua: volumen de embalse, obras de seguridad existentes, curvas de publicaciones y relaciones compartidas.
          </p>
        </div>
        <div class="mt-6">
          <a href="#comparar" class="inline-flex items-center text-xs font-semibold text-rose-400 hover:text-rose-300 transition">
            Comparar lagunas →
          </a>
        </div>
      </div>

      <!-- Card 3: El país -->
      <div class="rounded-xl border border-slate-200 bg-slate-900 text-white p-6 shadow-sm flex flex-col justify-between hover:border-slate-700 transition">
        <div class="space-y-2">
          <div class="h-2 w-8 rounded-full bg-indigo-400"></div>
          <h3 class="text-lg font-bold tracking-tight text-white">El país</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Evolución de la superficie glaciar nacional, pérdida de masa acumulada y priorización de obras de mitigación por cordillera.
          </p>
        </div>
        <div class="mt-6">
          <a href="#panorama" class="inline-flex items-center text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition">
            Ver el panorama →
          </a>
        </div>
      </div>

    </div>

    <!-- Banner Institucional de Aportar Estudio -->
    <div class="rounded-xl border border-slate-200 bg-slate-100/80 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="space-y-1">
        <h3 class="text-sm font-bold text-slate-900">¿Cuentas con estudios o mediciones de campo?</h3>
        <p class="text-xs text-slate-500 max-w-xl">
          Si dispones de tesis, informes técnicos o mediciones batimétricas no indexadas, puedes postular el documento para evaluación e incorporación a la ontología.
        </p>
      </div>
      <button 
        type="button" 
        class="whitespace-nowrap rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-800 shadow-sm hover:bg-slate-50 transition"
        onclick="alert('Módulo de recepción documental para investigadores. Contáctate con el Grupo G8 FISI UNMSM.')"
      >
        Aportar documento
      </button>
    </div>

  </div>
</section>
