---
// HeroSection.astro: Recorrido Infinito Vectorial de Cordilleras y Nevados del Perú
// 100% SVG + CSS Keyframes a 60fps con paralaje y difuminado blanco a alta montaña
---

<section class="relative overflow-hidden border-b border-slate-200 bg-[#060c18] w-full min-h-[560px] lg:min-h-[620px] xl:min-h-[660px] flex items-center">
  
  <!-- ======================================================== -->
  <!-- FONDO Y RECORRIDO INFINITO VECTORIAL EN SVG (DERECHA)     -->
  <!-- ======================================================== -->
  <div class="absolute inset-0 w-full h-full overflow-hidden select-none pointer-events-none">
    
    <!-- Cielo estrellado y gradiente astronómico -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#030611] via-[#091224] to-[#121e38]"></div>

    <!-- Puntos de estrellas fijas de fondo -->
    <svg class="absolute inset-0 w-full h-full opacity-60" xmlns="http://www.w3.org/2000/svg">
      <circle cx="15%" cy="12%" r="1" fill="#ffffff" />
      <circle cx="28%" cy="20%" r="1.5" fill="#bae6fd" />
      <circle cx="42%" cy="8%" r="1" fill="#ffffff" />
      <circle cx="58%" cy="15%" r="1.8" fill="#e0f2fe" />
      <circle cx="72%" cy="22%" r="1.2" fill="#ffffff" />
      <circle cx="85%" cy="10%" r="1.5" fill="#bae6fd" />
      <circle cx="93%" cy="25%" r="1" fill="#ffffff" />
      <circle cx="35%" cy="28%" r="1.2" fill="#bae6fd" />
      <circle cx="65%" cy="32%" r="1" fill="#ffffff" />
      <circle cx="80%" cy="38%" r="1.5" fill="#bae6fd" />
    </svg>

    <!-- CAPA 1: Siluetas Lejanas de la Cordillera (Velocidad Lenta: 75s) -->
    <div class="track-paralaje-lenta absolute bottom-0 left-0 h-[480px] w-[4800px] flex">
      <svg class="h-full w-[2400px] shrink-0" viewBox="0 0 2400 480" preserveAspectRatio="none">
        <polygon points="0,480 80,310 240,390 420,250 580,380 750,220 920,360 1120,240 1280,380 1480,210 1660,370 1850,230 2050,390 2240,260 2400,380 2400,480" fill="#0b1428" opacity="0.6" />
      </svg>
      <svg class="h-full w-[2400px] shrink-0" viewBox="0 0 2400 480" preserveAspectRatio="none">
        <polygon points="0,480 80,310 240,390 420,250 580,380 750,220 920,360 1120,240 1280,380 1480,210 1660,370 1850,230 2050,390 2240,260 2400,380 2400,480" fill="#0b1428" opacity="0.6" />
      </svg>
    </div>

    <!-- CAPA 2: Cordillera Intermedia con Aristas Rocosas (Velocidad Media: 45s) -->
    <div class="track-paralaje-media absolute bottom-0 left-0 h-[500px] w-[4800px] flex">
      <svg class="h-full w-[2400px] shrink-0" viewBox="0 0 2400 500" preserveAspectRatio="none">
        <polygon points="0,500 120,360 290,440 500,280 670,410 860,260 1060,420 1260,270 1440,430 1640,270 1830,420 2040,280 2230,420 2400,340 2400,500" fill="#111d36" opacity="0.8" />
      </svg>
      <svg class="h-full w-[2400px] shrink-0" viewBox="0 0 2400 500" preserveAspectRatio="none">
        <polygon points="0,500 120,360 290,440 500,280 670,410 860,260 1060,420 1260,270 1440,430 1640,270 1830,420 2040,280 2230,420 2400,340 2400,500" fill="#111d36" opacity="0.8" />
      </svg>
    </div>

    <!-- CAPA 3: GRANDES NEVADOS Y ETIQUETAS NOMINALES (Velocidad Principal: 32s) -->
    <!-- Contiene Huascarán, Alpamayo, Yerupajá, Ausangate, Hualcán y Palcaraju -->
    <div id="track-cordillera-principal" class="track-paralaje-nevados absolute bottom-0 left-0 h-[560px] w-[4800px] flex pointer-events-auto">
      
      <!-- CICLO 1 (2400px de longitud) -->
      <svg class="h-full w-[2400px] shrink-0" viewBox="0 0 2400 560" preserveAspectRatio="none">
        <defs>
          <linearGradient id="pico-luz-h" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#475569" />
            <stop offset="50%" stop-color="#334155" />
            <stop offset="100%" stop-color="#1e293b" />
          </linearGradient>
          <linearGradient id="pico-sombra-h" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#1e293b" />
            <stop offset="60%" stop-color="#0f172a" />
            <stop offset="100%" stop-color="#020617" />
          </linearGradient>
          <linearGradient id="nieve-h" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ffffff" />
            <stop offset="45%" stop-color="#f0f9ff" />
            <stop offset="85%" stop-color="#bae6fd" />
            <stop offset="100%" stop-color="#38bdf8" />
          </linearGradient>
          <linearGradient id="lago-turq-h" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#38bdf8" />
            <stop offset="100%" stop-color="#0369a1" />
          </linearGradient>
          <filter id="glow-badge" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.6"/>
          </filter>
        </defs>

        <!-- 1. NEVADO HUASCARÁN SUR (6,768 m) - Coloso del Perú -->
        <g id="pico-huascaran" class="cursor-pointer group">
          <!-- Vertientes -->
          <polygon points="340,70 130,560 340,560" fill="url(#pico-luz-h)" />
          <polygon points="340,70 340,560 550,560" fill="url(#pico-sombra-h)" />
          <!-- Casquete glaciar y seracs -->
          <path d="M 340,70 L 250,195 L 290,185 L 320,225 L 340,195 L 370,230 L 400,190 L 430,205 Z" fill="url(#nieve-h)" />
          <path d="M 340,70 L 340,195 L 370,230 L 400,190 L 430,205 Z" fill="#0284c7" opacity="0.35" />
          <!-- Grietas del hielo -->
          <line x1="315" y1="130" x2="330" y2="160" stroke="#0284c7" stroke-width="1.5" />
          <line x1="355" y1="125" x2="345" y2="155" stroke="#0284c7" stroke-width="1.5" />
          <!-- Línea conector a la etiqueta -->
          <line x1="340" y1="70" x2="340" y2="40" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
          <circle cx="340" cy="70" r="3" fill="#38bdf8" />
          <!-- Etiqueta Flotante -->
          <g transform="translate(230, 8)" filter="url(#glow-badge)">
            <rect x="0" y="0" width="220" height="34" rx="17" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5" fill-opacity="0.9" />
            <circle cx="16" cy="17" r="4" fill="#38bdf8" />
            <text x="28" y="16" fill="#ffffff" font-size="12" font-weight="800" font-family="sans-serif">Nevado Huascarán</text>
            <text x="28" y="27" fill="#94a3b8" font-size="9.5" font-weight="600" font-family="sans-serif">6,768 m · Cordillera Blanca</text>
          </g>
        </g>

        <!-- 2. NEVADO ALPAMAYO (5,947 m) - Pirámide Glaciar Emblemática -->
        <g id="pico-alpamayo" class="cursor-pointer group">
          <polygon points="740,140 580,560 740,560" fill="url(#pico-luz-h)" />
          <polygon points="740,140 740,560 900,560" fill="url(#pico-sombra-h)" />
          <path d="M 740,140 L 670,240 L 705,230 L 725,260 L 740,240 L 760,265 L 780,235 L 810,245 Z" fill="url(#nieve-h)" />
          <!-- Estrías de fluting alpino -->
          <line x1="720" y1="180" x2="695" y2="230" stroke="#bae6fd" stroke-width="1.5" opacity="0.8" />
          <line x1="740" y1="170" x2="735" y2="235" stroke="#bae6fd" stroke-width="1.5" opacity="0.8" />
          <line x1="760" y1="180" x2="775" y2="230" stroke="#0284c7" stroke-width="1.5" opacity="0.8" />
          <line x1="740" y1="140" x2="740" y2="105" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
          <circle cx="740" cy="140" r="3" fill="#38bdf8" />
          <!-- Etiqueta Flotante -->
          <g transform="translate(635, 72)" filter="url(#glow-badge)">
            <rect x="0" y="0" width="210" height="34" rx="17" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5" fill-opacity="0.9" />
            <circle cx="16" cy="17" r="4" fill="#38bdf8" />
            <text x="28" y="16" fill="#ffffff" font-size="12" font-weight="800" font-family="sans-serif">Nevado Alpamayo</text>
            <text x="28" y="27" fill="#94a3b8" font-size="9.5" font-weight="600" font-family="sans-serif">5,947 m · Cordillera Blanca</text>
          </g>
        </g>

        <!-- 3. NEVADO YERUPAJÁ (6,635 m) - Cordillera Huayhuash -->
        <g id="pico-yerupaja" class="cursor-pointer group">
          <polygon points="1150,95 940,560 1150,560" fill="url(#pico-luz-h)" />
          <polygon points="1150,95 1150,560 1350,560" fill="url(#pico-sombra-h)" />
          <path d="M 1150,95 L 1060,210 L 1100,200 L 1130,235 L 1150,215 L 1180,245 L 1210,210 L 1240,220 Z" fill="url(#nieve-h)" />
          <line x1="1150" y1="95" x2="1150" y2="60" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
          <circle cx="1150" cy="95" r="3" fill="#38bdf8" />
          <!-- Etiqueta Flotante -->
          <g transform="translate(1040, 28)" filter="url(#glow-badge)">
            <rect x="0" y="0" width="220" height="34" rx="17" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5" fill-opacity="0.9" />
            <circle cx="16" cy="17" r="4" fill="#38bdf8" />
            <text x="28" y="16" fill="#ffffff" font-size="12" font-weight="800" font-family="sans-serif">Nevado Yerupajá</text>
            <text x="28" y="27" fill="#94a3b8" font-size="9.5" font-weight="600" font-family="sans-serif">6,635 m · Cord. Huayhuash</text>
          </g>
        </g>

        <!-- 4. NEVADO AUSANGATE (6,384 m) - Cordillera Vilcanota (Cusco) -->
        <g id="pico-ausangate" class="cursor-pointer group">
          <polygon points="1560,115 1360,560 1560,560" fill="url(#pico-luz-h)" />
          <polygon points="1560,115 1560,560 1760,560" fill="url(#pico-sombra-h)" />
          <path d="M 1560,115 L 1480,220 L 1520,210 L 1545,245 L 1560,225 L 1585,250 L 1615,220 L 1640,230 Z" fill="url(#nieve-h)" />
          <!-- Laguna turquesa de pie de glaciar -->
          <ellipse cx="1470" cy="480" rx="90" ry="22" fill="url(#lago-turq-h)" opacity="0.9" />
          <line x1="1560" y1="115" x2="1560" y2="80" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
          <circle cx="1560" cy="115" r="3" fill="#38bdf8" />
          <!-- Etiqueta Flotante -->
          <g transform="translate(1450, 48)" filter="url(#glow-badge)">
            <rect x="0" y="0" width="220" height="34" rx="17" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5" fill-opacity="0.9" />
            <circle cx="16" cy="17" r="4" fill="#38bdf8" />
            <text x="28" y="16" fill="#ffffff" font-size="12" font-weight="800" font-family="sans-serif">Nevado Ausangate</text>
            <text x="28" y="27" fill="#94a3b8" font-size="9.5" font-weight="600" font-family="sans-serif">6,384 m · Cord. Vilcanota</text>
          </g>
        </g>

        <!-- 5. NEVADO HUALCÁN (6,122 m) & LAGUNA 513 -->
        <g id="pico-hualcan" class="cursor-pointer group">
          <polygon points="1960,120 1770,560 1960,560" fill="url(#pico-luz-h)" />
          <polygon points="1960,120 1960,560 2160,560" fill="url(#pico-sombra-h)" />
          <path d="M 1960,120 L 1880,225 L 1920,215 L 1945,250 L 1960,230 L 1985,255 L 2015,225 L 2040,235 Z" fill="url(#nieve-h)" />
          <!-- Espejo de Laguna 513 -->
          <ellipse cx="1960" cy="460" rx="80" ry="20" fill="url(#lago-turq-h)" />
          <line x1="1960" y1="120" x2="1960" y2="85" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
          <circle cx="1960" cy="120" r="3" fill="#10b981" />
          <!-- Etiqueta Flotante -->
          <g transform="translate(1850, 52)" filter="url(#glow-badge)">
            <rect x="0" y="0" width="220" height="34" rx="17" fill="#0f172a" stroke="#10b981" stroke-width="1.5" fill-opacity="0.9" />
            <circle cx="16" cy="17" r="4" fill="#10b981" />
            <text x="28" y="16" fill="#ffffff" font-size="12" font-weight="800" font-family="sans-serif">Hualcán · Laguna 513</text>
            <text x="28" y="27" fill="#34d399" font-size="9.5" font-weight="600" font-family="sans-serif">6,122 m · Cordillera Blanca</text>
          </g>
        </g>

        <!-- Arista de enlace final hacia x=2400 -->
        <polygon points="2280,130 2120,560 2280,560" fill="url(#pico-luz-h)" />
        <polygon points="2280,130 2280,560 2400,320 2400,560" fill="url(#pico-sombra-h)" />
      </svg>

      <!-- CICLO 2 (Duplicado idéntico de 2400px para bucle infinito perfecto) -->
      <svg class="h-full w-[2400px] shrink-0" viewBox="0 0 2400 560" preserveAspectRatio="none">
        <!-- Replicación exacta para seamless loop -->
        <g id="pico-huascaran-dup" class="cursor-pointer group">
          <polygon points="340,70 130,560 340,560" fill="url(#pico-luz-h)" />
          <polygon points="340,70 340,560 550,560" fill="url(#pico-sombra-h)" />
          <path d="M 340,70 L 250,195 L 290,185 L 320,225 L 340,195 L 370,230 L 400,190 L 430,205 Z" fill="url(#nieve-h)" />
          <path d="M 340,70 L 340,195 L 370,230 L 400,190 L 430,205 Z" fill="#0284c7" opacity="0.35" />
          <line x1="315" y1="130" x2="330" y2="160" stroke="#0284c7" stroke-width="1.5" />
          <line x1="355" y1="125" x2="345" y2="155" stroke="#0284c7" stroke-width="1.5" />
          <line x1="340" y1="70" x2="340" y2="40" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
          <circle cx="340" cy="70" r="3" fill="#38bdf8" />
          <g transform="translate(230, 8)" filter="url(#glow-badge)">
            <rect x="0" y="0" width="220" height="34" rx="17" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5" fill-opacity="0.9" />
            <circle cx="16" cy="17" r="4" fill="#38bdf8" />
            <text x="28" y="16" fill="#ffffff" font-size="12" font-weight="800" font-family="sans-serif">Nevado Huascarán</text>
            <text x="28" y="27" fill="#94a3b8" font-size="9.5" font-weight="600" font-family="sans-serif">6,768 m · Cordillera Blanca</text>
          </g>
        </g>

        <g id="pico-alpamayo-dup" class="cursor-pointer group">
          <polygon points="740,140 580,560 740,560" fill="url(#pico-luz-h)" />
          <polygon points="740,140 740,560 900,560" fill="url(#pico-sombra-h)" />
          <path d="M 740,140 L 670,240 L 705,230 L 725,260 L 740,240 L 760,265 L 780,235 L 810,245 Z" fill="url(#nieve-h)" />
          <line x1="720" y1="180" x2="695" y2="230" stroke="#bae6fd" stroke-width="1.5" opacity="0.8" />
          <line x1="740" y1="170" x2="735" y2="235" stroke="#bae6fd" stroke-width="1.5" opacity="0.8" />
          <line x1="760" y1="180" x2="775" y2="230" stroke="#0284c7" stroke-width="1.5" opacity="0.8" />
          <line x1="740" y1="140" x2="740" y2="105" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
          <circle cx="740" cy="140" r="3" fill="#38bdf8" />
          <g transform="translate(635, 72)" filter="url(#glow-badge)">
            <rect x="0" y="0" width="210" height="34" rx="17" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5" fill-opacity="0.9" />
            <circle cx="16" cy="17" r="4" fill="#38bdf8" />
            <text x="28" y="16" fill="#ffffff" font-size="12" font-weight="800" font-family="sans-serif">Nevado Alpamayo</text>
            <text x="28" y="27" fill="#94a3b8" font-size="9.5" font-weight="600" font-family="sans-serif">5,947 m · Cordillera Blanca</text>
          </g>
        </g>

        <g id="pico-yerupaja-dup" class="cursor-pointer group">
          <polygon points="1150,95 940,560 1150,560" fill="url(#pico-luz-h)" />
          <polygon points="1150,95 1150,560 1350,560" fill="url(#pico-sombra-h)" />
          <path d="M 1150,95 L 1060,210 L 1100,200 L 1130,235 L 1150,215 L 1180,245 L 1210,210 L 1240,220 Z" fill="url(#nieve-h)" />
          <line x1="1150" y1="95" x2="1150" y2="60" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
          <circle cx="1150" cy="95" r="3" fill="#38bdf8" />
          <g transform="translate(1040, 28)" filter="url(#glow-badge)">
            <rect x="0" y="0" width="220" height="34" rx="17" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5" fill-opacity="0.9" />
            <circle cx="16" cy="17" r="4" fill="#38bdf8" />
            <text x="28" y="16" fill="#ffffff" font-size="12" font-weight="800" font-family="sans-serif">Nevado Yerupajá</text>
            <text x="28" y="27" fill="#94a3b8" font-size="9.5" font-weight="600" font-family="sans-serif">6,635 m · Cord. Huayhuash</text>
          </g>
        </g>

        <g id="pico-ausangate-dup" class="cursor-pointer group">
          <polygon points="1560,115 1360,560 1560,560" fill="url(#pico-luz-h)" />
          <polygon points="1560,115 1560,560 1760,560" fill="url(#pico-sombra-h)" />
          <path d="M 1560,115 L 1480,220 L 1520,210 L 1545,245 L 1560,225 L 1585,250 L 1615,220 L 1640,230 Z" fill="url(#nieve-h)" />
          <ellipse cx="1470" cy="480" rx="90" ry="22" fill="url(#lago-turq-h)" opacity="0.9" />
          <line x1="1560" y1="115" x2="1560" y2="80" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
          <circle cx="1560" cy="115" r="3" fill="#38bdf8" />
          <g transform="translate(1450, 48)" filter="url(#glow-badge)">
            <rect x="0" y="0" width="220" height="34" rx="17" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5" fill-opacity="0.9" />
            <circle cx="16" cy="17" r="4" fill="#38bdf8" />
            <text x="28" y="16" fill="#ffffff" font-size="12" font-weight="800" font-family="sans-serif">Nevado Ausangate</text>
            <text x="28" y="27" fill="#94a3b8" font-size="9.5" font-weight="600" font-family="sans-serif">6,384 m · Cord. Vilcanota</text>
          </g>
        </g>

        <g id="pico-hualcan-dup" class="cursor-pointer group">
          <polygon points="1960,120 1770,560 1960,560" fill="url(#pico-luz-h)" />
          <polygon points="1960,120 1960,560 2160,560" fill="url(#pico-sombra-h)" />
          <path d="M 1960,120 L 1880,225 L 1920,215 L 1945,250 L 1960,230 L 1985,255 L 2015,225 L 2040,235 Z" fill="url(#nieve-h)" />
          <ellipse cx="1960" cy="460" rx="80" ry="20" fill="url(#lago-turq-h)" />
          <line x1="1960" y1="120" x2="1960" y2="85" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
          <circle cx="1960" cy="120" r="3" fill="#10b981" />
          <g transform="translate(1850, 52)" filter="url(#glow-badge)">
            <rect x="0" y="0" width="220" height="34" rx="17" fill="#0f172a" stroke="#10b981" stroke-width="1.5" fill-opacity="0.9" />
            <circle cx="16" cy="17" r="4" fill="#10b981" />
            <text x="28" y="16" fill="#ffffff" font-size="12" font-weight="800" font-family="sans-serif">Hualcán · Laguna 513</text>
            <text x="28" y="27" fill="#34d399" font-size="9.5" font-weight="600" font-family="sans-serif">6,122 m · Cordillera Blanca</text>
          </g>
        </g>

        <polygon points="2280,130 2120,560 2280,560" fill="url(#pico-luz-h)" />
        <polygon points="2280,130 2280,560 2400,320 2400,560" fill="url(#pico-sombra-h)" />
      </svg>

    </div>

    <!-- CAPA 4: Morenas Frontales en Primer Plano (Velocidad Más Dinámica: 20s) -->
    <div class="track-paralaje-cercana absolute bottom-0 left-0 h-[380px] w-[4800px] flex">
      <svg class="h-full w-[2400px] shrink-0" viewBox="0 0 2400 380" preserveAspectRatio="none">
        <polygon points="0,380 90,320 280,360 480,290 690,360 920,280 1140,360 1380,290 1620,360 1860,300 2100,370 2400,310 2400,380" fill="#040813" opacity="0.85" />
      </svg>
      <svg class="h-full w-[2400px] shrink-0" viewBox="0 0 2400 380" preserveAspectRatio="none">
        <polygon points="0,380 90,320 280,360 480,290 690,360 920,280 1140,360 1380,290 1620,360 1860,300 2100,370 2400,310 2400,380" fill="#040813" opacity="0.85" />
      </svg>
    </div>

  </div>

  <!-- ======================================================== -->
  <!-- CAPA DE DIFUMINADO / MÁSCARA GRADUAL                     -->
  <!-- Pasa suavemente de Blanco Sólido a la Cordillera Azul   -->
  <!-- ======================================================== -->
  <div class="absolute inset-y-0 left-0 w-full lg:w-[65%] xl:w-[58%] 2xl:w-[52%] bg-gradient-to-r from-white via-white via-70% to-transparent pointer-events-none z-10 hidden lg:block"></div>
  <!-- Versión móvil (difuminado de arriba a abajo) -->
  <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-white via-white/90 to-transparent pointer-events-none z-10 lg:hidden"></div>

  <!-- ======================================================== -->
  <!-- CONTENIDO FRONTAL (IZQUIERDA): PREGUNTA Y BUSCADOR        -->
  <!-- En fondo blanco puro, sobrio, institucional y limpio     -->
  <!-- ======================================================== -->
