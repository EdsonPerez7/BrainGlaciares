<!-- ======================================================== -->
<!-- ESTILOS CSS DE ANIMACIÓN INFINITA A 60 FPS               -->
<!-- ======================================================== -->
<style>
  /* Desplazamiento seamless a 60fps con transform3d (acelerado por GPU) */
  @keyframes loopCordilleraLenta {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-2400px, 0, 0); }
  }
  @keyframes loopCordilleraMedia {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-2400px, 0, 0); }
  }
  @keyframes loopCordilleraNevados {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-2400px, 0, 0); }
  }
  @keyframes loopCordilleraCercana {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-2400px, 0, 0); }
  }

  .track-paralaje-lenta {
    animation: loopCordilleraLenta 85s linear infinite;
    will-change: transform;
  }
  .track-paralaje-media {
    animation: loopCordilleraMedia 55s linear infinite;
    will-change: transform;
  }
  .track-paralaje-nevados {
    animation: loopCordilleraNevados 38s linear infinite;
    will-change: transform;
  }
  .track-paralaje-cercana {
    animation: loopCordilleraCercana 24s linear infinite;
    will-change: transform;
  }

  /* Efecto al posar el ratón: desaceleración suave para leer con calma */
  .track-paralaje-nevados:hover {
    animation-play-state: paused;
  }

  /* Estado pausado manual */
  .paralaje-paused {
    animation-play-state: paused !important;
  }
</style>

<script>
  // Control de Pausa / Reanudar el recorrido
  const btnToggle = document.getElementById('btn-toggle-paralaje');
  const iconPause = document.getElementById('icon-pause-loop');
  const iconPlay = document.getElementById('icon-play-loop');
  const tracks = document.querySelectorAll('[class*="track-paralaje-"]');
  let isMoving = true;

  btnToggle?.addEventListener('click', () => {
    isMoving = !isMoving;
    tracks.forEach(track => {
      if (isMoving) {
        track.classList.remove('paralaje-paused');
      } else {
        track.classList.add('paralaje-paused');
      }
    });

    if (isMoving) {
      iconPause?.classList.remove('hidden');
      iconPlay?.classList.add('hidden');
    } else {
      iconPause?.classList.add('hidden');
      iconPlay?.classList.remove('hidden');
    }
  });

  // Buscador sugerencias directas
  const searchInput = document.getElementById('hero-search-input') as HTMLInputElement | null;
  const sugerencias = document.querySelectorAll('.btn-sugerencia');
  sugerencias.forEach(btn => {
    btn.addEventListener('click', () => {
      if (searchInput && btn.textContent) {
        searchInput.value = btn.textContent.trim();
        window.location.hash = 'buscar';
      }
    });
  });

  // Clic en los picos de la cordillera para navegar o filtrar
  const picos = document.querySelectorAll('[id^="pico-"]');
  picos.forEach(p => {
    p.addEventListener('click', () => {
      const id = p.getAttribute('id') || '';
      if (id.includes('hualcan') || id.includes('513')) {
        window.location.hash = 'simulador-cordillera';
      } else {
        window.location.hash = 'buscar';
      }
    });
  });
</script>
