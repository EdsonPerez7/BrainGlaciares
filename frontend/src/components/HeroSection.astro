---
import { SITE_CONFIG } from '../config/site.config';
---

<section class="relative overflow-hidden bg-[#78b6eb] w-full min-h-[640px] lg:min-h-[720px] xl:min-h-[780px] flex items-center">
  
  <!-- ======================================================== -->
  <!-- LIENZO 3D WEBGL AL 100%: SOBREVUELO CONTINUO DE LOS ANDES -->
  <!-- ======================================================== -->
  <div class="absolute inset-0 w-full h-full overflow-hidden select-none">
    
    <!-- Canvas de renderizado Three.js a pantalla completa -->
    <canvas id="canvas-sobrevuelo-andes" class="absolute inset-0 w-full h-full block"></canvas>

    <!-- Capa de Etiquetas Cartográficas Proyectadas en 3D -->
    <div id="contenedor-etiquetas-3d" class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden z-10">
      <!-- Proyección matemática en tiempo real sobre las cumbres -->
    </div>

    <!-- Indicador HUD de Vuelo Aéreo y Rumbo (Esquina Inferior Derecha) -->
    <div class="absolute bottom-6 right-6 z-20 flex items-center gap-3 bg-slate-950/80 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-white/15 text-xs shadow-2xl pointer-events-none text-white">
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-[10px] font-mono text-slate-300 uppercase tracking-wider font-semibold">Sobrevuelo Aéreo en Vivo</span>
        </div>
        <span id="hud-telemetria-vuelo" class="font-mono font-bold text-sky-300 text-xs">
          Rumbo 355° N · Cordillera de los Andes
        </span>
      </div>
      <div class="h-8 w-px bg-white/20"></div>
      <div class="flex flex-col text-[11px] font-mono text-slate-300">
        <span class="text-slate-400 text-[9px] uppercase">Cota de Vuelo</span>
        <span class="text-emerald-400 font-bold">6,100 m</span>
      </div>
    </div>

  </div>

  <!-- ======================================================== -->
  <!-- CONSOLA CIENTÍFICA FLOTANTE (GLASSMORPHISM COCKPIT)      -->
  <!-- Flotando limpiamente sobre el paisaje 3D al 100%         -->
  <!-- ======================================================== -->
  <div class="relative z-30 w-full px-4 sm:px-8 lg:px-12 xl:px-16 2xl:px-20 py-8 lg:py-16 pointer-events-none">
    
    <!-- Tarjeta flotante con cristal esmerilado oscuro de alto contraste -->
    <div id="hero-cockpit-card" class="max-w-xl xl:max-w-2xl bg-slate-950/75 backdrop-blur-xl p-6 sm:p-8 lg:p-9 rounded-3xl shadow-2xl border border-white/15 text-white space-y-6 pointer-events-auto">
      
      <!-- Pastilla Institucional -->
      <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3.5 py-1 text-xs text-slate-200 shadow-xs backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-semibold text-white">398 Informes oficiales digitalizados</span>
        <span class="text-slate-400">|</span>
        <span class="text-slate-300">Evidencia con trazabilidad científica</span>
      </div>

      <!-- Título de impacto -->
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl 2xl:text-6xl font-black tracking-tight text-white leading-[1.12] drop-shadow-md">
          ¿Hay riesgo donde vives?
        </h1>
        <p class="text-sm sm:text-base text-slate-200 leading-relaxed max-w-xl font-normal">
          Escribe tu pueblo, departamento o una laguna: te mostramos qué glaciares hay aguas arriba, qué eventos históricos ocurrieron y de qué informe técnico oficial proviene cada dato.
        </p>
      </div>

      <!-- Buscador Institucional Integrado en la Consola -->
      <div class="space-y-3">
        <div class="relative max-w-lg">
          <input 
            id="hero-search-input"
            type="text" 
            autocomplete="off"
            placeholder="Escribe tu pueblo, departamento o una laguna..." 
            class="w-full rounded-2xl border border-white/20 bg-white/10 px-4 py-3.5 pl-11 text-sm text-white shadow-inner placeholder:text-slate-300 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/30 transition backdrop-blur-md"
          />
          <svg class="absolute left-3.5 top-4 h-4 w-4 text-slate-300 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>

          <!-- Menú desplegable flotante de autocompletado inteligente -->
          <div 
            id="hero-search-dropdown" 
            class="hidden absolute left-0 right-0 top-full mt-2 z-50 rounded-2xl border border-white/20 bg-slate-950/95 p-2 shadow-2xl backdrop-blur-xl max-h-80 overflow-y-auto space-y-1 text-left"
          >
            <!-- Contenido inyectado dinámicamente -->
          </div>
        </div>

        <!-- Consultas rápidas recomendadas -->
        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-300">
          <span class="font-medium text-slate-400">O prueba con:</span>
          <button type="button" class="btn-sugerencia rounded-lg border border-white/15 bg-white/10 px-2.5 py-1 font-medium text-slate-200 hover:bg-white/20 hover:text-white transition shadow-2xs backdrop-blur-sm" data-href="/buscar?q=Huaraz">Huaraz</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-white/15 bg-white/10 px-2.5 py-1 font-medium text-slate-200 hover:bg-white/20 hover:text-white transition shadow-2xs backdrop-blur-sm" data-href="/buscar?id=513">Laguna 513</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-white/15 bg-white/10 px-2.5 py-1 font-medium text-slate-200 hover:bg-white/20 hover:text-white transition shadow-2xs backdrop-blur-sm" data-href="/buscar?id=paron">Parón</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-white/15 bg-white/10 px-2.5 py-1 font-medium text-slate-200 hover:bg-white/20 hover:text-white transition shadow-2xs backdrop-blur-sm" data-href="/buscar?dept=cusco">Cusco</button>
        </div>
      </div>

      <!-- Enlace directo al simulador de cuencas -->
      <div class="pt-2 flex items-center gap-3">
        <a 
          href="#simulador-cordillera" 
          class="inline-flex items-center gap-2 text-xs font-bold text-sky-200 hover:text-white bg-sky-500/20 hover:bg-sky-500/30 px-3.5 py-2 rounded-xl transition border border-sky-400/30 shadow-2xs backdrop-blur-sm"
        >
          <span>Ver anatomía de un aluvión en 5 escenas</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
        </a>
      </div>

    </div>

  </div>

  <!-- ======================================================== -->
  <!-- ======================================================== -->
  <!-- PANEL INTERACTIVO DE CALIBRACIÓN PROCEDURAL (OPCIONAL)   -->
  <!-- ======================================================== -->
  <div class="absolute bottom-6 left-6 z-30 pointer-events-auto flex flex-wrap items-center gap-2.5">
    <!-- Botón Toggle de Calibración -->
    <button 
      id="btn-toggle-config-panel"
      type="button"
      class="inline-flex items-center gap-2 rounded-2xl border border-white/20 bg-slate-950/80 px-3.5 py-2 text-xs font-semibold text-sky-300 backdrop-blur-md shadow-xl hover:bg-slate-900 transition hover:border-sky-400/40"
    >
      <svg class="w-4 h-4 text-sky-400 animate-spin-slow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span>Calibrar Cordilleras 3D</span>
    </button>

    <!-- Botón Toggle de Etiquetas Cartográficas 3D -->
    <button 
      id="btn-toggle-labels-3d"
      type="button"
      class="inline-flex items-center gap-2 rounded-2xl border border-white/20 bg-slate-950/80 px-3.5 py-2 text-xs font-semibold text-emerald-300 backdrop-blur-md shadow-xl hover:bg-slate-900 transition hover:border-emerald-400/40 cursor-pointer"
      title="Mostrar / Ocultar etiquetas de nevados y lagunas conectadas del RAG"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span id="txt-toggle-labels">Etiquetas RAG: Activas</span>
    </button>
  </div>

  <!-- Panel Flotante Desplegable (Posicionado fijamente debajo de la barra de navegación superior) -->
  <div 
    id="panel-config-cordilleras" 
    class="hidden fixed top-20 left-4 sm:left-6 w-88 max-h-[calc(100vh-6rem)] overflow-y-auto bg-slate-950/95 border border-white/20 rounded-2xl p-5 shadow-2xl backdrop-blur-xl text-white space-y-4 ring-1 ring-white/10 z-50 pointer-events-auto"
  >
    <div class="flex items-center justify-between border-b border-white/10 pb-2.5">
      <div>
        <span class="text-xs font-mono font-bold uppercase text-sky-400">Mountain Studio</span>
        <p class="text-[10px] text-slate-300">Calibración en vivo de topografía y perspectiva</p>
      </div>
      <button id="btn-cerrar-config-panel" type="button" class="text-slate-400 hover:text-white text-sm px-1.5 py-0.5 rounded hover:bg-white/10 cursor-pointer">✕</button>
    </div>

      <!-- SECCIÓN 1: PERSPECTIVA Y CÁMARA -->
      <div class="space-y-2.5 border-b border-white/10 pb-3">
        <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-sky-300 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>Perspectiva de la Vista</span>
        </span>

        <!-- Inclinación vertical (Pitch) -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Inclinación (Pitch / Arriba-Abajo)</span>
            <span id="val-pitch" class="font-mono text-sky-300">+30°</span>
          </div>
          <input id="slider-pitch" type="range" min="-30" max="55" step="1" value="30" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>

        <!-- Orientación horizontal (Yaw) -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Giro de mirada (Yaw / Izq-Der)</span>
            <span id="val-yaw" class="font-mono text-sky-300">-30°</span>
          </div>
          <input id="slider-yaw" type="range" min="-60" max="60" step="1" value="-30" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>

        <!-- Campo de visión (FOV) -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Campo de visión (FOV / Zoom)</span>
            <span id="val-fov" class="font-mono text-sky-300">95°</span>
          </div>
          <input id="slider-fov" type="range" min="30" max="110" step="1" value="95" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>

        <!-- Altura de vuelo -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Cota de crucero (Altura)</span>
            <span id="val-flight-altitude" class="font-mono text-sky-300">340 m</span>
          </div>
          <input id="slider-flight-altitude" type="range" min="150" max="550" step="5" value="340" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>

        <!-- Trayectoria lateral X -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Posición en el macizo (Eje lateral)</span>
            <span id="val-xoffset" class="font-mono text-sky-300">64</span>
          </div>
          <input id="slider-xoffset" type="range" min="-200" max="120" step="2" value="64" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>
      </div>

      <!-- SECCIÓN 2: RELIEVE Y TOPOGRAFÍA -->
      <div class="space-y-2.5 border-b border-white/10 pb-3">
        <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          <span>Topografía & Wireframe</span>
        </span>

        <!-- Modo Visual -->
        <div class="space-y-1">
          <label class="block text-[11px] text-slate-300">Modo de Renderizado</label>
          <div class="grid grid-cols-3 gap-1 bg-slate-900 p-1 rounded-lg border border-white/10 text-[10px]">
            <button id="btn-mode-hybrid" type="button" class="btn-visual-mode py-1 rounded text-center font-medium text-slate-400 hover:text-white transition cursor-pointer">Híbrido</button>
            <button id="btn-mode-natural" type="button" class="btn-visual-mode py-1 rounded text-center font-medium bg-sky-500/20 text-sky-300 border border-sky-400/30 transition cursor-pointer">Natural</button>
            <button id="btn-mode-wireframe" type="button" class="btn-visual-mode py-1 rounded text-center font-medium text-slate-400 hover:text-white transition cursor-pointer">Wireframe</button>
          </div>
        </div>

        <!-- Modo Diagnóstico Topográfico -->
        <label class="flex items-center gap-2 cursor-pointer text-[11px] text-slate-300 hover:text-white transition py-0.5 select-none">
          <input id="chk-diagnostic-mode" type="checkbox" class="accent-sky-400 rounded cursor-pointer" />
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block animate-pulse"></span>
            Modo Diagnóstico (Auditoría de Terreno)
          </span>
        </label>

        <!-- Conmutador de Etiquetas Cartográficas 3D -->
        <label class="flex items-center gap-2 cursor-pointer text-[11px] text-slate-300 hover:text-white transition py-0.5 select-none">
          <input id="chk-labels-mode" type="checkbox" checked class="accent-sky-400 rounded cursor-pointer" />
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 inline-block"></span>
            Etiquetas Cartográficas 3D y Conexiones RAG
          </span>
        </label>

        <!-- Altura de los nevados -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Altura de los nevados</span>
            <span id="val-altitude" class="font-mono text-sky-300">350 m</span>
          </div>
          <input id="slider-altitude" type="range" min="100" max="400" value="350" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>

        <!-- Irregularidad de crestas -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Irregularidad de crestas</span>
            <span id="val-ridge" class="font-mono text-sky-300">2.40</span>
          </div>
          <input id="slider-ridge" type="range" min="0.4" max="3.0" step="0.05" value="2.40" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>

        <!-- Intensidad Wireframe -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Intensidad Wireframe</span>
            <span id="val-wireframe" class="font-mono text-sky-300">34%</span>
          </div>
          <input id="slider-wireframe" type="range" min="0.0" max="1.0" step="0.02" value="0.34" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>

        <!-- Velocidad de vuelo -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Velocidad de vuelo</span>
            <span id="val-speed" class="font-mono text-sky-300">80</span>
          </div>
          <input id="slider-speed" type="range" min="10" max="100" step="1" value="80" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>

        <!-- Rugosidad -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Rugosidad geológica</span>
            <span id="val-roughness" class="font-mono text-sky-300">0.10</span>
          </div>
          <input id="slider-roughness" type="range" min="0.05" max="2.0" step="0.05" value="0.10" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>

        <!-- Suavizado de Normales -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Suavizado de superficies</span>
            <span id="val-smoothness" class="font-mono text-sky-300">100%</span>
          </div>
          <input id="slider-smoothness" type="range" min="0.0" max="1.0" step="0.02" value="1.00" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>

        <!-- Cobertura de Nieve -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Manto de nieve andina</span>
            <span id="val-snow" class="font-mono text-sky-300">80%</span>
          </div>
          <input id="slider-snow" type="range" min="0.4" max="1.8" step="0.05" value="0.80" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>

        <!-- Afloramiento de Roca -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Afloramiento rocoso</span>
            <span id="val-rock" class="font-mono text-sky-300">180%</span>
          </div>
          <input id="slider-rock" type="range" min="0.4" max="2.0" step="0.05" value="1.80" class="w-full accent-sky-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
        </div>
      </div>

      <!-- SECCIÓN 3: ECOSISTEMA GLACIAR (LAGUNAS Y GLACIARES) -->
      <div class="space-y-2.5 border-b border-white/10 pb-3">
        <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-cyan-400 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
          <span>Ecosistema Glaciar</span>
        </span>

        <!-- Tono de Agua Glaciar -->
        <div class="space-y-1">
          <label for="select-lake-color" class="block text-[11px] text-slate-300">Tonalidad Lagunas</label>
          <select id="select-lake-color" class="w-full text-[11px] bg-slate-800 border border-white/10 rounded px-2 py-1 text-cyan-300 cursor-pointer">
            <option value="#0891b2">Azul Parón Profundo (#0891b2)</option>
            <option value="#06b6d4" selected>Turquesa Harina Glaciar (#06b6d4)</option>
            <option value="#14b8a6">Esmeralda Cordillera (#14b8a6)</option>
            <option value="#0284c7">Azul Alpamayo (#0284c7)</option>
          </select>
        </div>

        <!-- Tono de Hielo Glaciar -->
        <div class="space-y-1">
          <label for="select-ice-color" class="block text-[11px] text-slate-300">Hielo Glaciares</label>
          <select id="select-ice-color" class="w-full text-[11px] bg-slate-800 border border-white/10 rounded px-2 py-1 text-sky-300 cursor-pointer">
            <option value="#0284c7">Azul Profundo de Grietas (#0284c7)</option>
            <option value="#38bdf8" selected>Azul Hielo Crystalline (#38bdf8)</option>
            <option value="#7dd3fc">Azul Glaciar Claro (#7dd3fc)</option>
          </select>
        </div>
      </div>

      <!-- SECCIÓN 4: ILUMINACIÓN & ATMÓSFERA -->
      <div class="space-y-2.5">
        <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span>Iluminación & Atmósfera</span>
        </span>

        <!-- Intensidad Solar -->
        <div class="space-y-1">
          <div class="flex justify-between text-[11px]">
            <span class="text-slate-300">Sol alpino lateral</span>
