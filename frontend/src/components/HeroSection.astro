---
// HeroSection.astro: Sobrevuelo Aéreo 3D de la Cordillera de los Andes (Sur a Norte)
// Implementado en Three.js / WebGL nativo por GPU a 60 fps
// Vuelo continuo en primera persona independiente del scroll, con relieve 3D y etiquetas cartográficas proyectadas
---

<section class="relative overflow-hidden border-b border-slate-200 bg-[#060c18] w-full min-h-[580px] lg:min-h-[660px] xl:min-h-[700px] flex items-center">
  
  <!-- ======================================================== -->
  <!-- LIENZO 3D WEBGL: SOBREVUELO CONTINUO DE LOS ANDES         -->
  <!-- ======================================================== -->
  <div class="absolute inset-0 w-full h-full overflow-hidden select-none">
    
    <!-- Canvas de renderizado Three.js -->
    <canvas id="canvas-sobrevuelo-andes" class="absolute inset-0 w-full h-full block"></canvas>

    <!-- Capa de Etiquetas Cartográficas Proyectadas en 3D -->
    <div id="contenedor-etiquetas-3d" class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden z-10">
      <!-- Las etiquetas se inyectan y proyectan matemáticamente en tiempo real por Three.js -->
    </div>

    <!-- Indicador HUD de Vuelo Aéreo y Rumbo (Esquina Inferior Derecha) -->
    <div class="absolute bottom-6 right-6 z-20 flex items-center gap-3 bg-slate-950/85 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-slate-700/70 text-xs shadow-2xl pointer-events-none">
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider font-semibold">Sobrevuelo Aéreo en Vivo</span>
        </div>
        <span id="hud-telemetria-vuelo" class="font-mono font-bold text-sky-300 text-xs">
          Rumbo 355° N · Trayectoria Sur a Norte
        </span>
      </div>
      <div class="h-8 w-px bg-slate-800"></div>
      <div class="flex flex-col text-[11px] font-mono text-slate-300">
        <span class="text-slate-500 text-[9px] uppercase">Altitud Vuelo</span>
        <span class="text-emerald-400 font-bold">5,800 m</span>
      </div>
    </div>

  </div>

  <!-- ======================================================== -->
  <!-- MÁSCARA GRADUAL DE DIFUMINADO (BLANCO A ALTA MONTAÑA)     -->
  <!-- ======================================================== -->
  <div class="absolute inset-y-0 left-0 w-full lg:w-[65%] xl:w-[58%] 2xl:w-[50%] bg-gradient-to-r from-white via-white via-70% to-transparent pointer-events-none z-20 hidden lg:block"></div>
  <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-white via-white/90 to-transparent pointer-events-none z-20 lg:hidden"></div>

  <!-- ======================================================== -->
  <!-- CONTENIDO FRONTAL (IZQUIERDA): PREGUNTA Y BUSCADOR        -->
  <!-- En fondo blanco puro institucional                       -->
  <!-- ======================================================== -->
  <div class="relative z-30 w-full px-4 sm:px-8 lg:px-12 xl:px-16 2xl:px-20 py-8 lg:py-16">
    <div class="max-w-xl xl:max-w-2xl bg-white/95 lg:bg-transparent p-6 sm:p-8 lg:p-0 rounded-3xl lg:rounded-none shadow-xl lg:shadow-none border border-slate-200/80 lg:border-none backdrop-blur-md lg:backdrop-blur-none space-y-6">
      
      <!-- Pastilla Institucional -->
      <div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 text-xs text-slate-700 shadow-xs">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-semibold text-slate-900">398 Informes oficiales digitalizados</span>
        <span class="text-slate-300">|</span>
        <span>Evidencia con trazabilidad científica</span>
      </div>

      <!-- Título de impacto -->
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl 2xl:text-6xl font-black tracking-tight text-slate-950 leading-[1.12]">
          ¿Hay riesgo donde vives?
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl">
          Escribe tu pueblo, departamento o una laguna: te mostramos qué glaciares hay aguas arriba, qué eventos históricos ocurrieron y de qué informe técnico oficial proviene cada dato.
        </p>
      </div>

      <!-- Buscador Institucional con Icono -->
      <div class="space-y-3">
        <div class="relative max-w-lg">
          <input 
            id="hero-search-input"
            type="text" 
            placeholder="Escribe tu pueblo, departamento o una laguna..." 
            class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 pl-11 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-slate-950 focus:outline-none focus:ring-2 focus:ring-slate-950/10 transition"
          />
          <svg class="absolute left-3.5 top-4 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Consultas rápidas recomendadas -->
        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
          <span class="font-medium text-slate-400">O prueba con:</span>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-2xs">Huaraz</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-2xs">Laguna 513</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-2xs">Parón</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-2xs">Cusco</button>
        </div>
      </div>

      <!-- Enlace directo al simulador de cuencas -->
      <div class="pt-2 flex items-center gap-3">
        <a 
          href="#simulador-cordillera" 
          class="inline-flex items-center gap-2 text-xs font-bold text-slate-800 hover:text-sky-600 bg-slate-100 hover:bg-slate-200/80 px-3.5 py-2 rounded-xl transition border border-slate-200 shadow-2xs"
        >
          <span>Ver anatomía de un aluvión en 5 escenas</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
        </a>
      </div>

    </div>
  </div>

</section>

<!-- ======================================================== -->
<!-- SCRIPT DE SIMULACIÓN THREE.JS (SOBREVUELO SUR A NORTE)   -->
<!-- ======================================================== -->
<script>
  import * as THREE from 'three';

  // Elementos DOM
  const canvas = document.getElementById('canvas-sobrevuelo-andes') as HTMLCanvasElement;
  const containerEtiquetas = document.getElementById('contenedor-etiquetas-3d') as HTMLDivElement;
  const hudTelemetria = document.getElementById('hud-telemetria-vuelo') as HTMLSpanElement;

  if (canvas && containerEtiquetas) {
    
    // 1. Configuración de Escena y Renderizador WebGL
    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#050b17');
    scene.fog = new THREE.FogExp2('#050b17', 0.0016);

    const camera = new THREE.PerspectiveCamera(52, canvas.clientWidth / canvas.clientHeight, 1, 2200);
    
    const renderer = new THREE.WebGLRenderer({
      canvas: canvas,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);

    // 2. Iluminación Andina de Alta Montaña (Sombras facetadas y nieve reflectiva)
    const ambientLight = new THREE.AmbientLight('#2a3c5a', 1.2);
    scene.add(ambientLight);

    // Sol andino bajo (luz direccional lateral que modela aristas y vertientes)
    const sunLight = new THREE.DirectionalLight('#e0f2fe', 2.8);
    sunLight.position.set(-200, 300, -100);
    scene.add(sunLight);

    const rimLight = new THREE.DirectionalLight('#38bdf8', 1.2);
    rimLight.position.set(200, 150, 200);
    scene.add(rimLight);

    // 3. Catálogo de Nevados y Cumbres del RAG (Sur a Norte en el eje Z)
    // Coordenadas mundiales: Trayectoria de vuelo de Z = 0 a Z = -2800
    const NEVADOS_RAG = [
      {
        id: 'ausangate',
        nombre: 'NEVADO AUSANGATE',
        cota: '6,384 m s. n. m.',
        cordillera: 'Cordillera Vilcanota · Cusco',
        pos: new THREE.Vector3(-75, 115, -340),
        colorPunto: '#38bdf8'
      },
      {
        id: 'quelccaya',
        nombre: 'GLACIAR QUELCCAYA',
        cota: '5,670 m s. n. m.',
        cordillera: 'Casquete Tropical · Puno',
        pos: new THREE.Vector3(85, 96, -650),
        colorPunto: '#38bdf8'
      },
      {
        id: 'huaytapallana',
        nombre: 'NEVADO HUAYTAPALLANA',
        cota: '5,557 m s. n. m.',
        cordillera: 'Glaciar Lasuntay · Junín',
        pos: new THREE.Vector3(-70, 98, -1050),
        colorPunto: '#10b981'
      },
      {
        id: 'yerupaja',
        nombre: 'NEVADO YERUPAJÁ',
        cota: '6,635 m s. n. m.',
        cordillera: 'Cordillera Huayhuash · 2ª Cumbre',
        pos: new THREE.Vector3(75, 126, -1450),
        colorPunto: '#38bdf8'
      },
      {
        id: 'huascaran',
        nombre: 'NEVADO HUASCARÁN SUR',
        cota: '6,768 m s. n. m.',
        cordillera: 'Máxima Cumbre del Perú · Áncash',
        pos: new THREE.Vector3(-85, 138, -1880),
        colorPunto: '#38bdf8'
      },
      {
        id: 'hualcan',
        nombre: 'NEVADO HUALCÁN',
        cota: '6,122 m s. n. m.',
        cordillera: 'Cabecera Laguna 513 · Áncash',
        pos: new THREE.Vector3(75, 114, -2200),
        colorPunto: '#10b981'
      },
      {
        id: 'palcaraju',
        nombre: 'NEVADO PALCARAJU',
        cota: '6,274 m s. n. m.',
        cordillera: 'Cabecera Laguna Palcacocha',
        pos: new THREE.Vector3(-65, 118, -2480),
        colorPunto: '#f43f5e'
      },
      {
        id: 'alpamayo',
        nombre: 'NEVADO ALPAMAYO',
        cota: '5,947 m s. n. m.',
        cordillera: 'Pirámide Glaciar · Cordillera Blanca',
        pos: new THREE.Vector3(65, 106, -2760),
        colorPunto: '#38bdf8'
      }
    ];

    // Crear elementos DOM de las etiquetas flotantes
    const etiquetasDOM = NEVADOS_RAG.map(n => {
      const el = document.createElement('div');
      el.className = 'absolute top-0 left-0 transition-opacity duration-300 flex flex-col items-center pointer-events-none opacity-0';
      el.innerHTML = `
        <div class="flex flex-col items-center">
          <div class="bg-slate-950/90 border border-slate-700/80 rounded-xl px-3.5 py-1.5 shadow-2xl backdrop-blur-md flex flex-col items-center text-center">
            <span class="text-[10px] tracking-wider font-extrabold text-white uppercase">${n.nombre}</span>
            <span class="text-[11px] font-mono font-bold text-sky-400">${n.cota}</span>
            <span class="text-[9px] text-slate-400 font-medium">${n.cordillera}</span>
          </div>
          <div class="w-0.5 h-6 bg-gradient-to-b from-sky-400 to-transparent"></div>
          <div class="w-2.5 h-2.5 rounded-full" style="background-color: ${n.colorPunto}; box-shadow: 0 0 10px ${n.colorPunto};"></div>
        </div>
      `;
      containerEtiquetas.appendChild(el);
      return { data: n, dom: el };
    });

    // 4. Generación Procedural del Terreno Andino Tridimensional
    const LONGITUD_TOTAL = 3200;
    const ANCHO_CORREDOR = 520;
    const SEG_X = 110;
    const SEG_Z = 340;

    const terrainGeo = new THREE.PlaneGeometry(ANCHO_CORREDOR, LONGITUD_TOTAL, SEG_X, SEG_Z);
    terrainGeo.rotateX(-Math.PI / 2);

    const posAttr = terrainGeo.attributes.position;
    const colors: number[] = [];

    // Función de elevación matemática para esculpir los Andes
    function getElevation(x: number, z: number): number {
      const distCentro = Math.abs(x);
      
      // Valle central por donde vuela el avión
      const factorValle = Math.min(1.0, Math.pow(distCentro / 40, 1.8));
      
      // Ruido fractal de cadenas montañosas (crestas, quebradas y aristas)
      let h = Math.sin(x * 0.02) * Math.cos(z * 0.015) * 22;
      h += Math.sin(x * 0.05 + 1.2) * Math.cos(z * 0.035) * 14;
      h += Math.sin(x * 0.1) * Math.cos(z * 0.08) * 8;
      
      // Elevación base de los flancos montañosos
      let elevation = 12 + factorValle * 48 + h;

      // Modelar los 8 picos clave del RAG en sus coordenadas exactas
      for (const n of NEVADOS_RAG) {
        const dx = x - n.pos.x;
        const dz = z - n.pos.z;
        const distSq = dx * dx + dz * dz;
        const radio = 80;
        if (distSq < radio * radio) {
          const factorPico = 1 - Math.sqrt(distSq) / radio;
          elevation += Math.pow(factorPico, 1.6) * (n.pos.y - 40);
        }
      }

      return Math.max(0, elevation);
    }

    // Coloración geológica por cota: Roca oscura -> Talud morrénico -> Nieve glaciar
    const cValle = new THREE.Color('#0a1324');
    const cRoca = new THREE.Color('#1e293b');
    const cTalud = new THREE.Color('#334155');
    const cHielo = new THREE.Color('#7dd3fc');
    const cNieve = new THREE.Color('#ffffff');

    for (let i = 0; i < posAttr.count; i++) {
      const x = posAttr.getX(i);
      const z = posAttr.getZ(i);
      const y = getElevation(x, z);
      posAttr.setY(i, y);

      const vertexColor = new THREE.Color();
      if (y < 28) {
        vertexColor.copy(cValle).lerp(cRoca, y / 28);
      } else if (y < 65) {
        vertexColor.copy(cRoca).lerp(cTalud, (y - 28) / 37);
      } else if (y < 95) {
        vertexColor.copy(cTalud).lerp(cHielo, (y - 65) / 30);
      } else {
        vertexColor.copy(cHielo).lerp(cNieve, Math.min(1.0, (y - 95) / 30));
      }
      colors.push(vertexColor.r, vertexColor.g, vertexColor.b);
    }

    terrainGeo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
    terrainGeo.computeVertexNormals();

    const terrainMat = new THREE.MeshStandardMaterial({
      vertexColors: true,
      roughness: 0.88,
      metalness: 0.12,
      flatShading: true
    });

    const terrainMesh = new THREE.Mesh(terrainGeo, terrainMat);
    terrainMesh.position.set(0, 0, -LONGITUD_TOTAL / 2);
    scene.add(terrainMesh);

    // Malla gemela para bucle infinito perfecto
    const terrainMesh2 = terrainMesh.clone();
    terrainMesh2.position.set(0, 0, -LONGITUD_TOTAL / 2 - LONGITUD_TOTAL);
    scene.add(terrainMesh2);

    // 5. Configuración de Cámara y Bucle de Vuelo Aéreo
    const ALTURA_CRUCERO = 68;
    const VELOCIDAD_AVION = 42; // unidades por segundo
    let posCamZ = 0;
    const clock = new THREE.Clock();

    function resize() {
      if (!canvas) return;
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (canvas.width !== w || canvas.height !== h) {
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }
    }

    // 6. Ciclo de Animación a 60 FPS (Completamente Desacoplado del Scroll)
    function animate() {
      requestAnimationFrame(animate);
      resize();

      const delta = Math.min(clock.getDelta(), 0.1);
      
      // Avance constante de la aeronave hacia el Norte (Z negativo)
      posCamZ -= VELOCIDAD_AVION * delta;
      
      // Posición de la cámara en el aire
      const swayX = Math.sin(posCamZ * 0.003) * 16;
      const swayY = Math.cos(posCamZ * 0.004) * 4;
      camera.position.set(swayX, ALTURA_CRUCERO + swayY, posCamZ);
      
      // Mirar hacia adelante en el horizonte andino
      camera.lookAt(swayX * 0.6, ALTURA_CRUCERO * 0.85, posCamZ - 200);

      // Reciclaje infinito del terreno continuo
      if (posCamZ < -LONGITUD_TOTAL) {
        posCamZ += LONGITUD_TOTAL;
      }

      // Proyección matemática de etiquetas de nevados (3D -> 2D pantalla)
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;

      for (const item of etiquetasDOM) {
        const peakPos = item.data.pos.clone();
        
        // Ajustar posición con respecto al ciclo de vuelo
        const distZ = camera.position.z - peakPos.z;

        // Comportamiento de aproximación y paso de las montañas
        if (distZ > 15 && distZ < 680) {
          // Proyectar coordenadas mundiales 3D a coordenadas de pantalla (X, Y)
          const proj = peakPos.clone().project(camera);
          
          // Verificar si está dentro del frustum visible
          if (proj.z < 1.0 && proj.x >= -1.2 && proj.x <= 1.2 && proj.y >= -1.2 && proj.y <= 1.2) {
            const screenX = (proj.x * 0.5 + 0.5) * w;
            const screenY = (-proj.y * 0.5 + 0.5) * h;

            // Opacidad gradual según proximidad
            let opacidad = 0;
            if (distZ > 450) {
              opacidad = (680 - distZ) / 230; // Aparece en la lejanía
            } else if (distZ > 80) {
              opacidad = 1.0; // 100% visible mientras nos aproximamos
            } else {
              opacidad = (distZ - 15) / 65; // Se desvanece al quedar atrás
            }

            item.dom.style.transform = `translate3d(${screenX}px, ${screenY}px, 0) translate(-50%, -100%)`;
            item.dom.style.opacity = String(Math.max(0, Math.min(1, opacidad)));

            // Actualizar HUD si es el nevado más cercano al frente
            if (distZ > 80 && distZ < 300 && hudTelemetria) {
              hudTelemetria.textContent = `Aproximación: ${item.data.nombre} (${item.data.cota})`;
            }
          } else {
            item.dom.style.opacity = '0';
          }
        } else {
          item.dom.style.opacity = '0';
        }
      }

      renderer.render(scene, camera);
    }

    // Iniciar el sobrevuelo
    animate();

    // Redimensionamiento responsive
    window.addEventListener('resize', resize);
  }

  // Buscador sugerencias
  const searchInput = document.getElementById('hero-search-input') as HTMLInputElement | null;
  const sugerencias = document.querySelectorAll('.btn-sugerencia');
  sugerencias.forEach(btn => {
    btn.addEventListener('click', () => {
      if (searchInput && btn.textContent) {
        searchInput.value = btn.textContent.trim();
        window.location.hash = 'buscar';
      }
    });
  });
</script>
