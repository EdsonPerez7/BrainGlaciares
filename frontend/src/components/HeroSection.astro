---
// HeroSection.astro: Sobrevuelo Aéreo 3D Cinematográfico de los Andes Peruanos (Sur a Norte)
// 100% Full-bleed (sin difuminado blanco), estética fotorrealista basada en la referencia visual:
// Cielo alpino diurno, crestas afiladas (ridged multifractal), nieve en neveros y canales rocosos,
// iluminación solar con sombras nítidas y consola de búsqueda flotante con glassmorphism.
---

<section class="relative overflow-hidden bg-[#78b6eb] w-full min-h-[640px] lg:min-h-[720px] xl:min-h-[780px] flex items-center">
  
  <!-- ======================================================== -->
  <!-- LIENZO 3D WEBGL AL 100%: SOBREVUELO CONTINUO DE LOS ANDES -->
  <!-- ======================================================== -->
  <div class="absolute inset-0 w-full h-full overflow-hidden select-none">
    
    <!-- Canvas de renderizado Three.js a pantalla completa -->
    <canvas id="canvas-sobrevuelo-andes" class="absolute inset-0 w-full h-full block"></canvas>

    <!-- Capa de Etiquetas Cartográficas Proyectadas en 3D -->
    <div id="contenedor-etiquetas-3d" class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden z-10">
      <!-- Proyección matemática en tiempo real sobre las cumbres -->
    </div>

    <!-- Indicador HUD de Vuelo Aéreo y Rumbo (Esquina Inferior Derecha) -->
    <div class="absolute bottom-6 right-6 z-20 flex items-center gap-3 bg-slate-950/80 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-white/15 text-xs shadow-2xl pointer-events-none text-white">
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-[10px] font-mono text-slate-300 uppercase tracking-wider font-semibold">Sobrevuelo Aéreo en Vivo</span>
        </div>
        <span id="hud-telemetria-vuelo" class="font-mono font-bold text-sky-300 text-xs">
          Rumbo 355° N · Cordillera de los Andes
        </span>
      </div>
      <div class="h-8 w-px bg-white/20"></div>
      <div class="flex flex-col text-[11px] font-mono text-slate-300">
        <span class="text-slate-400 text-[9px] uppercase">Cota de Vuelo</span>
        <span class="text-emerald-400 font-bold">6,100 m</span>
      </div>
    </div>

  </div>

  <!-- ======================================================== -->
  <!-- CONSOLA CIENTÍFICA FLOTANTE (GLASSMORPHISM COCKPIT)      -->
  <!-- Flotando limpiamente sobre el paisaje 3D al 100%         -->
  <!-- ======================================================== -->
  <div class="relative z-30 w-full px-4 sm:px-8 lg:px-12 xl:px-16 2xl:px-20 py-8 lg:py-16 pointer-events-none">
    
    <!-- Tarjeta flotante con cristal esmerilado oscuro de alto contraste -->
    <div class="max-w-xl xl:max-w-2xl bg-slate-950/75 backdrop-blur-xl p-6 sm:p-8 lg:p-9 rounded-3xl shadow-2xl border border-white/15 text-white space-y-6 pointer-events-auto">
      
      <!-- Pastilla Institucional -->
      <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3.5 py-1 text-xs text-slate-200 shadow-xs backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-semibold text-white">398 Informes oficiales digitalizados</span>
        <span class="text-slate-400">|</span>
        <span class="text-slate-300">Evidencia con trazabilidad científica</span>
      </div>

      <!-- Título de impacto -->
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl 2xl:text-6xl font-black tracking-tight text-white leading-[1.12] drop-shadow-md">
          ¿Hay riesgo donde vives?
        </h1>
        <p class="text-sm sm:text-base text-slate-200 leading-relaxed max-w-xl font-normal">
          Escribe tu pueblo, departamento o una laguna: te mostramos qué glaciares hay aguas arriba, qué eventos históricos ocurrieron y de qué informe técnico oficial proviene cada dato.
        </p>
      </div>

      <!-- Buscador Institucional Integrado en la Consola -->
      <div class="space-y-3">
        <div class="relative max-w-lg">
          <input 
            id="hero-search-input"
            type="text" 
            placeholder="Escribe tu pueblo, departamento o una laguna..." 
            class="w-full rounded-2xl border border-white/20 bg-white/10 px-4 py-3.5 pl-11 text-sm text-white shadow-inner placeholder:text-slate-300 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/30 transition backdrop-blur-md"
          />
          <svg class="absolute left-3.5 top-4 h-4 w-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Consultas rápidas recomendadas -->
        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-300">
          <span class="font-medium text-slate-400">O prueba con:</span>
          <button type="button" class="btn-sugerencia rounded-lg border border-white/15 bg-white/10 px-2.5 py-1 font-medium text-slate-200 hover:bg-white/20 hover:text-white transition shadow-2xs backdrop-blur-sm">Huaraz</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-white/15 bg-white/10 px-2.5 py-1 font-medium text-slate-200 hover:bg-white/20 hover:text-white transition shadow-2xs backdrop-blur-sm">Laguna 513</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-white/15 bg-white/10 px-2.5 py-1 font-medium text-slate-200 hover:bg-white/20 hover:text-white transition shadow-2xs backdrop-blur-sm">Parón</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-white/15 bg-white/10 px-2.5 py-1 font-medium text-slate-200 hover:bg-white/20 hover:text-white transition shadow-2xs backdrop-blur-sm">Cusco</button>
        </div>
      </div>

      <!-- Enlace directo al simulador de cuencas -->
      <div class="pt-2 flex items-center gap-3">
        <a 
          href="#simulador-cordillera" 
          class="inline-flex items-center gap-2 text-xs font-bold text-sky-200 hover:text-white bg-sky-500/20 hover:bg-sky-500/30 px-3.5 py-2 rounded-xl transition border border-sky-400/30 shadow-2xs backdrop-blur-sm"
        >
          <span>Ver anatomía de un aluvión en 5 escenas</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
        </a>
      </div>

    </div>

  </div>

</section>

<!-- ======================================================== -->
<!-- SCRIPT DE SIMULACIÓN THREE.JS (CORDILLERA FOTORREALISTA) -->
<!-- ======================================================== -->
<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('canvas-sobrevuelo-andes') as HTMLCanvasElement;
  const containerEtiquetas = document.getElementById('contenedor-etiquetas-3d') as HTMLDivElement;
  const hudTelemetria = document.getElementById('hud-telemetria-vuelo') as HTMLSpanElement;

  if (canvas && containerEtiquetas) {
    
    // 1. Escena y Niebla Atmosférica Diurna Alpina (25% cielo / 75% cordillera)
    const scene = new THREE.Scene();
    const skyColor = new THREE.Color('#6ba5e7');
    const fogColor = new THREE.Color('#b6daf5');
    scene.background = skyColor;
    scene.fog = new THREE.FogExp2(fogColor, 0.00065);

    // Bóveda celeste diurna con degradado atmosférico
    const vertexSky = `
      varying vec3 vWorldPosition;
      void main() {
        vec4 worldPosition = modelMatrix * vec4(position, 1.0);
        vWorldPosition = worldPosition.xyz;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `;
    const fragmentSky = `
      uniform vec3 topColor;
      uniform vec3 bottomColor;
      uniform float offset;
      uniform float exponent;
      varying vec3 vWorldPosition;
      void main() {
        float h = normalize(vWorldPosition + offset).y;
        gl_FragColor = vec4(mix(bottomColor, topColor, max(pow(max(h, 0.0), exponent), 0.0)), 1.0);
      }
    `;
    const skyGeo = new THREE.SphereGeometry(2200, 32, 16);
    const skyMat = new THREE.ShaderMaterial({
      vertexShader: vertexSky,
      fragmentShader: fragmentSky,
      uniforms: {
        topColor: { value: new THREE.Color('#1d4ed8') },
        bottomColor: { value: new THREE.Color('#dbeafe') },
        offset: { value: 25 },
        exponent: { value: 0.52 }
      },
      side: THREE.BackSide
    });
    const skyMesh = new THREE.Mesh(skyGeo, skyMat);
    scene.add(skyMesh);

    // Cámara con FOV cinematográfico de 44°
    const camera = new THREE.PerspectiveCamera(44, canvas.clientWidth / canvas.clientHeight, 2, 3600);
    
    const renderer = new THREE.WebGLRenderer({
      canvas: canvas,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);

    // 2. Iluminación Solar Diurna (Sol cálido y sombras orográficas de alto contraste)
    const hemiLight = new THREE.HemisphereLight('#cbe5ff', '#334155', 1.35);
    scene.add(hemiLight);

    // Sol alpino brillante (luz direccional con tono blanco cálido)
    const sunLight = new THREE.DirectionalLight('#fffdf5', 3.2);
    sunLight.position.set(-240, 380, -140);
    scene.add(sunLight);

    // Luz secundaria difusa reflejada por la nieve
    const fillLight = new THREE.DirectionalLight('#93c5fd', 1.1);
    fillLight.position.set(220, 160, 200);
    scene.add(fillLight);

    // 3. Catálogo de Nevados Emblemáticos del RAG (Sur a Norte)
    const NEVADOS_RAG = [
      {
        id: 'ausangate',
        nombre: 'NEVADO AUSANGATE',
        cota: '6,384 m s. n. m.',
        cordillera: 'Cordillera Vilcanota · Cusco',
        pos: new THREE.Vector3(120, 132, -380),
        colorPunto: '#38bdf8'
      },
      {
        id: 'quelccaya',
        nombre: 'GLACIAR QUELCCAYA',
        cota: '5,670 m s. n. m.',
        cordillera: 'Casquete Tropical · Puno',
        pos: new THREE.Vector3(-40, 102, -700),
        colorPunto: '#38bdf8'
      },
      {
        id: 'salkantay',
        nombre: 'NEVADO SALKANTAY',
        cota: '6,271 m s. n. m.',
        cordillera: 'Cordillera Vilcabamba · Cusco',
        pos: new THREE.Vector3(135, 126, -1020),
        colorPunto: '#38bdf8'
      },
      {
        id: 'pariacaca',
        nombre: 'NEVADO PARIACACA',
        cota: '5,750 m s. n. m.',
        cordillera: 'Cordillera Central · Lima/Junín',
        pos: new THREE.Vector3(-35, 108, -1340),
        colorPunto: '#10b981'
      },
      {
        id: 'huaytapallana',
        nombre: 'NEVADO HUAYTAPALLANA',
        cota: '5,557 m s. n. m.',
        cordillera: 'Glaciar Lasuntay · Junín',
        pos: new THREE.Vector3(115, 110, -1660),
        colorPunto: '#10b981'
      },
      {
        id: 'siula',
        nombre: 'NEVADO SIULA GRANDE',
        cota: '6,344 m s. n. m.',
        cordillera: 'Cordillera Huayhuash',
        pos: new THREE.Vector3(-25, 126, -1980),
        colorPunto: '#38bdf8'
      },
      {
        id: 'yerupaja',
        nombre: 'NEVADO YERUPAJÁ',
        cota: '6,635 m s. n. m.',
        cordillera: 'Cordillera Huayhuash · 2ª Cumbre',
        pos: new THREE.Vector3(125, 136, -2300),
        colorPunto: '#38bdf8'
      },
      {
        id: 'pastoruri',
        nombre: 'NEVADO PASTORURI',
        cota: '5,240 m s. n. m.',
        cordillera: 'Cordillera Blanca Sur · Áncash',
        pos: new THREE.Vector3(-30, 104, -2620),
        colorPunto: '#10b981'
      },
      {
        id: 'palcaraju',
        nombre: 'NEVADO PALCARAJU',
        cota: '6,274 m s. n. m.',
        cordillera: 'Cabecera Laguna Palcacocha',
        pos: new THREE.Vector3(130, 128, -2940),
        colorPunto: '#f43f5e'
      },
      {
        id: 'huascaran',
        nombre: 'NEVADO HUASCARÁN SUR',
        cota: '6,768 m s. n. m.',
        cordillera: 'Máxima Cumbre del Perú · Áncash',
        pos: new THREE.Vector3(-35, 146, -3260),
        colorPunto: '#38bdf8'
      },
      {
        id: 'hualcan',
        nombre: 'NEVADO HUALCÁN',
        cota: '6,122 m s. n. m.',
        cordillera: 'Cabecera Laguna 513 · Áncash',
        pos: new THREE.Vector3(120, 124, -3580),
        colorPunto: '#10b981'
      },
      {
        id: 'chopicalqui',
        nombre: 'NEVADO CHOPICALQUI',
        cota: '6,354 m s. n. m.',
        cordillera: 'Cordillera Blanca Central',
        pos: new THREE.Vector3(-25, 130, -3900),
        colorPunto: '#38bdf8'
      },
      {
        id: 'artesonraju',
        nombre: 'NEVADO ARTESONRAJU',
        cota: '6,025 m s. n. m.',
        cordillera: 'Cabecera Laguna Parón · Áncash',
        pos: new THREE.Vector3(125, 122, -4220),
        colorPunto: '#10b981'
      },
      {
        id: 'alpamayo',
        nombre: 'NEVADO ALPAMAYO',
        cota: '5,947 m s. n. m.',
        cordillera: 'Pirámide Glaciar · Cordillera Blanca',
        pos: new THREE.Vector3(65, 118, -4540),
        colorPunto: '#38bdf8'
      }
    ];

    // Crear elementos DOM para las etiquetas flotantes
    const etiquetasDOM = NEVADOS_RAG.map(n => {
      const el = document.createElement('div');
      el.className = 'absolute top-0 left-0 transition-opacity duration-300 flex flex-col items-center pointer-events-none opacity-0';
      el.innerHTML = `
        <div class="flex flex-col items-center">
          <div class="bg-slate-950/85 border border-white/20 rounded-xl px-3.5 py-1.5 shadow-2xl backdrop-blur-md flex flex-col items-center text-center">
            <span class="text-[9.5px] tracking-wider font-black text-white uppercase">${n.nombre}</span>
            <span class="text-[11px] font-mono font-bold text-sky-300 leading-tight">${n.cota}</span>
            <span class="text-[8.5px] text-slate-300 font-medium">${n.cordillera}</span>
          </div>
          <div class="w-0.5 h-5 bg-gradient-to-b from-sky-300 to-transparent"></div>
          <div class="w-2.5 h-2.5 rounded-full" style="background-color: ${n.colorPunto}; box-shadow: 0 0 10px ${n.colorPunto};"></div>
        </div>
      `;
      containerEtiquetas.appendChild(el);
      return { data: n, dom: el };
    });

    // 4. Textura de Roca Alpina y Estratos Metamórficos (Generador Procedural)
    function createAlpineTexture(): THREE.CanvasTexture {
      const texCanvas = document.createElement('canvas');
      texCanvas.width = 1024;
      texCanvas.height = 1024;
      const ctx = texCanvas.getContext('2d')!;

      // Base mineral de roca andina (granito y esquisto pardo/gris)
      ctx.fillStyle = '#443e39';
      ctx.fillRect(0, 0, 1024, 1024);

      // Estrías y canales de erosión vertical por donde desciende el deshielo
      for (let i = 0; i < 18000; i++) {
        const x = Math.random() * 1024;
        const y = Math.random() * 1024;
        const w = Math.random() * 2.5 + 1;
        const h = Math.random() * 24 + 6;
        ctx.fillStyle = Math.random() > 0.45 ? 'rgba(240,248,255,0.08)' : 'rgba(25,20,16,0.12)';
        ctx.fillRect(x, y, w, h);
      }

      const texture = new THREE.CanvasTexture(texCanvas);
      texture.wrapS = THREE.RepeatWrapping;
      texture.wrapT = THREE.RepeatWrapping;
      texture.repeat.set(16, 80);
      return texture;
    }

    const alpineTexture = createAlpineTexture();

    // 5. Generación del Relieve Andino Fotorrealista (Ridged Multifractal)
    // Crestas afiladas, aristas, canales y cuencas glaciares profundas
    const LONGITUD_TOTAL = 4800;
    const ANCHO_CORREDOR = 720;
    const SEG_X = 180;
    const SEG_Z = 520;

    const terrainGeo = new THREE.PlaneGeometry(ANCHO_CORREDOR, LONGITUD_TOTAL, SEG_X, SEG_Z);
    terrainGeo.rotateX(-Math.PI / 2);

    const posAttr = terrainGeo.attributes.position;

    // Función de ruido Ridged Multifractal para crestas afiladas reales (como en la foto de referencia)
    function ridgedNoise(x: number, z: number): number {
      // 1. Cresta base principal (valle central en X ≈ 40..60, montañas a izquierda y derecha)
      const distEje = Math.abs(x - 50);
      const factorMontana = Math.min(1.0, Math.pow(distEje / 60, 1.4));

      // Armónicos de crestas afiladas (1.0 - abs(sin))
      let r1 = 1.0 - Math.abs(Math.sin(x * 0.016 + z * 0.008));
      let r2 = 1.0 - Math.abs(Math.sin(x * 0.035 - z * 0.018 + 0.7));
      let r3 = 1.0 - Math.abs(Math.cos(x * 0.07 + z * 0.04));
      let r4 = 1.0 - Math.abs(Math.sin(x * 0.14 - z * 0.09));

      let aristas = Math.pow(r1, 1.8) * 38 + Math.pow(r2, 1.6) * 22 + r3 * 10 + r4 * 4;

      let elevation = 18 + factorMontana * 58 + aristas;

      // 2. Colosos emblemáticos del RAG con crestas piramidales imponentes
      for (const n of NEVADOS_RAG) {
        const dx = x - n.pos.x;
        const dz = z - n.pos.z;
        const distSq = dx * dx + dz * dz;
        const radio = 85;
        if (distSq < radio * radio) {
          const t = 1.0 - Math.sqrt(distSq) / radio;
          // Cresta afilada piramidal con acanalado glacial
          const formaPico = Math.pow(t, 1.7) * (1.0 + 0.3 * Math.cos(Math.atan2(dz, dx) * 4));
          elevation += formaPico * (n.pos.y - 48);
        }
      }

      return Math.max(6, elevation);
    }

    for (let i = 0; i < posAttr.count; i++) {
      const x = posAttr.getX(i);
      const z = posAttr.getZ(i);
      posAttr.setY(i, ridgedNoise(x, z));
    }

    // Calcular normales continuas de alta precisión
    terrainGeo.computeVertexNormals();

    // 6. Coloración Basada en Pendiente (Roca expuesta en laderas vs Nieve en neveros y crestas)
    const normalAttr = terrainGeo.attributes.normal;
    const colors: number[] = [];

    // Paleta fotorrealista exacta de la foto de referencia
    const cRocaOscura = new THREE.Color('#2d2621'); // Granito pardo/gris oscuro
    const cRocaMedia = new THREE.Color('#4a4038');  // Roca mineral cálida
    const cTaludGris = new THREE.Color('#6b635b');  // Talud de morrena
    const cHieloAzulado = new THREE.Color('#94cbeb'); // Hielo glaciar
    const cNievePura = new THREE.Color('#f8fafc');   // Nieve blanca brillante

    for (let i = 0; i < posAttr.count; i++) {
      const y = posAttr.getY(i);
      const ny = normalAttr.getY(i); // Inclinación de la pendiente

      const col = new THREE.Color();

      // En la foto de referencia:
      // - Paredes verticales escarpadas (ny bajo): roca parda/gris oscura con grietas de nieve
      // - Crestas, neveros y laderas suaves (ny alto): nieve blanca resplandeciente
      if (ny < 0.52) {
        // Paredes casi verticales: roca expuesta
        col.copy(cRocaOscura).lerp(cRocaMedia, y / 140);
      } else if (ny < 0.72) {
        // Laderas intermedias: transición de roca con canales de nieve
        const t = (ny - 0.52) / 0.20;
        col.copy(cRocaMedia).lerp(cTaludGris, t);
        if (y > 60) {
          col.lerp(cHieloAzulado, (y - 60) / 80 * 0.4);
        }
      } else {
        // Crestas, neveros y cumbres glaciadas: nieve blanca pura con brillo alpino
        const t = (ny - 0.72) / 0.28;
        col.copy(cHieloAzulado).lerp(cNievePura, Math.min(1.0, t * 1.3));
      }

      // Oclusión ambiental sutil en quebradas profundas
      const ao = Math.min(1.0, Math.max(0.42, Math.pow(y / 65, 0.4)));
      col.multiplyScalar(ao);

      colors.push(col.r, col.g, col.b);
    }

    terrainGeo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));

    const terrainMat = new THREE.MeshStandardMaterial({
      vertexColors: true,
      map: alpineTexture,
      roughness: 0.78,
      metalness: 0.06,
      flatShading: false
    });

    const terrainMesh = new THREE.Mesh(terrainGeo, terrainMat);
    terrainMesh.position.set(0, 0, -LONGITUD_TOTAL / 2);
    scene.add(terrainMesh);

    // Malla gemela continua
    const terrainMesh2 = terrainMesh.clone();
    terrainMesh2.position.set(0, 0, -LONGITUD_TOTAL / 2 - LONGITUD_TOTAL);
    scene.add(terrainMesh2);

    // Espejo de agua de laguna glaciar en un circo intermedio (como en la foto de referencia)
    const lagoGeo = new THREE.PlaneGeometry(160, 220);
    lagoGeo.rotateX(-Math.PI / 2);
    const lagoMat = new THREE.MeshStandardMaterial({
      color: '#1b324d',
      roughness: 0.15,
      metalness: 0.85
    });
    const lagoMesh = new THREE.Mesh(lagoGeo, lagoMat);
    lagoMesh.position.set(50, 19, -800);
    scene.add(lagoMesh);

    // 7. Cinemática de Vuelo Aéreo: 25% Cielo / 75% Nevados (Horizonte despejado)
    const ALTURA_CRUCERO = 152; // Cota de crucero óptima
    const VELOCIDAD_AVION = 42; // Unidades por segundo
    let posCamZ = 0;
    const clock = new THREE.Clock();

    function resize() {
      if (!canvas) return;
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (canvas.width !== w || canvas.height !== h) {
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }
    }

    // 8. Ciclo de Animación a 60 FPS: Encuadre Panorámico (25% Cielo / 75% Cordillera)
    function animate() {
      requestAnimationFrame(animate);
      resize();

      const delta = Math.min(clock.getDelta(), 0.1);
      posCamZ -= VELOCIDAD_AVION * delta;

      // Trayectoria curva suave por el centro del valle
      const curvePhase = posCamZ * 0.002;
      const camX = 50 + Math.sin(curvePhase) * 28;
      const camY = ALTURA_CRUCERO + Math.cos(curvePhase * 1.5) * 4;
      camera.position.set(camX, camY, posCamZ);

      // El punto focal Y = 108 sitúa el horizonte exactamente en el 25% superior de la pantalla
      // dejando 25% de cielo diurno abierto y 75% de relieve andino nevado majestuoso
      const lookAheadX = camX + Math.cos(curvePhase) * 12;
      const targetY = 108;
      camera.lookAt(lookAheadX, targetY, posCamZ - 240);

      // Alabeo aerodinámico natural (roll de avión en curvas)
      camera.rotation.z = -Math.cos(curvePhase) * 0.045;

      // Mantener la esfera celeste acompañando la posición de la cámara
      skyMesh.position.set(camera.position.x, 0, camera.position.z);

      // Reciclaje infinito
      if (posCamZ < -LONGITUD_TOTAL) {
        posCamZ += LONGITUD_TOTAL;
      }

      // 9. Proyección Matemática y Visibilidad de Etiquetas
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;

      for (const item of etiquetasDOM) {
        const peakPos = item.data.pos.clone();
        const distZ = camera.position.z - peakPos.z;

        if (distZ > 20 && distZ < 720) {
          const proj = peakPos.clone().project(camera);

          if (proj.z < 1.0 && proj.x >= -1.1 && proj.x <= 1.1 && proj.y >= -1.1 && proj.y <= 1.1) {
            const screenX = (proj.x * 0.5 + 0.5) * w;
            const screenY = (-proj.y * 0.5 + 0.5) * h;

            if (screenX > 30 && screenX < w - 30 && screenY > 40 && screenY < h - 40) {
              let opac = 1.0;
              if (distZ > 480) {
                opac = (720 - distZ) / 240;
              } else if (distZ < 90) {
                opac = (distZ - 20) / 70;
              }

              item.dom.style.transform = `translate3d(${screenX}px, ${screenY}px, 0) translate(-50%, -100%)`;
              item.dom.style.opacity = String(Math.max(0, Math.min(1, opac)));

              if (distZ > 80 && distZ < 300 && hudTelemetria) {
                hudTelemetria.textContent = `Aproximación: ${item.data.nombre} (${item.data.cota})`;
              }
            } else {
              item.dom.style.opacity = '0';
            }
          } else {
            item.dom.style.opacity = '0';
          }
        } else {
          item.dom.style.opacity = '0';
        }
      }

      renderer.render(scene, camera);
    }

    animate();
    window.addEventListener('resize', resize);
  }

  // Buscador sugerencias
  const searchInput = document.getElementById('hero-search-input') as HTMLInputElement | null;
  const sugerencias = document.querySelectorAll('.btn-sugerencia');
  sugerencias.forEach(btn => {
    btn.addEventListener('click', () => {
      if (searchInput && btn.textContent) {
        searchInput.value = btn.textContent.trim();
        window.location.hash = 'buscar';
      }
    });
  });
</script>
