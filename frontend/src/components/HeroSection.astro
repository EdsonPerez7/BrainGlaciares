    const sWireframe = document.getElementById('slider-wireframe') as HTMLInputElement | null;
    const vWireframe = document.getElementById('val-wireframe');
    sWireframe?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vWireframe) vWireframe.textContent = `${Math.round(val * 100)}%`;
      engine.updateParam('wireframeIntensity', val);
    });

    const sSpeed = document.getElementById('slider-speed') as HTMLInputElement | null;
    const vSpeed = document.getElementById('val-speed');
    sSpeed?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vSpeed) vSpeed.textContent = String(val);
      engine.updateParam('flightSpeed', val);
    });

    const sRoughness = document.getElementById('slider-roughness') as HTMLInputElement | null;
    const vRoughness = document.getElementById('val-roughness');
    sRoughness?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vRoughness) vRoughness.textContent = String(val);
      engine.updateParam('roughness', val);
    });

    // --- REFINAMIENTO DE SUPERFICIE Y MATERIALES ---
    const sSmoothness = document.getElementById('slider-smoothness') as HTMLInputElement | null;
    const vSmoothness = document.getElementById('val-smoothness');
    sSmoothness?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vSmoothness) vSmoothness.textContent = `${Math.round(val * 100)}%`;
      engine.updateParam('normalSmoothness', val);
    });

    const sSnow = document.getElementById('slider-snow') as HTMLInputElement | null;
    const vSnow = document.getElementById('val-snow');
    sSnow?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vSnow) vSnow.textContent = `${Math.round(val * 100)}%`;
      engine.updateParam('snowCoverage', val);
    });

    const sRock = document.getElementById('slider-rock') as HTMLInputElement | null;
    const vRock = document.getElementById('val-rock');
    sRock?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vRock) vRock.textContent = `${Math.round(val * 100)}%`;
      engine.updateParam('rockExposure', val);
    });

    const selLakeColor = document.getElementById('select-lake-color') as HTMLSelectElement | null;
    selLakeColor?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      engine.updateParam('lakeWaterColor', val);
    });

    const selIceColor = document.getElementById('select-ice-color') as HTMLSelectElement | null;
    selIceColor?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      engine.updateParam('glacierIceColor', val);
    });

    // --- ILUMINACIÓN & ATMÓSFERA ---
    const sSun = document.getElementById('slider-sun') as HTMLInputElement | null;
    const vSun = document.getElementById('val-sun');
    sSun?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vSun) vSun.textContent = String(val);
      engine.updateParam('sunIntensity', val);
    });

    const sFog = document.getElementById('slider-fog') as HTMLInputElement | null;
    const vFog = document.getElementById('val-fog');
    sFog?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vFog) vFog.textContent = val.toFixed(5);
      engine.updateParam('fogDensity', val);
    });

    const sClouds = document.getElementById('slider-clouds') as HTMLInputElement | null;
    const vClouds = document.getElementById('val-clouds');
    sClouds?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vClouds) vClouds.textContent = `${Math.round(val * 100)}%`;
      engine.updateParam('cloudCoverage', val);
    });

    // --- MODO DE RENDERIZADO VISUAL ---
    const btnHybrid = document.getElementById('btn-mode-hybrid');
    const btnNatural = document.getElementById('btn-mode-natural');
    const btnWireframe = document.getElementById('btn-mode-wireframe');
    const modeBtns = [btnHybrid, btnNatural, btnWireframe];

    function setVisualModeUI(mode: 'hybrid' | 'natural' | 'wireframe') {
      modeBtns.forEach(b => {
        b?.classList.remove('bg-sky-500/20', 'text-sky-300', 'border', 'border-sky-400/30');
        b?.classList.add('text-slate-400');
      });
      const activeBtn = mode === 'natural' ? btnNatural : mode === 'wireframe' ? btnWireframe : btnHybrid;
      activeBtn?.classList.remove('text-slate-400');
      activeBtn?.classList.add('bg-sky-500/20', 'text-sky-300', 'border', 'border-sky-400/30');
      engine.updateParam('visualMode', mode);
    }

    btnHybrid?.addEventListener('click', () => setVisualModeUI('hybrid'));
    btnNatural?.addEventListener('click', () => setVisualModeUI('natural'));
    btnWireframe?.addEventListener('click', () => setVisualModeUI('wireframe'));

    // --- MODO DIAGNÓSTICO TOPOGRÁFICO ---
    const chkDiagnostic = document.getElementById('chk-diagnostic-mode') as HTMLInputElement | null;
    chkDiagnostic?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      engine.updateParam('diagnosticMode', checked);
    });

    // Restablecer valores
    document.getElementById('btn-reset-config')?.addEventListener('click', () => {
      setVisualModeUI(DEFAULT_CONFIG.visualMode || 'natural');
      if (chkDiagnostic) chkDiagnostic.checked = DEFAULT_CONFIG.diagnosticMode;
      engine.updateParam('diagnosticMode', DEFAULT_CONFIG.diagnosticMode);

      // Perspectiva
      if (sPitch) { sPitch.value = String(DEFAULT_CONFIG.cameraPitch); if (vPitch) vPitch.textContent = `${DEFAULT_CONFIG.cameraPitch > 0 ? '+' : ''}${DEFAULT_CONFIG.cameraPitch}°`; }
      if (sYaw) { sYaw.value = String(DEFAULT_CONFIG.cameraYaw); if (vYaw) vYaw.textContent = `${DEFAULT_CONFIG.cameraYaw > 0 ? '+' : ''}${DEFAULT_CONFIG.cameraYaw}°`; }
      if (sFov) { sFov.value = String(DEFAULT_CONFIG.cameraFov); if (vFov) vFov.textContent = `${DEFAULT_CONFIG.cameraFov}°`; }
      if (sFlightAlt) { sFlightAlt.value = String(DEFAULT_CONFIG.flightAltitude); if (vFlightAlt) vFlightAlt.textContent = `${DEFAULT_CONFIG.flightAltitude} m`; }
      if (sXOffset) { sXOffset.value = String(DEFAULT_CONFIG.cameraXOffset); if (vXOffset) vXOffset.textContent = String(DEFAULT_CONFIG.cameraXOffset); }

      // Topografía & Materiales
      if (sAltitude) { sAltitude.value = String(DEFAULT_CONFIG.maxAltitude); if (vAltitude) vAltitude.textContent = `${DEFAULT_CONFIG.maxAltitude} m`; }
      if (sRidge) { sRidge.value = String(DEFAULT_CONFIG.ridgeIntensity); if (vRidge) vRidge.textContent = String(DEFAULT_CONFIG.ridgeIntensity); }
      if (sWireframe) { sWireframe.value = String(DEFAULT_CONFIG.wireframeIntensity); if (vWireframe) vWireframe.textContent = `${Math.round(DEFAULT_CONFIG.wireframeIntensity * 100)}%`; }
      if (sSpeed) { sSpeed.value = String(DEFAULT_CONFIG.flightSpeed); if (vSpeed) vSpeed.textContent = String(DEFAULT_CONFIG.flightSpeed); }
      if (sRoughness) { sRoughness.value = String(DEFAULT_CONFIG.roughness); if (vRoughness) vRoughness.textContent = String(DEFAULT_CONFIG.roughness); }
      if (sSmoothness) { sSmoothness.value = String(DEFAULT_CONFIG.normalSmoothness); if (vSmoothness) vSmoothness.textContent = `${Math.round(DEFAULT_CONFIG.normalSmoothness * 100)}%`; }
      if (sSnow) { sSnow.value = String(DEFAULT_CONFIG.snowCoverage); if (vSnow) vSnow.textContent = `${Math.round(DEFAULT_CONFIG.snowCoverage * 100)}%`; }
      if (sRock) { sRock.value = String(DEFAULT_CONFIG.rockExposure); if (vRock) vRock.textContent = `${Math.round(DEFAULT_CONFIG.rockExposure * 100)}%`; }
      if (sSun) { sSun.value = String(DEFAULT_CONFIG.sunIntensity); if (vSun) vSun.textContent = String(DEFAULT_CONFIG.sunIntensity); }
      if (sClouds) { sClouds.value = String(DEFAULT_CONFIG.cloudCoverage); if (vClouds) vClouds.textContent = `${Math.round(DEFAULT_CONFIG.cloudCoverage * 100)}%`; }
      if (sFog) { sFog.value = String(DEFAULT_CONFIG.fogDensity); if (vFog) vFog.textContent = DEFAULT_CONFIG.fogDensity.toFixed(5); }

      engine.updateParam('cameraPitch', DEFAULT_CONFIG.cameraPitch);
      engine.updateParam('cameraYaw', DEFAULT_CONFIG.cameraYaw);
      engine.updateParam('cameraFov', DEFAULT_CONFIG.cameraFov);
      engine.updateParam('flightAltitude', DEFAULT_CONFIG.flightAltitude);
      engine.updateParam('cameraXOffset', DEFAULT_CONFIG.cameraXOffset);
      engine.updateParam('maxAltitude', DEFAULT_CONFIG.maxAltitude);
      engine.updateParam('ridgeIntensity', DEFAULT_CONFIG.ridgeIntensity);
      engine.updateParam('wireframeIntensity', DEFAULT_CONFIG.wireframeIntensity);
      engine.updateParam('flightSpeed', DEFAULT_CONFIG.flightSpeed);
      engine.updateParam('roughness', DEFAULT_CONFIG.roughness);
      engine.updateParam('normalSmoothness', DEFAULT_CONFIG.normalSmoothness);
      engine.updateParam('snowCoverage', DEFAULT_CONFIG.snowCoverage);
      engine.updateParam('rockExposure', DEFAULT_CONFIG.rockExposure);
      engine.updateParam('sunIntensity', DEFAULT_CONFIG.sunIntensity);
      engine.updateParam('cloudCoverage', DEFAULT_CONFIG.cloudCoverage);
      engine.updateParam('fogDensity', DEFAULT_CONFIG.fogDensity);
    });

    // Copiar configuración
    document.getElementById('btn-copy-config')?.addEventListener('click', () => {
      const current = engine.getConfig();
      navigator.clipboard?.writeText(JSON.stringify(current, null, 2));
      alert('Configuración de perspectiva y cordilleras copiada al portapapeles');
    });
  }

  // ========================================================
  // BUSCADOR CON DESPLEGABLE EN VIVO Y NAVEGACIÓN A /BUSCAR
  // ========================================================
  const searchInput = document.getElementById('hero-search-input') as HTMLInputElement | null;
  const searchDropdown = document.getElementById('hero-search-dropdown') as HTMLDivElement | null;
  const sugerencias = document.querySelectorAll<HTMLButtonElement>('.btn-sugerencia');

  // Redirección para botones de sugerencia
  sugerencias.forEach(btn => {
    btn.addEventListener('click', () => {
      const href = btn.dataset.href;
      if (href) {
        window.location.href = href;
      }
    });
  });

  if (searchInput && searchDropdown) {
    const SEARCH_ITEMS = [
      { type: 'laguna', title: 'Laguna Cancahua', subtitle: 'Áncash · Cordillera Blanca', icon: '🏔️', url: '/buscar?id=cancahua', tags: 'cancahua ancash blanca vallunaraju sin evaluar' },
      { type: 'laguna', title: 'Laguna Palcacocha', subtitle: 'Áncash · Cordillera Blanca (Riesgo muy alto)', icon: '🏔️', url: '/buscar?id=palcacocha', tags: 'palcacocha ancash blanca huaraz cojup muy alto' },
      { type: 'laguna', title: 'Laguna Parón', subtitle: 'Áncash · Cordillera Blanca (Riesgo muy alto)', icon: '🏔️', url: '/buscar?id=paron', tags: 'paron ancash caraz huandoy muy alto' },
      { type: 'laguna', title: 'Laguna 513', subtitle: 'Áncash · Cordillera Blanca (Riesgo alto)', icon: '🏔️', url: '/buscar?id=513', tags: '513 ancash carhuaz hualcan alto' },
      { type: 'laguna', title: 'Laguna Upiscocha', subtitle: 'Cusco · Cordillera Vilcanota (Riesgo alto)', icon: '🏔️', url: '/buscar?id=upiscocha', tags: 'upiscocha cusco vilcanota ausangate ocongate' },
      { type: 'laguna', title: 'Laguna Gangrajanca', subtitle: 'Huánuco · Cordillera Huayhuash (Riesgo muy alto)', icon: '🏔️', url: '/buscar?id=gangrajanca', tags: 'gangrajanca huanuco huayhuash yerupaja queropalca' },
      { type: 'departamento', title: 'Áncash', subtitle: '9 lagunas en riesgo · Puesto 1 de 13 departamentos', icon: '🏛️', url: '/buscar?dept=áncash', tags: 'ancash cordillera blanca huayhuash' },
      { type: 'departamento', title: 'Cusco', subtitle: '2 lagunas en riesgo · Vilcanota y Urubamba', icon: '🏛️', url: '/buscar?dept=cusco', tags: 'cusco vilcanota urubamba ausangate' },
      { type: 'departamento', title: 'Huánuco', subtitle: '3 lagunas en riesgo · Huayhuash', icon: '🏛️', url: '/buscar?dept=huánuco', tags: 'huanuco queropalca yerupaja' },
      { type: 'departamento', title: 'Puno', subtitle: '2 lagunas en riesgo · Carabaya y Apolobamba', icon: '🏛️', url: '/buscar?dept=puno', tags: 'puno carabaya apolobamba' },
      { type: 'pueblo', title: 'Huaraz', subtitle: 'Áncash · Amenazada por Laguna Palcacocha', icon: '🏘️', url: '/buscar?q=Huaraz', tags: 'huaraz ancash cojup palcacocha aluvion' },
      { type: 'pueblo', title: 'Caraz', subtitle: 'Áncash · Amenazada por Laguna Parón', icon: '🏘️', url: '/buscar?q=Caraz', tags: 'caraz ancash paron' },
      { type: 'pueblo', title: 'Carhuaz', subtitle: 'Áncash · Amenazada por Laguna 513', icon: '🏘️', url: '/buscar?q=Carhuaz', tags: 'carhuaz ancash 513' },
      { type: 'pueblo', title: 'Queropalca', subtitle: 'Huánuco · Cuenca Yerupajá', icon: '🏘️', url: '/buscar?q=Queropalca', tags: 'queropalca huanuco gangrajanca' }
    ];

    const API_BASE = "{SITE_CONFIG.apiBaseUrl}";
    const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    let debounceTimer: any = null;

    function renderDropdown(items: any[], docs: any[] = []) {
      if (!searchDropdown) return;
      if (items.length === 0 && docs.length === 0) {
        searchDropdown.innerHTML = `
          <div class="px-3.5 py-3 text-xs text-slate-400 text-center">
            No se encontraron coincidencias directas.<br/>
            <span class="text-sky-300 font-medium">Presiona Enter para buscar en todo el corpus</span>
          </div>
        `;
        searchDropdown.classList.remove('hidden');
        return;
      }

      let html = '';
      if (items.length > 0) {
        html += items.slice(0, 6).map(item => `
          <a 
            href="${item.url}" 
            class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-white/10 transition group text-left block"
          >
            <span class="text-base select-none">${item.icon || '📍'}</span>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-bold text-white group-hover:text-sky-300 transition truncate">${item.title}</div>
              <div class="text-[11px] text-slate-400 truncate">${item.subtitle}</div>
            </div>
            <span class="text-slate-500 group-hover:text-sky-300 text-xs">→</span>
          </a>
        `).join('');
      }

      // Si hay documentos recuperados del RAG (sin LLM)
      if (docs.length > 0) {
        html += `<div class="pt-2 pb-1 px-3 border-t border-white/10 text-[10px] uppercase font-bold tracking-wider text-sky-400 flex items-center justify-between">
          <span>Evidencia RAG (398 Informes)</span>
          <span class="text-[9px] text-slate-400 font-normal">Cero LLM</span>
        </div>`;
        html += docs.slice(0, 3).map(doc => `
          <a 
            href="/buscar?q=${encodeURIComponent(doc.titulo || searchInput.value)}" 
            class="flex items-start gap-2.5 px-3 py-2 rounded-xl hover:bg-white/10 transition group text-left block"
          >
            <span class="text-sm select-none">📄</span>
            <div class="flex-1 min-w-0">
              <div class="text-[11px] font-semibold text-slate-200 group-hover:text-sky-300 truncate">${doc.titulo}</div>
              <div class="text-[10px] text-slate-400 truncate">${doc.fuente} · ${doc.anio} ${doc.pagina ? `(p. ${doc.pagina})` : ''}</div>
              <p class="text-[10px] text-slate-400 italic line-clamp-1 mt-0.5">"${doc.extracto}"</p>
            </div>
          </a>
        `).join('');
      }

      searchDropdown.innerHTML = html;
      searchDropdown.classList.remove('hidden');
    }

    async function fetchRAG(query: string) {
      try {
        const res = await fetch(`${API_BASE}/api/buscar?q=${encodeURIComponent(query)}&limite=6`);
        if (!res.ok) throw new Error('API error');
        const data = await res.json();
        
        const entidadesMapeadas = (data.entidades || []).map((e: any) => ({
          title: e.tipo === 'Laguna' ? `Laguna ${e.nombre}` : e.nombre,
          subtitle: `${e.departamento || e.tipo} · ${e.nivel_riesgo !== 'Sin evaluar' ? `Riesgo ${e.nivel_riesgo}` : 'Oficial'}`,
          icon: e.tipo === 'Laguna' ? '🏔️' : (e.tipo === 'Glaciar' ? '❄️' : (e.tipo === 'Poblado' ? '🏘️' : '🏛️')),
          url: e.url
        }));

        if (entidadesMapeadas.length > 0 || (data.documentos && data.documentos.length > 0)) {
          renderDropdown(entidadesMapeadas, data.documentos || []);
          return;
        }
      } catch (err) {
        // Fallback silencioso al catálogo local
      }

      // Fallback
      const filtered = SEARCH_ITEMS.filter(it => norm(it.title).includes(norm(query)) || norm(it.tags).includes(norm(query)));
      renderDropdown(filtered);
    }

    searchInput.addEventListener('focus', () => {
      const q = searchInput.value.trim();
      if (!q) {
        renderDropdown(SEARCH_ITEMS.slice(0, 6));
      } else {
        fetchRAG(q);
      }
    });

    searchInput.addEventListener('input', () => {
      const q = searchInput.value.trim();
      if (!q) {
        renderDropdown(SEARCH_ITEMS.slice(0, 6));
        return;
      }
      // Respuesta instantánea con catálogo local mientras llega la API RAG
      const localMatches = SEARCH_ITEMS.filter(it => norm(it.title).includes(norm(q)) || norm(it.tags).includes(norm(q)));
      renderDropdown(localMatches);

      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        fetchRAG(q);
      }, 200);
    });

    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const q = searchInput.value.trim();
        if (q) {
          window.location.href = `/buscar?q=${encodeURIComponent(q)}`;
        }
      } else if (e.key === 'Escape') {
        searchDropdown.classList.add('hidden');
      }
    });

    // Cerrar al hacer clic afuera
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target as Node) && !searchDropdown.contains(e.target as Node)) {
        searchDropdown.classList.add('hidden');
      }
    });
  }
</script>
