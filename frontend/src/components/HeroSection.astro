<!-- SCRIPT DE SIMULACIÓN THREE.JS (CORDILLERA FOTORREALISTA) -->
<!-- ======================================================== -->
<script>
  import { initMountainEngine } from './mountainEngine/main';
  import { DEFAULT_CONFIG } from './mountainEngine/config';

  const canvas = document.getElementById('canvas-sobrevuelo-andes') as HTMLCanvasElement;
  const hudTelemetria = document.getElementById('hud-telemetria-vuelo') as HTMLSpanElement;
  const containerEtiquetas = document.getElementById('contenedor-etiquetas-3d') as HTMLElement;
  const heroSection = canvas ? (canvas.closest('section') as HTMLElement) : null;

  if (canvas) {
    const engine = initMountainEngine(canvas, hudTelemetria, heroSection, undefined, containerEtiquetas);

    // ========================================================
    // CONMUTADOR DE ETIQUETAS CARTOGRÁFICAS 3D Y CONEXIONES RAG
    // ========================================================
    const btnToggleLabels = document.getElementById('btn-toggle-labels-3d');
    const txtToggleLabels = document.getElementById('txt-toggle-labels');
    const chkLabels = document.getElementById('chk-labels-mode') as HTMLInputElement | null;
    let labelsActive = true;

    function setLabelsState(active: boolean) {
      labelsActive = active;
      engine.toggleAnnotations(active);
      if (txtToggleLabels) {
        txtToggleLabels.textContent = active ? 'Etiquetas RAG: Activas' : 'Etiquetas RAG: Ocultas';
      }
      if (chkLabels) chkLabels.checked = active;
      if (btnToggleLabels) {
        btnToggleLabels.classList.toggle('text-emerald-300', active);
        btnToggleLabels.classList.toggle('text-slate-400', !active);
        const dot = btnToggleLabels.querySelector('span:first-child');
        if (dot) {
          dot.className = active ? 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse' : 'w-2 h-2 rounded-full bg-slate-500';
        }
      }
    }

    btnToggleLabels?.addEventListener('click', () => {
      setLabelsState(!labelsActive);
    });

    chkLabels?.addEventListener('change', (e) => {
      setLabelsState((e.target as HTMLInputElement).checked);
    });

    // ========================================================
    // CONEXIÓN DEL PANEL INTERACTIVO DE CALIBRACIÓN EN VIVO
    // ========================================================
    const btnToggle = document.getElementById('btn-toggle-config-panel');
    const panelConfig = document.getElementById('panel-config-cordilleras');
    const btnCerrar = document.getElementById('btn-cerrar-config-panel');

    btnToggle?.addEventListener('click', () => {
      panelConfig?.classList.toggle('hidden');
    });

    btnCerrar?.addEventListener('click', () => {
      panelConfig?.classList.add('hidden');
    });

    // --- CONTROLES DE PERSPECTIVA Y CÁMARA ---
    const sPitch = document.getElementById('slider-pitch') as HTMLInputElement | null;
    const vPitch = document.getElementById('val-pitch');
    sPitch?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vPitch) vPitch.textContent = `${val > 0 ? '+' : ''}${val}°`;
      engine.updateParam('cameraPitch', val);
    });

    const sYaw = document.getElementById('slider-yaw') as HTMLInputElement | null;
    const vYaw = document.getElementById('val-yaw');
    sYaw?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vYaw) vYaw.textContent = `${val > 0 ? '+' : ''}${val}°`;
      engine.updateParam('cameraYaw', val);
    });

    const sFov = document.getElementById('slider-fov') as HTMLInputElement | null;
    const vFov = document.getElementById('val-fov');
    sFov?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vFov) vFov.textContent = `${val}°`;
      engine.updateParam('cameraFov', val);
    });

    const sFlightAlt = document.getElementById('slider-flight-altitude') as HTMLInputElement | null;
    const vFlightAlt = document.getElementById('val-flight-altitude');
    sFlightAlt?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vFlightAlt) vFlightAlt.textContent = `${val} m`;
      engine.updateParam('flightAltitude', val);
    });

    const sXOffset = document.getElementById('slider-xoffset') as HTMLInputElement | null;
    const vXOffset = document.getElementById('val-xoffset');
    sXOffset?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vXOffset) vXOffset.textContent = String(val);
      engine.updateParam('cameraXOffset', val);
    });

    // --- CONTROLES DE TOPOGRAFÍA Y RELIEVE ---
    const sAltitude = document.getElementById('slider-altitude') as HTMLInputElement | null;
    const vAltitude = document.getElementById('val-altitude');
    sAltitude?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vAltitude) vAltitude.textContent = `${val} m`;
      engine.updateParam('maxAltitude', val);
    });

    const sRidge = document.getElementById('slider-ridge') as HTMLInputElement | null;
    const vRidge = document.getElementById('val-ridge');
    sRidge?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (vRidge) vRidge.textContent = String(val);
      engine.updateParam('ridgeIntensity', val);
