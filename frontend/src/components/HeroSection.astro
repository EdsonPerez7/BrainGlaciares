---
import { LAGUNAS_ESCENAS } from '../config/scenes.data';
---

<section class="relative overflow-hidden border-b border-slate-200 bg-slate-50/60 py-8 lg:py-12 w-full">
  <div class="w-full px-4 sm:px-8 lg:px-12 xl:px-16 2xl:px-20 space-y-8">
    
    <!-- ======================================================== -->
    <!-- CABECERA PRINCIPAL: TÍTULO INSTITUCIONAL + BUSCADOR       -->
    <!-- Espacioso, a lo ancho, sin asfixiar la cordillera        -->
    <!-- ======================================================== -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-slate-200/80 pb-6">
      
      <!-- Título y propuesta de valor -->
      <div class="max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3.5 py-1 text-xs text-slate-700 shadow-sm">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="font-semibold text-slate-900">398 Informes oficiales digitalizados</span>
          <span class="text-slate-300">|</span>
          <span>Evidencia glaciológica con trazabilidad científica</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-950 leading-[1.12]">
          ¿Hay riesgo de desborde donde vives?
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-2xl">
          Escribe tu pueblo, departamento o una laguna: te mostramos qué glaciares hay aguas arriba, qué eventos históricos ocurrieron y de qué documento técnico proviene cada evidencia.
        </p>
      </div>

      <!-- Buscador institucional ágil -->
      <div class="w-full lg:max-w-md xl:max-w-lg space-y-2.5">
        <div class="relative">
          <input 
            id="hero-search-input"
            type="text" 
            placeholder="Escribe tu pueblo, departamento o laguna..." 
            class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 pl-11 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-slate-950 focus:outline-none focus:ring-2 focus:ring-slate-950/10 transition"
          />
          <svg class="absolute left-3.5 top-4 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Sugerencias directas -->
        <div class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
          <span class="font-medium text-slate-400">Consultas rápidas:</span>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-white px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-xs">Huaraz</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-white px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-xs">Laguna 513</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-white px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-xs">Parón</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-white px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-xs">Cusco</button>
        </div>
      </div>

    </div>

    <!-- ======================================================== -->
    <!-- ESCENARIO WIDESCREEN: SIMULADOR DE ALTA MONTAÑA (100%)    -->
    <!-- Diseño cinematográfico, espacioso y ultra dinámico      -->
    <!-- ======================================================== -->
    <div class="w-full rounded-3xl border border-slate-900/60 bg-[#060c18] shadow-2xl overflow-hidden flex flex-col text-white">
      
      <!-- Barra superior: Selector de Lagunas Críticas + Indicadores de Fase -->
      <div class="px-4 py-3.5 sm:px-6 bg-[#081020] border-b border-slate-800/80 flex flex-wrap items-center justify-between gap-3">
        
        <!-- Pestañas de Lagunas -->
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-0.5">
          {Object.values(LAGUNAS_ESCENAS).map((l, idx) => (
            <button 
              type="button" 
              class={`tab-laguna-escena whitespace-nowrap rounded-full px-4 py-1.5 text-xs font-bold transition-all flex items-center gap-2 ${idx === 0 ? 'bg-white text-slate-950 shadow-md ring-2 ring-white/20' : 'bg-slate-900/90 text-slate-400 hover:text-white hover:bg-slate-800'}`}
              data-laguna-id={l.id}
            >
              <span class={`h-2 w-2 rounded-full ${l.id === '513' ? 'bg-emerald-400' : l.id === 'upiscocha' ? 'bg-amber-400' : 'bg-rose-500'}`}></span>
              <span>{l.nombre.startsWith('Laguna') ? l.nombre : `Laguna ${l.nombre}`} {l.anoEvento ? `· ${l.anoEvento}` : ''}</span>
            </button>
          ))}
        </div>

        <!-- Indicador de Fase y Telemetría activa -->
        <div class="flex items-center gap-3 text-xs">
          <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-700/70 text-slate-300">
            <span class="h-2 w-2 rounded-full bg-sky-400 animate-pulse"></span>
            <span id="badge-fase-indicador" class="font-bold text-sky-300 uppercase tracking-wider text-[11px]">Fase 1: El Hielo</span>
          </div>
          <span class="hidden sm:inline text-slate-500 text-xs font-mono">100% Pantalla Widescreen</span>
        </div>

      </div>

      <!-- Lienzo SVG Cinemático: 1400x680 con Profundidad y Cámara -->
      <div id="contenedor-cinematico" class="relative h-[440px] sm:h-[500px] lg:h-[580px] xl:h-[640px] 2xl:h-[680px] w-full bg-[#060c18] overflow-hidden flex items-center justify-center select-none cursor-crosshair">
        
        <svg id="svg-cordillera" class="h-full w-full" viewBox="0 0 1400 680" preserveAspectRatio="xMidYMid slice">
          <defs>
            <!-- Cielo de alta montaña con gradiente astronómico -->
            <linearGradient id="sky-grad-wide" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#030712" />
              <stop offset="40%" stop-color="#0a1224" />
              <stop offset="75%" stop-color="#121e3a" />
              <stop offset="100%" stop-color="#1e293b" />
            </linearGradient>

            <!-- Relieve: Cara Iluminada (Oeste) -->
            <linearGradient id="pico-luz-wide" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#475569" />
              <stop offset="35%" stop-color="#334155" />
              <stop offset="100%" stop-color="#1e293b" />
            </linearGradient>

            <!-- Relieve: Cara Sombreada (Este) -->
            <linearGradient id="pico-sombra-wide" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#1e293b" />
              <stop offset="60%" stop-color="#0f172a" />
              <stop offset="100%" stop-color="#020617" />
            </linearGradient>

            <!-- Hielo Glaciar de Alta Cumbre -->
            <linearGradient id="hielo-corona-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#ffffff" />
              <stop offset="40%" stop-color="#f0f9ff" />
              <stop offset="75%" stop-color="#bae6fd" />
              <stop offset="100%" stop-color="#38bdf8" />
            </linearGradient>

            <!-- Espejo de Agua Turquesa Glacial -->
            <linearGradient id="lago-turquesa-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#38bdf8" />
              <stop offset="35%" stop-color="#0284c7" />
              <stop offset="80%" stop-color="#0369a1" />
              <stop offset="100%" stop-color="#082f49" />
            </linearGradient>

            <!-- Cañón Inferior y Torrente Aluvial -->
            <linearGradient id="canyon-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1e293b" />
              <stop offset="60%" stop-color="#0f172a" />
              <stop offset="100%" stop-color="#020617" />
            </linearGradient>

            <!-- Filtro de Resplandor Neón para el Dique y SAT -->
            <filter id="neon-glow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="4" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <!-- Fondo Cielo Estrellado -->
          <rect width="1400" height="680" fill="url(#sky-grad-wide)" />

          <!-- Campo de Estrellas y Constelaciones de Altitud -->
          <g id="estrellas" opacity="0.65">
            <circle cx="80" cy="50" r="1.2" fill="#ffffff" />
            <circle cx="180" cy="80" r="1" fill="#bae6fd" />
            <circle cx="270" cy="35" r="1.5" fill="#ffffff" />
            <circle cx="390" cy="110" r="1" fill="#bae6fd" />
            <circle cx="510" cy="45" r="1.8" fill="#ffffff" />
            <circle cx="640" cy="25" r="1.2" fill="#bae6fd" />
            <circle cx="780" cy="65" r="1.5" fill="#ffffff" />
            <circle cx="890" cy="40" r="1" fill="#bae6fd" />
            <circle cx="1020" cy="90" r="1.6" fill="#ffffff" />
            <circle cx="1150" cy="30" r="1.2" fill="#bae6fd" />
            <circle cx="1280" cy="75" r="1.5" fill="#ffffff" />
            <circle cx="1350" cy="120" r="1.1" fill="#bae6fd" />
          </g>

          <!-- Niebla y Nubes Glaciares Drifting (Fondo lejano) -->
          <g id="nubes-fondo" opacity="0.25">
            <path d="M -200,160 Q 200,110 600,150 T 1400,140 L 1400,240 L -200,240 Z" fill="#94a3b8">
              <animateTransform attributeName="transform" type="translate" from="0,0" to="200,0" dur="25s" repeatCount="indefinite" />
            </path>
          </g>

          <!-- ======================================================== -->
          <!-- GRUPO CÁMARA CINEMÁTICA INTERACTIVA                      -->
          <!-- Realiza Zoom in, Pullback, Inclinación y Sacudida        -->
          <!-- ======================================================== -->
          <g id="camara-escena" class="origin-center transition-all duration-1000 ease-out" style="transform-origin: 700px 340px;">
            
            <!-- CAPA 1: Cordillera Lejana / Horizonte Andino (siluetas oscuras) -->
            <polygon points="0,680 0,380 90,320 220,410 350,260 480,390 620,240 700,270 820,210 960,370 1090,260 1240,390 1330,310 1400,360 1400,680" fill="#0b1325" opacity="0.75" />

            <!-- CAPA 2: Cordillera Intermedia con aristas rocosas -->
            <polygon points="0,680 0,440 140,340 280,450 450,290 600,430 700,320 840,430 1020,270 1180,440 1320,330 1400,420 1400,680" fill="#111d38" opacity="0.9" />

            <!-- ======================================================== -->
            <!-- CAÑÓN INFERIOR, QUEBRADA Y VALLE (Revelado en Escena 4)  -->
            <!-- ======================================================== -->
            <g id="capa-valle-abajo" opacity="0.35" class="transition-opacity duration-1000">
              <!-- Paredes del cañón rocoso -->
              <path d="M 520,440 L 360,680 L 1040,680 L 880,440 Z" fill="url(#canyon-grad)" />
              
              <!-- Río / Torrente Aluvial descolgándose en zig-zag -->
              <path id="cauce-rio-aluvion" d="M 700,440 Q 640,510 710,560 Q 770,610 680,680" fill="none" stroke="#38bdf8" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" opacity="0.8">
                <animate attributeName="stroke-dashoffset" values="60;0" dur="1.8s" repeatCount="indefinite" stroke-dasharray="20 10" />
              </path>

              <!-- Cono aluvial y zona urbana / poblados en el fondo -->
              <g id="cono-aluvial-poblado" transform="translate(680, 620)">
                <ellipse cx="0" cy="40" rx="220" ry="25" fill="#020617" opacity="0.9" />
                <path d="M -120,40 L 120,40" stroke="#f59e0b" stroke-width="2" stroke-dasharray="6 4" />
                <!-- Callout flotante del valle -->
                <rect x="-110" y="8" width="220" height="26" rx="13" fill="#0f172a" stroke="#334155" stroke-width="1" />
                <text x="0" y="25" fill="#e2e8f0" font-size="11" font-weight="800" text-anchor="middle" font-family="sans-serif">Quebrada hacia Poblado / Valle</text>
              </g>
            </g>

            <!-- ======================================================== -->
            <!-- MONTAÑA PRINCIPAL (COLOSO ANDINO CENTRAL)                -->
            <!-- Base majestuosa de 1400px con arista central afilada     -->
            <!-- ======================================================== -->
            <!-- Vertiente Izquierda (Luz del atardecer/amanecer) -->
            <polygon points="700,70 280,560 700,560" fill="url(#pico-luz-wide)" />
            <!-- Vertiente Derecha (Sombra profunda) -->
            <polygon points="700,70 700,560 1120,560" fill="url(#pico-sombra-wide)" />

            <!-- Estratos geológicos y aristas rocosas -->
            <path d="M 700,70 L 610,240 L 520,380 L 400,530" stroke="#1e293b" stroke-width="3" opacity="0.5" fill="none" />
            <path d="M 700,70 L 780,220 L 890,390 L 1020,540" stroke="#090d16" stroke-width="3" opacity="0.7" fill="none" />

            <!-- ======================================================== -->
            <!-- CORONA GLACIAR Y SERACS DE NIEVE ETERNA                  -->
            <!-- Enfoque épico en Escena 1: El Hielo                      -->
            <!-- ======================================================== -->
            <g id="casquete-nieve-glaciar" class="transition-all duration-1000">
              <!-- Casquete Glaciar Principal -->
              <path d="M 700,70 L 590,190 L 630,180 L 660,220 L 700,195 L 740,225 L 780,185 L 820,205 Z" fill="url(#hielo-corona-grad)" filter="drop-shadow(0 4px 12px rgba(56,189,248,0.25))" />
              <!-- Sombra facetada del hielo oriental -->
              <path d="M 700,70 L 700,195 L 740,225 L 780,185 L 820,205 Z" fill="#0284c7" opacity="0.35" />

              <!-- Grietas de tensión y seracs colgantes -->
              <g stroke="#0369a1" stroke-width="2" stroke-linecap="round" opacity="0.75">
                <line x1="675" y1="130" x2="690" y2="160" />
                <line x1="720" y1="125" x2="710" y2="155" />
                <line x1="630" y1="160" x2="655" y2="175" />
                <line x1="750" y1="155" x2="775" y2="170" />
              </g>

              <!-- EFECTO DINÁMICO: DESHIELO Y CASCADAS DE FUSIÓN (Escena 1) -->
              <g id="fx-deshielo-gotas" class="opacity-90">
                <line x1="660" y1="220" x2="660" y2="330" stroke="#bae6fd" stroke-width="2.5" stroke-dasharray="4 8">
                  <animate attributeName="stroke-dashoffset" values="0;36" dur="0.9s" repeatCount="indefinite" />
                </line>
                <line x1="740" y1="225" x2="740" y2="330" stroke="#bae6fd" stroke-width="2.5" stroke-dasharray="4 8">
                  <animate attributeName="stroke-dashoffset" values="0;36" dur="1.1s" repeatCount="indefinite" />
                </line>
                <line x1="700" y1="195" x2="700" y2="310" stroke="#e0f2fe" stroke-width="1.5" stroke-dasharray="3 6">
                  <animate attributeName="stroke-dashoffset" values="0;27" dur="0.7s" repeatCount="indefinite" />
                </line>
              </g>
            </g>

            <!-- ======================================================== -->
            <!-- CIRCO GLACIAR Y VASO DE LA LAGUNA                        -->
            <!-- Enfoque en Escena 2: La Laguna                           -->
            <!-- ======================================================== -->
            <g id="vaso-laguna-completo" class="transition-all duration-1000">
              
              <!-- Morrena frontal de contención (Dique morrénico natural de roca) -->
              <path d="M 460,400 Q 700,280 940,400 Q 700,500 460,400 Z" fill="#090f1d" stroke="#1e293b" stroke-width="2" />
              <path id="borde-morrena-roca" d="M 500,410 Q 700,480 900,410" fill="none" stroke="#b45309" stroke-width="10" stroke-linecap="round" opacity="0.9" />

              <!-- Espejo de Agua Glacial Turquesa Profunda -->
              <ellipse id="elipse-lago-profundo" cx="700" cy="405" rx="180" ry="46" fill="#075985" />
              <ellipse id="elipse-lago-superficie" cx="700" cy="402" rx="172" ry="40" fill="url(#lago-turquesa-grad)">
                <animate attributeName="ry" values="39;42;39" dur="3.5s" repeatCount="indefinite" />
              </ellipse>

              <!-- Anillos de batimetría y ondas de profundidad (Escena 2) -->
              <ellipse cx="700" cy="405" rx="115" ry="24" fill="none" stroke="#e0f2fe" stroke-width="1.5" opacity="0.4">
                <animate attributeName="rx" values="100;130;100" dur="4s" repeatCount="indefinite" />
              </ellipse>
              <ellipse cx="700" cy="406" rx="60" ry="12" fill="#082f49" opacity="0.7" />

              <!-- ======================================================== -->
              <!-- DINÁMICA DE IMPACTO, AVALANCHA Y OLA DE TSUNAMI (Escena 3) -->
              <!-- ======================================================== -->
              <g id="fx-aluvion-dinamico" class="hidden">
                <!-- Bloque de cornisa de hielo precipitándose -->
                <polygon points="685,240 715,225 730,260 695,275" fill="#f8fafc" stroke="#38bdf8" stroke-width="2">
                  <animate attributeName="transform" type="translate" values="0,-60; 0,130" dur="1s" repeatCount="indefinite" />
                  <animate attributeName="opacity" values="1;0.9;0" dur="1s" repeatCount="indefinite" />
                </polygon>

                <!-- Estela de polvo y caída de roca -->
                <line x1="705" y1="230" x2="705" y2="380" stroke="#f8fafc" stroke-width="3" stroke-dasharray="6 6" opacity="0.6">
                  <animate attributeName="stroke-dashoffset" values="0;24" dur="0.5s" repeatCount="indefinite" />
                </line>

                <!-- Ola gigante de desplazamiento (Tsunami lacustre de 28m) -->
                <ellipse cx="700" cy="400" rx="90" ry="28" fill="none" stroke="#ffffff" stroke-width="4">
                  <animate attributeName="rx" values="30;200" dur="1.2s" repeatCount="indefinite" />
                  <animate attributeName="ry" values="8;54" dur="1.2s" repeatCount="indefinite" />
                  <animate attributeName="opacity" values="1;0" dur="1.2s" repeatCount="indefinite" />
                </ellipse>

                <!-- Desborde violento sobre la morrena -->
                <path d="M 660,425 Q 700,490 740,425 Z" fill="#38bdf8" opacity="0.95" filter="url(#neon-glow)">
                  <animate attributeName="d" values="M 670,425 Q 700,450 730,425 Z; M 650,425 Q 700,520 750,425 Z; M 670,425 Q 700,450 730,425 Z" dur="0.9s" repeatCount="indefinite" />
                </path>

                <!-- Círculo de advertencia de ruptura en la morrena -->
                <circle cx="700" cy="445" r="22" fill="none" stroke="#ef4444" stroke-width="3" opacity="0.9">
                  <animate attributeName="r" values="15;35" dur="0.8s" repeatCount="indefinite" />
                  <animate attributeName="opacity" values="1;0" dur="0.8s" repeatCount="indefinite" />
                </circle>
              </g>

              <!-- ======================================================== -->
              <!-- INGENIERÍA DE MITIGACIÓN Y SISTEMA SAT (Escena 5)        -->
              <!-- ======================================================== -->
              <g id="fx-obra-seguridad" class="hidden">
                <!-- Dique de Concreto Reforzado en Verde Esmeralda -->
                <rect x="650" y="435" width="100" height="22" rx="6" fill="#10b981" filter="url(#neon-glow)" />
                <line x1="665" y1="446" x2="735" y2="446" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
                <text x="700" y="450" fill="#ffffff" font-size="9" font-weight="900" text-anchor="middle" font-family="sans-serif" letter-spacing="1">DIQUE REFORZADO</text>

                <!-- Compuerta / Bocatoma de desagüe seguro -->
                <circle cx="700" cy="465" r="5" fill="#047857" stroke="#34d399" stroke-width="2" />

                <!-- Torre SAT con Ondas de Alerta Temprana -->
                <line x1="860" y1="400" x2="860" y2="355" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
                <polygon points="852,360 868,360 860,350" fill="#10b981" />
                <circle cx="860" cy="350" r="4" fill="#34d399" />
                
                <!-- Ondas de radio radar del SAT -->
                <circle cx="860" cy="350" r="10" fill="none" stroke="#34d399" stroke-width="2">
                  <animate attributeName="r" values="6;30" dur="1.6s" repeatCount="indefinite" />
                  <animate attributeName="opacity" values="1;0" dur="1.6s" repeatCount="indefinite" />
                </circle>
                <circle cx="860" cy="350" r="20" fill="none" stroke="#34d399" stroke-width="1.5">
                  <animate attributeName="r" values="10;45" dur="1.6s" begin="0.4s" repeatCount="indefinite" />
                  <animate attributeName="opacity" values="1;0" dur="1.6s" begin="0.4s" repeatCount="indefinite" />
                </circle>
              </g>

            </g>

            <!-- ======================================================== -->
            <!-- PASTILLAS GEOLÓGICAS FLOTANTES (Conectadas al relieve)   -->
            <!-- ======================================================== -->
            <!-- Pastilla Cumbre / Glaciar de Cabecera -->
            <g id="badge-pico" transform="translate(850, 75)" class="transition-transform duration-700">
              <rect x="0" y="0" width="160" height="42" rx="21" fill="#ffffff" filter="drop-shadow(0 10px 20px rgba(0,0,0,0.6))" />
              <text id="lbl-nombre-pico" x="80" y="26" fill="#0f172a" font-size="14" font-weight="900" text-anchor="middle" font-family="sans-serif">Hualcán</text>
            </g>

            <!-- Pastilla Laguna -->
            <g id="badge-laguna" transform="translate(410, 310)" class="transition-transform duration-700">
              <rect x="0" y="0" width="180" height="44" rx="22" fill="#0284c7" fill-opacity="0.95" filter="drop-shadow(0 8px 16px rgba(0,0,0,0.5))" />
              <text id="lbl-nombre-laguna" x="90" y="27" fill="#ffffff" font-size="14" font-weight="900" text-anchor="middle" font-family="sans-serif">Laguna 513</text>
            </g>

          </g>
          <!-- FIN DEL GRUPO CÁMARA CINEMÁTICA -->

        </svg>

        <!-- Callouts flotantes HUD en esquinas del lienzo -->
        <div class="absolute bottom-5 left-6 flex items-center gap-3 bg-slate-950/80 backdrop-blur-md px-4 py-2 rounded-2xl border border-slate-700/70 text-xs shadow-xl">
          <span class="h-2.5 w-2.5 rounded-full bg-sky-400 animate-ping"></span>
          <span id="callout-cota-texto" class="font-bold text-slate-100 font-mono tracking-tight">ENFOQUE: GLACIAR DE CABECERA (6,122 M)</span>
        </div>

        <div class="hidden sm:flex absolute top-5 right-6 items-center gap-2 bg-slate-950/70 backdrop-blur-md px-3 py-1.5 rounded-xl border border-slate-800 text-[11px] text-slate-300 font-mono">
          <span class="text-sky-400">●</span>
          <span>Modelo Morfométrico UNMSM</span>
        </div>

      </div>

      <!-- ======================================================== -->
      <!-- PANEL NARRATIVO Y CONTROLES DE LAS 5 ESCENAS             -->
      <!-- ======================================================== -->
      <div class="p-5 sm:p-7 bg-[#070e1c] border-t border-slate-800/90 space-y-4">
        
        <!-- Barra de progreso segmentada de 5 escenas interactiva con etiquetas -->
        <div class="grid grid-cols-5 gap-2 sm:gap-3">
          {[
            { n: 1, label: "1. El hielo" },
            { n: 2, label: "2. La laguna" },
            { n: 3, label: "3. El aluvión" },
            { n: 4, label: "4. Aguas abajo" },
            { n: 5, label: "5. Hoy y SAT" },
          ].map(fase => (
            <button 
              type="button" 
              class="btn-escena-seg group flex flex-col gap-1.5 focus:outline-none text-left"
              data-escena-index={fase.n}
              title={`Ir a Escena ${fase.n}: ${fase.label}`}
            >
              <div class="bar-indicador h-2 w-full rounded-full transition-all duration-300 bg-slate-800 group-hover:bg-slate-700"></div>
              <span class="lbl-fase hidden sm:inline text-[11px] font-bold text-slate-500 group-hover:text-slate-300 transition-colors uppercase tracking-wider">{fase.label}</span>
            </button>
          ))}
        </div>

        <!-- Encabezado de la escena actual -->
        <div class="flex items-center justify-between text-xs sm:text-sm font-bold text-sky-400 pt-1">
          <span id="txt-escena-subtitulo">Laguna 513, Áncash. Escena 1 de 5: el hielo</span>
          <span id="txt-escena-alerta" class="hidden text-amber-400 font-semibold text-xs flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-amber-400 animate-ping"></span>
            <span>Pieza que falta en los documentos oficiales</span>
          </span>
        </div>

        <!-- Texto explicativo de alto impacto -->
        <p id="txt-escena-cuerpo" class="text-base sm:text-xl font-bold text-slate-100 leading-snug min-h-[56px] transition-opacity duration-200">
          El deshielo de Hualcán alimenta la laguna 513. En todo el Perú ya se perdió el 52 % del hielo (1962-2016).
        </p>

        <!-- Pie de la escena: Cita del documento oficial + Controles cinemáticos + Ver Ficha -->
        <div class="pt-3 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs border-t border-slate-800/80">
          <div class="flex items-center gap-2">
            <span class="text-slate-500 font-mono">EVIDENCIA:</span>
            <span id="txt-escena-fuente" class="text-slate-300 font-medium bg-slate-900 px-2.5 py-1 rounded-md border border-slate-800">Fuente: INAIGEM 2017 · p. 9</span>
          </div>

          <div class="flex items-center gap-3">
            <!-- Controles Cinemáticos [ ◀ ] [ || ] [ ▶ ] -->
            <div class="flex items-center gap-1 bg-slate-900 rounded-xl p-1 border border-slate-700/80 shadow-inner">
              <button id="ctrl-prev" type="button" class="p-2 text-slate-300 hover:text-white rounded-lg hover:bg-slate-800 transition" title="Escena anterior">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>
              </button>
              <button id="ctrl-playpause" type="button" class="p-2 text-slate-300 hover:text-white rounded-lg hover:bg-slate-800 transition" title="Pausar / Reproducir">
                <svg id="icon-pause" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/></svg>
                <svg id="icon-play" class="h-4 w-4 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </button>
              <button id="ctrl-next" type="button" class="p-2 text-slate-300 hover:text-white rounded-lg hover:bg-slate-800 transition" title="Escena siguiente">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
              </button>
            </div>

            <!-- Botón Ver Ficha -->
            <a 
              id="btn-ver-ficha"
              href="#comparar" 
              class="whitespace-nowrap rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 px-4 py-2.5 font-bold text-xs transition shadow-md flex items-center gap-1.5"
            >
              <span>Ver ficha técnica</span>
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  /* Animación de temblor sísmico e impacto de aluvión en Escena 3 */
  @keyframes temblorAluvion {
    0% { transform: scale(1.48) translate(30px, 15px); }
    15% { transform: scale(1.49) translate(36px, 10px); }
    30% { transform: scale(1.47) translate(24px, 20px); }
    50% { transform: scale(1.49) translate(34px, 12px); }
    70% { transform: scale(1.48) translate(26px, 18px); }
    85% { transform: scale(1.49) translate(32px, 14px); }
    100% { transform: scale(1.48) translate(30px, 15px); }
  }
  .anim-sacudida {
    animation: temblorAluvion 0.35s ease-in-out infinite alternate !important;
  }
</style>

<script>
  import { LAGUNAS_ESCENAS } from '../config/scenes.data';

  let lagunaActivaId = "513";
  let escenaActual = 1; // 1 a 5
  let timerAutoPlay: any = null;
  let isPlaying = true;

  // Elementos DOM
  const tabsLaguna = document.querySelectorAll('.tab-laguna-escena');
  const segmentos = document.querySelectorAll('.btn-escena-seg');
  const txtSubtitulo = document.getElementById('txt-escena-subtitulo');
  const txtAlerta = document.getElementById('txt-escena-alerta');
  const txtCuerpo = document.getElementById('txt-escena-cuerpo');
  const txtFuente = document.getElementById('txt-escena-fuente');
  const btnFicha = document.getElementById('btn-ver-ficha');
  const badgeFase = document.getElementById('badge-fase-indicador');
  const calloutCota = document.getElementById('callout-cota-texto');
  
  // Elementos SVG y Cámara
  const contenedorCinematico = document.getElementById('contenedor-cinematico');
  const camara = document.getElementById('camara-escena');
  const lblPico = document.getElementById('lbl-nombre-pico');
  const lblLaguna = document.getElementById('lbl-nombre-laguna');
  const svgAluvion = document.getElementById('fx-aluvion-dinamico');
  const svgDique = document.getElementById('fx-obra-seguridad');
  const capaValle = document.getElementById('capa-valle-abajo');
  const fxDeshielo = document.getElementById('fx-deshielo-gotas');

  // Controles
  const btnPrev = document.getElementById('ctrl-prev');
  const btnNext = document.getElementById('ctrl-next');
  const btnPlayPause = document.getElementById('ctrl-playpause');
  const iconPause = document.getElementById('icon-pause');
  const iconPlay = document.getElementById('icon-play');

  // ========================================================
  // MATRIZ DE TRANSFORMACIONES CINEMÁTICAS DE CÁMARA (WIDESCREEN 1400x680)
  // Origin: 700px 340px
  // ========================================================
  const POSICIONES_CAMARA: Record<number, { transform: string; cota: string; fase: string; sacudida?: boolean }> = {
    1: {
      // Escena 1: El Hielo -> Zoom dramático cercano en la cumbre nevada, seracs y fusión
      transform: "scale(1.85) translate(0px, 160px)",
      cota: "ENFOQUE: GLACIAR DE CABECERA · COTA 6,122 M",
      fase: "Fase 1: El Hielo"
    },
    2: {
      // Escena 2: La Laguna -> Retroceso y ángulo descendente hacia el vaso lacustre
      transform: "scale(1.3) translate(0px, -25px)",
      cota: "ENFOQUE: VASO Y PROFUNDIDAD · COTA 4,431 M",
      fase: "Fase 2: La Laguna"
    },
    3: {
      // Escena 3: El día que pasó -> Enfoque medio tenso en la morrena con temblor sísmico y ola
      transform: "scale(1.48) translate(30px, 15px)",
      cota: "EVENTO CRÍTICO: RUPTURA Y OLA DE ALURIÓN",
      fase: "Fase 3: Aluvión",
      sacudida: true
    },
    4: {
      // Escena 4: Aguas abajo -> Retroceso panorámico total (revela el cañón inferior y valle)
      transform: "scale(0.82) translate(0px, -115px)",
      cota: "PERSPECTIVA: CAÑÓN, QUEBRADA Y VALLE URBANO",
      fase: "Fase 4: Aguas abajo"
    },
    5: {
      // Escena 5: Hoy -> Vista equilibrada de mitigación, dique y alerta temprana SAT
      transform: "scale(1.1) translate(0px, -20px)",
      cota: "SEGURIDAD ACTIVA: DIQUE REFORZADO Y SAT 24/7",
      fase: "Fase 5: Mitigación actual"
    }
  };

  function renderizarEscena() {
    const dataLaguna = LAGUNAS_ESCENAS[lagunaActivaId] || LAGUNAS_ESCENAS["513"];
    const escena = dataLaguna.escenas.find(e => e.numero === escenaActual) || dataLaguna.escenas[0];
    const camCfg = POSICIONES_CAMARA[escenaActual] || POSICIONES_CAMARA[1];

    const nombreLimpio = dataLaguna.nombre.startsWith('Laguna') ? dataLaguna.nombre : `Laguna ${dataLaguna.nombre}`;

    // 1. Textos
    if (txtSubtitulo) {
      txtSubtitulo.textContent = `${nombreLimpio}, ${dataLaguna.departamento}. Escena ${escena.numero} de 5: ${escena.tituloFase}`;
    }
    if (txtCuerpo) {
      txtCuerpo.style.opacity = '0';
      setTimeout(() => {
        if (txtCuerpo) {
          txtCuerpo.textContent = escena.texto;
          txtCuerpo.style.opacity = '1';
        }
      }, 150);
    }
    if (txtFuente) txtFuente.textContent = escena.fuente;
    if (badgeFase) badgeFase.textContent = camCfg.fase;
    if (calloutCota) calloutCota.textContent = camCfg.cota;
    
    if (btnFicha) {
      btnFicha.innerHTML = `<span>Ver ficha de ${nombreLimpio}</span> <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>`;
      btnFicha.setAttribute('href', `#comparar`);
    }

    // Alerta de pieza que falta en los documentos
    if (txtAlerta) {
      if (escena.alertaFalta) {
        txtAlerta.textContent = `○ ${escena.alertaFalta}`;
        txtAlerta.classList.remove('hidden');
      } else {
        txtAlerta.classList.add('hidden');
      }
    }

    // 2. Barra de progreso de 5 segmentos
    segmentos.forEach((seg, idx) => {
      const segNum = idx + 1;
      const bar = seg.querySelector('.bar-indicador');
      const lbl = seg.querySelector('.lbl-fase');
      
      if (bar) {
        bar.classList.remove('bg-sky-400', 'bg-slate-400', 'bg-slate-800');
        if (segNum < escenaActual) {
          bar.classList.add('bg-slate-400');
        } else if (segNum === escenaActual) {
          bar.classList.add('bg-sky-400');
        } else {
          bar.classList.add('bg-slate-800');
        }
      }

      if (lbl) {
        lbl.classList.remove('text-sky-300', 'text-slate-300', 'text-slate-500');
        if (segNum === escenaActual) {
          lbl.classList.add('text-sky-300');
        } else if (segNum < escenaActual) {
          lbl.classList.add('text-slate-300');
        } else {
          lbl.classList.add('text-slate-500');
        }
      }
    });

    // 3. Etiquetas SVG
    if (lblPico) lblPico.textContent = dataLaguna.glaciarCabecera;
    if (lblLaguna) lblLaguna.textContent = nombreLimpio;

    // 4. ANIMACIÓN DINÁMICA DE CÁMARA (Zoom, Retroceso y Perspectiva)
    if (camara) {
      camara.classList.remove('anim-sacudida');
      camara.style.transform = camCfg.transform;
      
      if (camCfg.sacudida) {
        setTimeout(() => {
          camara.classList.add('anim-sacudida');
        }, 250);
      }
    }

    // 5. Visibilidad dinámica de elementos geológicos
    if (capaValle) {
      capaValle.style.opacity = escenaActual === 4 ? '1' : '0.35';
    }

    if (fxDeshielo) {
      fxDeshielo.style.opacity = escenaActual === 1 ? '1' : '0.4';
    }

    if (svgAluvion) {
      if (escena.svgVisual.tieneOla) {
        svgAluvion.classList.remove('hidden');
      } else {
        svgAluvion.classList.add('hidden');
      }
    }

    if (svgDique) {
      if (escena.svgVisual.tieneDique) {
        svgDique.classList.remove('hidden');
      } else {
        svgDique.classList.add('hidden');
      }
    }
  }

  function avanzarEscena() {
    escenaActual = escenaActual < 5 ? escenaActual + 1 : 1;
    renderizarEscena();
  }

  function retrocederEscena() {
    escenaActual = escenaActual > 1 ? escenaActual - 1 : 5;
    renderizarEscena();
  }

  function reiniciarAutoPlay() {
    if (timerAutoPlay) clearInterval(timerAutoPlay);
    if (isPlaying) {
      timerAutoPlay = setInterval(avanzarEscena, 5500);
    }
  }

  // Parallax interactivo sutil al mover el ratón sobre la cordillera
  if (contenedorCinematico && camara) {
    contenedorCinematico.addEventListener('mousemove', (e) => {
      const rect = contenedorCinematico.getBoundingClientRect();
      const xRel = (e.clientX - rect.left) / rect.width - 0.5; // -0.5 a 0.5
      const yRel = (e.clientY - rect.top) / rect.height - 0.5;
      
      const camCfg = POSICIONES_CAMARA[escenaActual] || POSICIONES_CAMARA[1];
      if (!camCfg.sacudida) {
        camara.style.transform = `${camCfg.transform} translate(${xRel * 16}px, ${yRel * 10}px)`;
      }
    });

    contenedorCinematico.addEventListener('mouseleave', () => {
      const camCfg = POSICIONES_CAMARA[escenaActual] || POSICIONES_CAMARA[1];
      camara.style.transform = camCfg.transform;
    });
  }

  // Event Listeners: Pestañas de Lagunas
  tabsLaguna.forEach(tab => {
    tab.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      tabsLaguna.forEach(t => {
        t.classList.remove('bg-white', 'text-slate-950', 'shadow-md', 'ring-2', 'ring-white/20');
        t.classList.add('bg-slate-900/90', 'text-slate-400');
      });
      target.classList.add('bg-white', 'text-slate-950', 'shadow-md', 'ring-2', 'ring-white/20');
      target.classList.remove('bg-slate-900/90', 'text-slate-400');

      lagunaActivaId = target.getAttribute('data-laguna-id') || "513";
      escenaActual = 1;
      renderizarEscena();
      reiniciarAutoPlay();
    });
  });

  // Event Listeners: Clic directo en segmentos de progreso
  segmentos.forEach((seg, idx) => {
    seg.addEventListener('click', () => {
      escenaActual = idx + 1;
      renderizarEscena();
      reiniciarAutoPlay();
    });
  });

  // Controles Cinemáticos
  btnPrev?.addEventListener('click', () => {
    retrocederEscena();
    reiniciarAutoPlay();
  });

  btnNext?.addEventListener('click', () => {
    avanzarEscena();
    reiniciarAutoPlay();
  });

  btnPlayPause?.addEventListener('click', () => {
    isPlaying = !isPlaying;
    if (isPlaying) {
      iconPause?.classList.remove('hidden');
      iconPlay?.classList.add('hidden');
      reiniciarAutoPlay();
    } else {
      iconPause?.classList.add('hidden');
      iconPlay?.classList.remove('hidden');
      if (timerAutoPlay) clearInterval(timerAutoPlay);
    }
  });

  // Inicializar
  renderizarEscena();
  reiniciarAutoPlay();

  // Buscador sugerencias
  const searchInput = document.getElementById('hero-search-input') as HTMLInputElement | null;
  const sugerencias = document.querySelectorAll('.btn-sugerencia');
  sugerencias.forEach(btn => {
    btn.addEventListener('click', () => {
      if (searchInput && btn.textContent) {
        searchInput.value = btn.textContent.trim();
        window.location.hash = 'buscar';
      }
    });
  });
</script>
