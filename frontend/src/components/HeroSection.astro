---
import { LAGUNAS_DESTACADAS } from '../config/metrics.data';
---

<section class="relative overflow-hidden border-b border-slate-200 bg-white py-12 lg:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Lado Izquierdo: Buscador y Mensaje Principal -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs text-slate-600">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          <span class="font-medium text-slate-900">398 Informes oficiales</span>
          <span>·</span>
          <span>Cada dato con su fuente</span>
        </div>

        <div class="space-y-3">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-950 leading-[1.15]">
            ¿Hay riesgo de desborde donde vives?
          </h1>
          <p class="text-base text-slate-600 leading-relaxed max-w-xl">
            Escribe tu pueblo o una laguna: te mostramos qué hay aguas arriba, qué pasó antes y de qué documento técnico proviene cada evidencia.
          </p>
        </div>

        <!-- Buscador con predictivo -->
        <div class="relative max-w-lg">
          <div class="relative flex items-center">
            <input 
              id="hero-search-input"
              type="text" 
              placeholder="Escribe tu pueblo, departamento o una laguna..." 
              class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 pl-11 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900 transition"
            />
            <svg class="absolute left-3.5 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <!-- Sugerencias rápidas -->
          <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
            <span class="font-medium text-slate-400">O prueba con:</span>
            <button type="button" class="btn-sugerencia rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100 transition">Huaraz</button>
            <button type="button" class="btn-sugerencia rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100 transition">Parón</button>
            <button type="button" class="btn-sugerencia rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100 transition">Cusco</button>
            <button type="button" class="btn-sugerencia rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100 transition">Laguna 513</button>
          </div>
        </div>
      </div>

      <!-- Lado Derecho: Simulación Esquemática Interactiva (Corte Transversal) -->
      <div class="lg:col-span-6">
        <div class="rounded-2xl border border-slate-800 bg-slate-950 p-5 shadow-xl text-white">
          
          <!-- Pestañas de Lagunas Críticas -->
          <div class="flex items-center gap-1.5 overflow-x-auto pb-3 text-xs border-b border-slate-800">
            {LAGUNAS_DESTACADAS.map((l, idx) => (
              <button 
                type="button" 
                class={`tab-laguna whitespace-nowrap rounded-lg px-3 py-1.5 font-medium transition ${idx === 0 ? 'bg-slate-800 text-white shadow-sm' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-900'}`}
                data-id={l.id}
                data-nombre={l.nombre}
                data-volumen={l.volumen_hm3}
                data-altitud={l.altitud_msnm}
                data-glaciar={l.glaciar_origen}
                data-riesgo={l.riesgo}
                data-ano={l.ano_evento_critico || 'N/A'}
              >
                <span class={`inline-block h-1.5 w-1.5 rounded-full mr-1.5 ${l.riesgo === 'Muy alto' ? 'bg-rose-500' : 'bg-amber-400'}`}></span>
                {l.nombre} {l.ano_evento_critico ? `· ${l.ano_evento_critico}` : ''}
              </button>
            ))}
          </div>

          <!-- Lienzo Esquemático de la Montaña y Laguna (SVG Interactivo) -->
          <div class="relative mt-4 h-56 w-full rounded-xl bg-slate-900/60 overflow-hidden flex items-center justify-center border border-slate-800/80">
            <svg id="esquema-corte" class="h-full w-full" viewBox="0 0 500 240" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Fondo cielo de alta montaña -->
              <rect width="500" height="240" fill="#090d16" />

              <!-- Montaña y Glaciar colgante (Fondo) -->
              <path d="M 0,240 L 90,80 L 160,130 L 260,30 L 360,140 L 440,90 L 500,240 Z" fill="#131c2e" />
              <!-- Casquete de Nieve y Hielo -->
              <path d="M 90,80 L 115,100 L 140,85 L 160,130 L 210,75 L 260,30 L 310,85 L 360,140 L 400,110 L 440,90 L 470,120 L 500,105 L 500,240 L 0,240 Z" fill="#1e293b" opacity="0.4" />
              <path d="M 230,45 L 260,30 L 290,55 L 260,65 Z" fill="#f8fafc" />
              <path d="M 75,95 L 90,80 L 110,95 Z" fill="#e2e8f0" />

              <!-- Morrena y vaso de la laguna -->
              <path d="M 120,240 Q 180,180 230,180 Q 300,180 370,240 Z" fill="#0f172a" />
              
              <!-- Agua de la laguna (dinámica con animación de oleaje sutil) -->
              <ellipse id="esquema-agua" cx="250" cy="190" rx="90" ry="25" fill="#0284c7" opacity="0.85">
                <animate attributeName="ry" values="24;26;24" dur="4s" repeatCount="indefinite" />
              </ellipse>

              <!-- Etiquetas técnicas dentro del esquema -->
              <text id="txt-glaciar" x="260" y="25" fill="#94a3b8" font-size="10" font-family="sans-serif" text-anchor="middle" font-weight="600">Palcaraju (Glaciar de cabecera)</text>
              <rect x="180" y="178" width="140" height="22" rx="4" fill="#0284c7" fill-opacity="0.9" />
              <text id="txt-laguna" x="250" y="193" fill="#ffffff" font-size="11" font-family="sans-serif" text-anchor="middle" font-weight="700">Laguna Palcacocha</text>
            </svg>

            <!-- Indicador en vivo de volumen y altitud -->
            <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs bg-slate-900/90 backdrop-blur-sm px-3.5 py-2 rounded-lg border border-slate-700/60">
              <div class="flex items-center gap-3">
                <span class="text-slate-400">Volumen:</span>
                <span id="stat-volumen" class="font-bold text-sky-400">17.3 millones de m³</span>
                <span class="text-slate-600">|</span>
                <span class="text-slate-400">Altitud:</span>
                <span id="stat-altitud" class="font-medium text-slate-200">4,566 msnm</span>
              </div>
              <a href="#comparar" class="text-sky-400 hover:text-sky-300 font-medium text-[11px] underline underline-offset-2">Ficha completa →</a>
            </div>
          </div>

          <!-- Controles de navegación de la muestra -->
          <div class="mt-3 flex items-center justify-between text-xs text-slate-400">
            <span class="text-[11px] text-slate-500">Haz clic en cada laguna para ver su vaso y nivel de riesgo</span>
            <span id="stat-riesgo-badge" class="rounded bg-rose-500/20 text-rose-300 px-2 py-0.5 text-[11px] font-semibold border border-rose-500/30">Riesgo: Muy alto</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Interactividad de pestañas en el Hero
  const tabs = document.querySelectorAll('.tab-laguna');
  const txtGlaciar = document.getElementById('txt-glaciar');
  const txtLaguna = document.getElementById('txt-laguna');
  const statVolumen = document.getElementById('stat-volumen');
  const statAltitud = document.getElementById('stat-altitud');
  const statRiesgo = document.getElementById('stat-riesgo-badge');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('bg-slate-800', 'text-white', 'shadow-sm');
        t.classList.add('text-slate-400');
      });
      tab.classList.add('bg-slate-800', 'text-white', 'shadow-sm');
      tab.classList.remove('text-slate-400');

      const nombre = tab.getAttribute('data-nombre') || '';
      const glaciar = tab.getAttribute('data-glaciar') || '';
      const volumen = tab.getAttribute('data-volumen') || '';
      const altitud = tab.getAttribute('data-altitud') || '';
      const riesgo = tab.getAttribute('data-riesgo') || '';

      if (txtLaguna) txtLaguna.textContent = `Laguna ${nombre}`;
      if (txtGlaciar) txtGlaciar.textContent = `${glaciar} (Glaciar de cabecera)`;
      if (statVolumen) statVolumen.textContent = `${volumen} millones de m³`;
      if (statAltitud) statAltitud.textContent = `${altitud} msnm`;
      if (statRiesgo) {
        statRiesgo.textContent = `Riesgo: ${riesgo}`;
        statRiesgo.className = riesgo === 'Muy alto' 
          ? 'rounded bg-rose-500/20 text-rose-300 px-2 py-0.5 text-[11px] font-semibold border border-rose-500/30'
          : 'rounded bg-amber-500/20 text-amber-300 px-2 py-0.5 text-[11px] font-semibold border border-amber-500/30';
      }
    });
  });

  // Buscador predictivo rápido
  const searchInput = document.getElementById('hero-search-input') as HTMLInputElement | null;
  const sugerencias = document.querySelectorAll('.btn-sugerencia');
  sugerencias.forEach(btn => {
    btn.addEventListener('click', () => {
      if (searchInput && btn.textContent) {
        searchInput.value = btn.textContent.trim();
        window.location.hash = 'buscar';
      }
    });
  });
</script>
