---
// HeroSection.astro: Sobrevuelo Aéreo 3D Cinematográfico de los Andes Peruanos (Sur a Norte)
// Iteración 2: Composición centrada a la derecha, relieve suave y natural (sin facetas low-poly),
// texturas de alta montaña, iluminación solar con oclusión ambiental y 14 nevados del RAG.
---

<section class="relative overflow-hidden border-b border-slate-200 bg-[#050b17] w-full min-h-[580px] lg:min-h-[660px] xl:min-h-[720px] flex items-center">
  
  <!-- ======================================================== -->
  <!-- LIENZO 3D WEBGL: SOBREVUELO CONTINUO DE LOS ANDES         -->
  <!-- ======================================================== -->
  <div class="absolute inset-0 w-full h-full overflow-hidden select-none">
    
    <!-- Canvas de renderizado Three.js -->
    <canvas id="canvas-sobrevuelo-andes" class="absolute inset-0 w-full h-full block"></canvas>

    <!-- Capa de Etiquetas Cartográficas Proyectadas en 3D -->
    <div id="contenedor-etiquetas-3d" class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden z-10">
      <!-- Las etiquetas se proyectan matemáticamente en tiempo real por Three.js -->
    </div>

    <!-- Indicador HUD de Vuelo Aéreo y Rumbo (Esquina Inferior Derecha) -->
    <div class="absolute bottom-6 right-6 z-20 flex items-center gap-3 bg-slate-950/85 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-slate-700/70 text-xs shadow-2xl pointer-events-none">
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider font-semibold">Sobrevuelo Aéreo en Vivo</span>
        </div>
        <span id="hud-telemetria-vuelo" class="font-mono font-bold text-sky-300 text-xs">
          Rumbo 355° N · Trayectoria Sur a Norte
        </span>
      </div>
      <div class="h-8 w-px bg-slate-800"></div>
      <div class="flex flex-col text-[11px] font-mono text-slate-300">
        <span class="text-slate-500 text-[9px] uppercase">Altitud Vuelo</span>
        <span class="text-emerald-400 font-bold">5,800 m</span>
      </div>
    </div>

  </div>

  <!-- ======================================================== -->
  <!-- MÁSCARA GRADUAL DE DIFUMINADO (BLANCO A ALTA MONTAÑA)     -->
  <!-- ======================================================== -->
  <div class="absolute inset-y-0 left-0 w-full lg:w-[62%] xl:w-[54%] 2xl:w-[48%] bg-gradient-to-r from-white via-white via-70% to-transparent pointer-events-none z-20 hidden lg:block"></div>
  <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-white via-white/90 to-transparent pointer-events-none z-20 lg:hidden"></div>

  <!-- ======================================================== -->
  <!-- CONTENIDO FRONTAL (IZQUIERDA): PREGUNTA Y BUSCADOR        -->
  <!-- En fondo blanco puro institucional                       -->
  <!-- ======================================================== -->
  <div class="relative z-30 w-full px-4 sm:px-8 lg:px-12 xl:px-16 2xl:px-20 py-8 lg:py-16">
    <div class="max-w-xl xl:max-w-2xl bg-white/95 lg:bg-transparent p-6 sm:p-8 lg:p-0 rounded-3xl lg:rounded-none shadow-xl lg:shadow-none border border-slate-200/80 lg:border-none backdrop-blur-md lg:backdrop-blur-none space-y-6">
      
      <!-- Pastilla Institucional -->
      <div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 text-xs text-slate-700 shadow-xs">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-semibold text-slate-900">398 Informes oficiales digitalizados</span>
        <span class="text-slate-300">|</span>
        <span>Evidencia con trazabilidad científica</span>
      </div>

      <!-- Título de impacto -->
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl 2xl:text-6xl font-black tracking-tight text-slate-950 leading-[1.12]">
          ¿Hay riesgo donde vives?
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl">
          Escribe tu pueblo, departamento o una laguna: te mostramos qué glaciares hay aguas arriba, qué eventos históricos ocurrieron y de qué informe técnico oficial proviene cada dato.
        </p>
      </div>

      <!-- Buscador Institucional con Icono -->
      <div class="space-y-3">
        <div class="relative max-w-lg">
          <input 
            id="hero-search-input"
            type="text" 
            placeholder="Escribe tu pueblo, departamento o una laguna..." 
            class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 pl-11 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-slate-950 focus:outline-none focus:ring-2 focus:ring-slate-950/10 transition"
          />
          <svg class="absolute left-3.5 top-4 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Consultas rápidas recomendadas -->
        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
          <span class="font-medium text-slate-400">O prueba con:</span>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-2xs">Huaraz</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-2xs">Laguna 513</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-2xs">Parón</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-2xs">Cusco</button>
        </div>
      </div>

      <!-- Enlace directo al simulador de cuencas -->
      <div class="pt-2 flex items-center gap-3">
        <a 
          href="#simulador-cordillera" 
          class="inline-flex items-center gap-2 text-xs font-bold text-slate-800 hover:text-sky-600 bg-slate-100 hover:bg-slate-200/80 px-3.5 py-2 rounded-xl transition border border-slate-200 shadow-2xs"
        >
          <span>Ver anatomía de un aluvión en 5 escenas</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
        </a>
      </div>

    </div>
  </div>

</section>

<!-- ======================================================== -->
<!-- SCRIPT DE SIMULACIÓN THREE.JS (SOBREVUELO SUR A NORTE)   -->
<!-- ======================================================== -->
<script>
  import * as THREE from 'three';

  // Elementos DOM
  const canvas = document.getElementById('canvas-sobrevuelo-andes') as HTMLCanvasElement;
  const containerEtiquetas = document.getElementById('contenedor-etiquetas-3d') as HTMLDivElement;
  const hudTelemetria = document.getElementById('hud-telemetria-vuelo') as HTMLSpanElement;

  if (canvas && containerEtiquetas) {
    
    // 1. Configuración de Escena y Renderizador WebGL
    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#070e1c');
    scene.fog = new THREE.FogExp2('#070e1c', 0.0014);

    // FOV cinematográfico de 44° para perspectiva aérea natural sin deformación gran angular
    const camera = new THREE.PerspectiveCamera(44, canvas.clientWidth / canvas.clientHeight, 1, 2600);
    
    const renderer = new THREE.WebGLRenderer({
      canvas: canvas,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);

    // 2. Iluminación Natural de Alta Montaña (Luz solar cálida + cielo alpino difuso)
    // Luz ambiental fría de bóveda celeste andina
    const hemiLight = new THREE.HemisphereLight('#7dd3fc', '#091224', 1.15);
    scene.add(hemiLight);

    // Sol andino oblicuo: proyecta sombras suaves y resalta aristas de nieve
    const sunLight = new THREE.DirectionalLight('#fffbeb', 2.3);
    sunLight.position.set(-180, 260, -120);
    scene.add(sunLight);

    // Luz de contorno (Rim light) para realzar el filo de los neveros
    const rimLight = new THREE.DirectionalLight('#93c5fd', 1.4);
    rimLight.position.set(220, 140, 160);
    scene.add(rimLight);

    // 3. Catálogo Extendido de Nevados del RAG (Sur a Norte en el eje Z)
    // Coordenadas mundiales orientadas al sector derecho (X: 30 a 160)
    // Garantiza que todos los nevados y etiquetas vivan en el panel visible de la derecha
    const NEVADOS_RAG = [
      {
        id: 'ausangate',
        nombre: 'NEVADO AUSANGATE',
        cota: '6,384 m s. n. m.',
        cordillera: 'Cordillera Vilcanota · Cusco',
        pos: new THREE.Vector3(45, 118, -320),
        colorPunto: '#38bdf8'
      },
      {
        id: 'quelccaya',
        nombre: 'GLACIAR QUELCCAYA',
        cota: '5,670 m s. n. m.',
        cordillera: 'Casquete Tropical · Puno',
        pos: new THREE.Vector3(125, 96, -580),
        colorPunto: '#38bdf8'
      },
      {
        id: 'salkantay',
        nombre: 'NEVADO SALKANTAY',
        cota: '6,271 m s. n. m.',
        cordillera: 'Cordillera Vilcabamba · Cusco',
        pos: new THREE.Vector3(60, 114, -840),
        colorPunto: '#38bdf8'
      },
      {
        id: 'pariacaca',
        nombre: 'NEVADO PARIACACA',
        cota: '5,750 m s. n. m.',
        cordillera: 'Cordillera Central · Lima/Junín',
        pos: new THREE.Vector3(135, 102, -1100),
        colorPunto: '#10b981'
      },
      {
        id: 'huaytapallana',
        nombre: 'NEVADO HUAYTAPALLANA',
        cota: '5,557 m s. n. m.',
        cordillera: 'Glaciar Lasuntay · Junín',
        pos: new THREE.Vector3(50, 98, -1340),
        colorPunto: '#10b981'
      },
      {
        id: 'siula',
        nombre: 'NEVADO SIULA GRANDE',
        cota: '6,344 m s. n. m.',
        cordillera: 'Cordillera Huayhuash',
        pos: new THREE.Vector3(130, 120, -1580),
        colorPunto: '#38bdf8'
      },
      {
        id: 'yerupaja',
        nombre: 'NEVADO YERUPAJÁ',
        cota: '6,635 m s. n. m.',
        cordillera: 'Cordillera Huayhuash · 2ª Cumbre',
        pos: new THREE.Vector3(70, 130, -1820),
        colorPunto: '#38bdf8'
      },
      {
        id: 'pastoruri',
        nombre: 'NEVADO PASTORURI',
        cota: '5,240 m s. n. m.',
        cordillera: 'Cordillera Blanca Sur · Áncash',
        pos: new THREE.Vector3(120, 94, -2060),
        colorPunto: '#10b981'
      },
      {
        id: 'palcaraju',
        nombre: 'NEVADO PALCARAJU',
        cota: '6,274 m s. n. m.',
        cordillera: 'Cabecera Laguna Palcacocha',
        pos: new THREE.Vector3(45, 118, -2300),
        colorPunto: '#f43f5e'
      },
      {
        id: 'huascaran',
        nombre: 'NEVADO HUASCARÁN SUR',
        cota: '6,768 m s. n. m.',
        cordillera: 'Máxima Cumbre del Perú · Áncash',
        pos: new THREE.Vector3(85, 142, -2560),
        colorPunto: '#38bdf8'
      },
      {
        id: 'hualcan',
        nombre: 'NEVADO HUALCÁN',
        cota: '6,122 m s. n. m.',
        cordillera: 'Cabecera Laguna 513 · Áncash',
        pos: new THREE.Vector3(135, 116, -2800),
        colorPunto: '#10b981'
      },
      {
        id: 'chopicalqui',
        nombre: 'NEVADO CHOPICALQUI',
        cota: '6,354 m s. n. m.',
        cordillera: 'Cordillera Blanca Central',
        pos: new THREE.Vector3(55, 122, -3020),
        colorPunto: '#38bdf8'
      },
      {
        id: 'artesonraju',
        nombre: 'NEVADO ARTESONRAJU',
        cota: '6,025 m s. n. m.',
        cordillera: 'Cabecera Laguna Parón · Áncash',
        pos: new THREE.Vector3(125, 112, -3260),
        colorPunto: '#10b981'
      },
      {
        id: 'alpamayo',
        nombre: 'NEVADO ALPAMAYO',
        cota: '5,947 m s. n. m.',
        cordillera: 'Pirámide Glaciar · Cordillera Blanca',
        pos: new THREE.Vector3(80, 110, -3500),
        colorPunto: '#38bdf8'
      }
    ];

    // Crear elementos DOM de las etiquetas flotantes
    const etiquetasDOM = NEVADOS_RAG.map(n => {
      const el = document.createElement('div');
      el.className = 'absolute top-0 left-0 transition-opacity duration-300 flex flex-col items-center pointer-events-none opacity-0';
      el.innerHTML = `
        <div class="flex flex-col items-center">
          <div class="bg-slate-950/90 border border-slate-700/80 rounded-xl px-3 py-1.5 shadow-2xl backdrop-blur-md flex flex-col items-center text-center">
            <span class="text-[9.5px] tracking-wider font-extrabold text-white uppercase">${n.nombre}</span>
            <span class="text-[11px] font-mono font-bold text-sky-400 leading-tight">${n.cota}</span>
            <span class="text-[8.5px] text-slate-400 font-medium">${n.cordillera}</span>
          </div>
          <div class="w-0.5 h-5 bg-gradient-to-b from-sky-400 to-transparent"></div>
          <div class="w-2.5 h-2.5 rounded-full" style="background-color: ${n.colorPunto}; box-shadow: 0 0 10px ${n.colorPunto};"></div>
        </div>
      `;
      containerEtiquetas.appendChild(el);
      return { data: n, dom: el };
    });

    // 4. Textura Procedural Orgánica de Alta Montaña (Estratos rocosos y granulometría de nieve)
    function createMountainTexture(): THREE.CanvasTexture {
      const texCanvas = document.createElement('canvas');
      texCanvas.width = 512;
      texCanvas.height = 512;
      const ctx = texCanvas.getContext('2d')!;

      // Fondo base de roca mineral
      ctx.fillStyle = '#64748b';
      ctx.fillRect(0, 0, 512, 512);

      // Estratos geológicos horizontales y vetas metamórficas
      for (let i = 0; i < 7000; i++) {
        const x = Math.random() * 512;
        const y = Math.random() * 512;
        const len = Math.random() * 16 + 4;
        ctx.fillStyle = Math.random() > 0.45 ? 'rgba(255,255,255,0.06)' : 'rgba(15,23,42,0.08)';
        ctx.fillRect(x, y, len, 1.2);
      }

      const texture = new THREE.CanvasTexture(texCanvas);
      texture.wrapS = THREE.RepeatWrapping;
      texture.wrapT = THREE.RepeatWrapping;
      texture.repeat.set(18, 110);
      return texture;
    }

    const andeanTexture = createMountainTexture();

    // 5. Generación del Terreno Andino de Alta Resolución Suavizado
    const LONGITUD_TOTAL = 3800;
    const ANCHO_CORREDOR = 580;
    // Mayor densidad de teselado para eliminar facetas triangulares
    const SEG_X = 160;
    const SEG_Z = 480;

    const terrainGeo = new THREE.PlaneGeometry(ANCHO_CORREDOR, LONGITUD_TOTAL, SEG_X, SEG_Z);
    terrainGeo.rotateX(-Math.PI / 2);

    const posAttr = terrainGeo.attributes.position;

    // Función armónica multiescala para esculpir cordilleras naturales
    function getElevation(x: number, z: number): number {
      // Cordillera principal orientada a la derecha del corredor (X entre 30 y 160)
      const distEjeCordillera = Math.abs(x - 90);
      const factorCordillera = Math.max(0, 1.0 - Math.pow(distEjeCordillera / 140, 2.0));

      // 1. Relieve geológico de base (macizos y valles glaciares U-shape)
      let h = Math.sin(x * 0.015 + 0.5) * Math.cos(z * 0.012) * 26;
      h += Math.sin(x * 0.038 + z * 0.02) * 16;
      h += Math.sin(x * 0.08 - z * 0.05) * 8;
      h += Math.cos(x * 0.16 + 1.2) * Math.sin(z * 0.11) * 3.5;

      let elevation = 14 + factorCordillera * 56 + h;

      // 2. Modelar cumbres individuales del RAG con crestas afiladas suaves (arêtes)
      for (const n of NEVADOS_RAG) {
        const dx = x - n.pos.x;
        const dz = z - n.pos.z;
        const dist = Math.sqrt(dx * dx + dz * dz);
        const radio = 85;
        if (dist < radio) {
          const t = 1.0 - dist / radio;
          // Perfil acanalado glaciar suave pero imponente
          const formaPico = Math.pow(t, 2.1) + Math.sin(t * Math.PI) * 0.18;
          elevation += formaPico * (n.pos.y - 42);
        }
      }

      return Math.max(2, elevation);
    }

    // Aplicar elevaciones calculadas a cada vértice
    for (let i = 0; i < posAttr.count; i++) {
      const x = posAttr.getX(i);
      const z = posAttr.getZ(i);
      posAttr.setY(i, getElevation(x, z));
    }

    // Calcular normales suaves de los vértices (SIN flatShading)
    terrainGeo.computeVertexNormals();

    // 6. Sombreado y Coloración Natural Dependiente de la Pendiente y Cota
    const normalAttr = terrainGeo.attributes.normal;
    const colors: number[] = [];

    const cValleOscuro = new THREE.Color('#111827');
    const cRocaBasalto = new THREE.Color('#252f3f');
    const cTaludGris = new THREE.Color('#4b5563');
    const cMorrenaPardo = new THREE.Color('#64748b');
    const cHieloTurquesa = new THREE.Color('#38bdf8');
    const cNieveAlpina = new THREE.Color('#f8fafc');

    for (let i = 0; i < posAttr.count; i++) {
      const y = posAttr.getY(i);
      const ny = normalAttr.getY(i); // Inclinación: ny cercano a 1 = plano; ny bajo = pared vertical

      const col = new THREE.Color();

      // En la naturaleza, la nieve se acumula en pendientes suaves y cumbres altas,
      // mientras que las paredes verticales escarpadas dejan ver la roca desnuda.
      if (y < 30) {
        // Valle basal
        col.copy(cValleOscuro).lerp(cRocaBasalto, y / 30);
      } else if (y < 68) {
        // Ladera media de roca y talud
        if (ny < 0.65) {
          col.copy(cRocaBasalto); // Pared de roca expuesta
        } else {
          col.copy(cTaludGris).lerp(cMorrenaPardo, (y - 30) / 38);
        }
      } else {
        // Cumbres glaciadas superiores (> 68 m)
        if (ny < 0.58) {
          // Pared vertical: roca con hielo incrustado
          col.copy(cRocaBasalto).lerp(cHieloTurquesa, 0.35);
        } else if (ny < 0.78) {
          // Pendiente media: firn y seracs turquesas
          col.copy(cHieloTurquesa).lerp(cNieveAlpina, (ny - 0.58) / 0.2);
        } else {
          // Cresta / cumbre suave: manto de nieve blanca pura
          col.copy(cNieveAlpina);
        }
      }

      // Oclusión ambiental sutil: oscurecer depresiones y valles para mayor profundidad
      const aoFactor = Math.min(1.0, Math.max(0.35, Math.pow(y / 75, 0.45)));
      col.multiplyScalar(aoFactor);

      colors.push(col.r, col.g, col.b);
    }

    terrainGeo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));

    // Material con sombreado suave natural (flatShading: false) y microtextura
    const terrainMat = new THREE.MeshStandardMaterial({
      vertexColors: true,
      map: andeanTexture,
      roughness: 0.82,
      metalness: 0.08,
      flatShading: false // Elimina el aspecto low-poly
    });

    const terrainMesh = new THREE.Mesh(terrainGeo, terrainMat);
    terrainMesh.position.set(0, 0, -LONGITUD_TOTAL / 2);
    scene.add(terrainMesh);

    // Malla gemela para encadenar el bucle infinito
    const terrainMesh2 = terrainMesh.clone();
    terrainMesh2.position.set(0, 0, -LONGITUD_TOTAL / 2 - LONGITUD_TOTAL);
    scene.add(terrainMesh2);

    // 7. Cinemática de Vuelo de la Aeronave (Avance Continuo hacia el Norte)
    const ALTURA_CRUCERO = 78;
    const VELOCIDAD_AVION = 38; // unidades por segundo
    let posCamZ = 0;
    const clock = new THREE.Clock();

    function resize() {
      if (!canvas) return;
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (canvas.width !== w || canvas.height !== h) {
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }
    }

    // 8. Ciclo de Animación a 60 FPS (Completamente Desacoplado del Scroll)
    function animate() {
      requestAnimationFrame(animate);
      resize();

      const delta = Math.min(clock.getDelta(), 0.1);
      
      // Avance en el eje Z hacia el Norte
      posCamZ -= VELOCIDAD_AVION * delta;

      // Trayectoria de vuelo: alineada con el sector derecho
      // La cámara vuela a X ≈ 25 y mira hacia X ≈ 65 para encuadrar la cordillera en el centro-derecha
      const swayX = Math.sin(posCamZ * 0.0025) * 8;
      const swayY = Math.cos(posCamZ * 0.0035) * 3;
      
      const camX = 25 + swayX;
      const camY = ALTURA_CRUCERO + swayY;
      camera.position.set(camX, camY, posCamZ);

      // Mirar hacia adelante y ligeramente hacia la derecha (hacia el corazón de los picos)
      camera.lookAt(camX + 38, camY - 10, posCamZ - 190);

      // Reinicio del bucle infinito continuo
      if (posCamZ < -LONGITUD_TOTAL) {
        posCamZ += LONGITUD_TOTAL;
      }

      // 9. Proyección Matemática y Control de Visibilidad de Etiquetas
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      const esDesktop = window.innerWidth >= 1024;
      
      // Límite de exclusión estricto: ninguna etiqueta puede entrar a la zona del degradado blanco
      const minScreenX = esDesktop ? w * 0.46 : w * 0.06;

      for (const item of etiquetasDOM) {
        const peakPos = item.data.pos.clone();
        const distZ = camera.position.z - peakPos.z;

        // Montañas visibles en aproximación frontal
        if (distZ > 15 && distZ < 640) {
          const proj = peakPos.clone().project(camera);

          // Verificar si está dentro del campo visual
          if (proj.z < 1.0 && proj.x >= -1.2 && proj.x <= 1.2 && proj.y >= -1.2 && proj.y <= 1.2) {
            const screenX = (proj.x * 0.5 + 0.5) * w;
            const screenY = (-proj.y * 0.5 + 0.5) * h;

            // Restricción: Si la etiqueta se encuentra a la izquierda del degradado, se oculta
            if (screenX > minScreenX && screenX < w - 25 && screenY > 35 && screenY < h - 35) {
              
              // Cálculo de opacidad gradual según distancia y cercanía al degradado
              let opac = 1.0;
              if (distZ > 420) {
                opac = (640 - distZ) / 220; // Aparece suave en el horizonte
              } else if (distZ < 80) {
                opac = (distZ - 15) / 65; // Se desvanece al quedar atrás
              }

              // Suavizar la entrada cerca del borde del degradado blanco
              if (esDesktop && screenX < w * 0.54) {
                opac *= (screenX - minScreenX) / (w * 0.08);
              }

              item.dom.style.transform = `translate3d(${screenX}px, ${screenY}px, 0) translate(-50%, -100%)`;
              item.dom.style.opacity = String(Math.max(0, Math.min(1, opac)));

              // Actualizar telemetría HUD si es el nevado más próximo
              if (distZ > 70 && distZ < 280 && hudTelemetria) {
                hudTelemetria.textContent = `Aproximación: ${item.data.nombre} (${item.data.cota})`;
              }
            } else {
              item.dom.style.opacity = '0';
            }
          } else {
            item.dom.style.opacity = '0';
          }
        } else {
          item.dom.style.opacity = '0';
        }
      }

      renderer.render(scene, camera);
    }

    // Iniciar el sobrevuelo
    animate();

    // Redimensionamiento responsive
    window.addEventListener('resize', resize);
  }

  // Buscador sugerencias
  const searchInput = document.getElementById('hero-search-input') as HTMLInputElement | null;
  const sugerencias = document.querySelectorAll('.btn-sugerencia');
  sugerencias.forEach(btn => {
    btn.addEventListener('click', () => {
      if (searchInput && btn.textContent) {
        searchInput.value = btn.textContent.trim();
        window.location.hash = 'buscar';
      }
    });
  });
</script>
