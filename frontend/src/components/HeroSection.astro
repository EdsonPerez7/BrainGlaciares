---
import SearchBox from './SearchBox.astro';
import { SITE_CONFIG } from '../config/site.config';
---

<section id="inicio" class="relative isolate overflow-hidden bg-noche-950 text-white min-h-[640px] sm:min-h-[660px] lg:min-h-[740px] xl:min-h-[820px] flex flex-col justify-between" data-contexto="portada">
  <!-- Capa 1: póster ilustrado andino (aparece al instante, 0ms de retardo visual) -->
  <img src="/marca/cordillera-noche.svg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover select-none pointer-events-none" fetchpriority="high" />

  <!-- Capa 2: Lienzo WebGL Three.js a pantalla completa (Sobrevuelo continuo de la Cordillera de los Andes) -->
  <canvas id="canvas-sobrevuelo-andes" class="absolute inset-0 w-full h-full block opacity-0 transition-opacity duration-1000 select-none"></canvas>
  
  <!-- Capa de Etiquetas Cartográficas Proyectadas en 3D sobre los nevados -->
  <div id="contenedor-etiquetas-3d" class="pointer-events-none absolute inset-0 z-10 overflow-hidden select-none"></div>

  <!-- Capa 3: trama tejida andina + degradado protector de legibilidad -->
  <div class="trama-andina pointer-events-none absolute inset-0 z-10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-r from-noche-950/90 via-noche-950/45 to-transparent" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-36 bg-gradient-to-t from-noche-950/85 to-transparent" aria-hidden="true"></div>

  <div class="relative z-20 mx-auto flex w-full flex-1 flex-col justify-start sm:justify-between px-3.5 pb-4 pt-2.5 sm:px-8 sm:pb-10 sm:pt-6 lg:px-12 xl:px-16 2xl:px-20">
    <!-- Barra superior: visible en tablets y computadoras, oculta en móvil para dar protagonismo al 3D -->
    <div class="hidden sm:flex flex-wrap items-center justify-between gap-3">
      <!-- HUD de telemetría de vuelo Three.js -->
      <div id="hud-vuelo-container" class="cristal !rounded-2xl flex items-center gap-3 px-3.5 py-2 text-xs">
        <span class="flex items-center gap-1.5 font-mono text-[11px] text-emerald-400 font-semibold tracking-wider">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          SOBREVUELO 3D
        </span>
        <div class="h-3 w-px bg-white/20"></div>
        <span id="hud-telemetria-vuelo" class="font-mono text-xs text-sky-200 font-semibold">
          Rumbo 355° N · Cordillera de los Andes
        </span>
        <div class="h-3 w-px bg-white/20"></div>
        <span class="font-mono text-[11px] text-slate-300">
          Cota: <b class="text-emerald-400 font-bold">6,100 m</b>
        </span>
      </div>

      <!-- Controles de cabecera derecha: Botón 3D Activo y Hora local de Huaraz -->
      <div class="ml-auto flex items-center gap-2.5">
        <button
          id="btn-ver-3d"
          type="button"
          class="cristal !rounded-2xl flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-emerald-300 border border-emerald-500/40 transition hover:bg-white/10"
          aria-label="Estado del visor 3D"
        >
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="btn-ver-3d-texto">3D Activo</span>
        </button>

        <div class="cristal !rounded-2xl flex items-center gap-2.5 px-3.5 py-2 text-xs sm:text-sm">
          <span id="hora-local" class="font-mono font-medium text-hielo-300 tabular">--:--</span>
          <span class="text-slate-200">Cordillera Blanca</span>
          <span id="fase-luz" class="hidden sm:inline text-slate-400">· luz de ahora</span>
        </div>
      </div>
    </div>

    <!-- Contenido principal: en móvil se ancla arriba (mt-1 mb-auto) para despejar el 3D inferior; en escritorio se centra -->
    <div class="mt-1 mb-auto sm:my-auto grid items-center gap-6 py-1 sm:py-8 lg:grid-cols-[minmax(0,620px)_1fr]">
      <!-- Tarjeta principal de cristal (Cockpit interactivo optimizado para móvil) -->
      <div class="cristal p-3.5 sm:p-9 max-w-2xl">
        <span class="etiqueta text-[10px] sm:text-xs py-0.5 px-2.5 sm:py-1 sm:px-3 border border-white/20 bg-white/10 text-slate-100">
          <span class="h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full bg-hielo-300"></span>
          {SITE_CONFIG.corpus.documentos_totales} informes oficiales
        </span>
        <h1 class="mt-2 sm:mt-5 text-2xl sm:text-5xl xl:text-6xl font-bold leading-tight sm:leading-[1.02]">
          ¿Hay riesgo<br class="hidden sm:inline" /> donde vives?
        </h1>
        <p class="hidden sm:block mt-4 max-w-lg text-sm sm:text-lg leading-relaxed text-slate-200">
          Escribe tu pueblo o una laguna. Te mostramos qué hay aguas arriba y qué dicen los informes oficiales.
        </p>
        <div class="mt-2.5 sm:mt-6">
          <SearchBox inputId="hero-search-input" theme="dark" mode="navigate" maxWidthClass="max-w-full" placeholder="Buscar pueblo o laguna…" />
        </div>
        <div class="hidden sm:flex mt-4 flex-wrap items-center gap-2 text-sm">
          <span class="text-slate-400">Prueba:</span>
          {[['Huaraz', '/buscar?q=Huaraz'], ['Laguna 513', '/buscar?id=513'], ['Parón', '/buscar?id=paron'], ['Cusco', '/buscar?dept=cusco']].map(([t, h]) => (
            <a href={h} class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 text-slate-100 transition hover:bg-white/20">{t}</a>
          ))}
        </div>
      </div>

      <!-- Lado derecho completamente abierto para contemplar el vuelo 3D y las etiquetas cartográficas -->
      <div class="hidden lg:block pointer-events-none"></div>
    </div>

    <!-- Espacio inferior amplio en móvil para que las cumbres nevadas y lagunas se vean centradas -->
    <div class="h-28 sm:h-4"></div>
  </div>

  <div class="franja-tejida relative z-20" aria-hidden="true"></div>
</section>

<script>
  import { faseDeLuz } from '../scripts/hero3d';

  const $ = (id: string) => document.getElementById(id);
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- Hora local de Huaraz y Luz de la Cordillera ----------
  const fase = faseDeLuz();
  const textoFase = { dia: '· luz de día', 'hora-azul': '· hora azul', noche: '· de noche' }[fase];
  function pintarHora() {
    const hora = new Intl.DateTimeFormat('es-PE', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Lima' }).format(new Date());
    const el = $('hora-local'); if (el) el.textContent = hora;
  }
  pintarHora(); setInterval(pintarHora, 30000);
  const fl = $('fase-luz'); if (fl) fl.textContent = textoFase;

  // ---------- CARGA DIFERIDA (LAZY LOADING) DE THREE.JS ----------
  let engineInstance: any = null;
  const canvas = $('canvas-sobrevuelo-andes') as HTMLCanvasElement | null;
  const btn3d = $('btn-ver-3d') as HTMLButtonElement | null;
  const txt3d = $('btn-ver-3d-texto');

  async function iniciarThree3D() {
    if (engineInstance || !canvas || reducido) return;
    if (txt3d) txt3d.textContent = 'Iniciando 3D…';

    try {
      const hudTelemetria = $('hud-telemetria-vuelo') as HTMLSpanElement | null;
      const containerEtiquetas = $('contenedor-etiquetas-3d') as HTMLElement | null;
      const heroSection = canvas.closest('section') as HTMLElement | null;

      // Importación dinámica: Three.js y sus matemáticas se descargan en segundo plano
      const { initMountainEngine } = await import('./mountainEngine/main');
      engineInstance = initMountainEngine(canvas, hudTelemetria, heroSection, undefined, containerEtiquetas);

      // Transición visual suave (fade-in) una vez montado
      requestAnimationFrame(() => {
        canvas.classList.remove('opacity-0');
        canvas.classList.add('opacity-100');
        if (txt3d) txt3d.textContent = '3D Activo';
        if (btn3d) {
          btn3d.classList.add('text-emerald-300', 'border-emerald-500/40');
          btn3d.title = 'Sobrevuelo 3D procedural en ejecución a 60 fps';
        }
      });
    } catch (err) {
      console.warn('[ARQEN] Three.js visual fallback activo (2D):', err);
      if (txt3d) txt3d.textContent = '3D en Pausa';
    }
  }

  // Inicialización automática diferida (tanto en móvil como en escritorio)
  // Permite que la tarjeta y el campo de búsqueda se pinten de inmediato sin congelar la UI
  const conexion = (navigator as any).connection;
  if (!reducido && !conexion?.saveData) {
    const cuandoLibre = (window as any).requestIdleCallback || ((f: () => void) => setTimeout(f, 250));
    cuandoLibre(() => iniciarThree3D());
  }

  // Interacción explícita por si el usuario pulsa el botón antes de la carga diferida
  btn3d?.addEventListener('click', () => {
    if (!engineInstance) {
      iniciarThree3D();
    }
  });
</script>
