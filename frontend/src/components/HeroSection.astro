---
// HeroSection.astro: Recorrido Frontal en Perspectiva (Carretera y Quebrada Andina hacia el frente)
// Simulación continua de avance por la cordillera con desniveles, altitudes y cumbres glaciares
---

<section class="relative overflow-hidden border-b border-slate-200 bg-[#060c18] w-full min-h-[580px] lg:min-h-[640px] xl:min-h-[680px] flex items-center">
  
  <!-- ======================================================== -->
  <!-- LIENZO EN PERSPECTIVA FRONTAL (AVANCE HACIA ADELANTE)     -->
  <!-- ======================================================== -->
  <div class="absolute inset-0 w-full h-full overflow-hidden select-none pointer-events-none">
    
    <!-- Cielo andino profundo con atardecer/anochecer astronómico -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#030612] via-[#091226] to-[#14203a]"></div>

    <!-- Puntos de estrellas fijas en el cenit -->
    <svg class="absolute inset-0 w-full h-full opacity-60" xmlns="http://www.w3.org/2000/svg">
      <circle cx="20%" cy="10%" r="1" fill="#ffffff" />
      <circle cx="35%" cy="18%" r="1.5" fill="#bae6fd" />
      <circle cx="50%" cy="8%" r="1" fill="#ffffff" />
      <circle cx="68%" cy="14%" r="1.8" fill="#e0f2fe" />
      <circle cx="82%" cy="12%" r="1.2" fill="#ffffff" />
      <circle cx="92%" cy="20%" r="1.5" fill="#bae6fd" />
      <circle cx="75%" cy="26%" r="1" fill="#ffffff" />
      <circle cx="88%" cy="32%" r="1.3" fill="#bae6fd" />
    </svg>

    <!-- ESCENARIO SVG EN PERSPECTIVA FRONTAL (1400 x 680) -->
    <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1400 680" preserveAspectRatio="xMidYMid slice">
      <defs>
        <!-- Gradientes de Montañas en Profundidad -->
        <linearGradient id="pico-fondo-luz" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#475569" />
          <stop offset="50%" stop-color="#334155" />
          <stop offset="100%" stop-color="#1e293b" />
        </linearGradient>
        <linearGradient id="pico-fondo-sombra" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#1e293b" />
          <stop offset="60%" stop-color="#0f172a" />
          <stop offset="100%" stop-color="#020617" />
        </linearGradient>

        <linearGradient id="nieve-cumbre" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffffff" />
          <stop offset="40%" stop-color="#f0f9ff" />
          <stop offset="75%" stop-color="#bae6fd" />
          <stop offset="100%" stop-color="#38bdf8" />
        </linearGradient>

        <!-- Asfalto y camino andino con perspectiva -->
        <linearGradient id="carretera-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#0b1322" />
          <stop offset="40%" stop-color="#131e33" />
          <stop offset="100%" stop-color="#1e2d4a" />
        </linearGradient>

        <!-- Banqueta / Borde de contención morrénica -->
        <linearGradient id="morrena-talud-l" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#0f172a" />
          <stop offset="100%" stop-color="#1e293b" />
        </linearGradient>
        <linearGradient id="morrena-talud-r" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#1e293b" />
          <stop offset="100%" stop-color="#090d16" />
        </linearGradient>

        <!-- Filtro Glow para etiquetas y líneas reflectivas -->
        <filter id="glow-road" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <!-- ======================================================== -->
      <!-- CAPA 1: COLOSO NEVADO DE FONDO (PUNTO DE FUGA)           -->
      <!-- Nevado Huascarán / Abra Portachuelo en el horizonte      -->
      <!-- ======================================================== -->
      <g id="montana-horizonte-centro" class="anim-pulso-horizonte">
        <!-- Vertientes del pico central que corona el camino -->
        <polygon points="900,110 740,360 900,360" fill="url(#pico-fondo-luz)" />
        <polygon points="900,110 900,360 1060,360" fill="url(#pico-fondo-sombra)" />
        <!-- Casquete glaciar cumbre -->
        <path d="M 900,110 L 840,195 L 870,185 L 890,215 L 900,195 L 920,220 L 940,190 L 960,200 Z" fill="url(#nieve-cumbre)" />
        <path d="M 900,110 L 900,195 L 920,220 L 940,190 L 960,200 Z" fill="#0284c7" opacity="0.35" />
        
        <!-- Cartela flotante del pico de destino -->
        <g transform="translate(805, 55)">
          <rect x="0" y="0" width="190" height="32" rx="16" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5" fill-opacity="0.9" filter="url(#glow-road)" />
          <circle cx="16" cy="16" r="3.5" fill="#38bdf8" />
          <text x="26" y="15" fill="#ffffff" font-size="11" font-weight="800" font-family="sans-serif">Nevado Huascarán</text>
          <text x="26" y="25" fill="#94a3b8" font-size="9" font-weight="600" font-family="sans-serif">6,768 m · Cordillera Blanca</text>
        </g>
      </g>

      <!-- ======================================================== -->
      <!-- CAPA 2: PAREDES LATERALES DEL CAÑÓN / DESNIVELES ROCOSOS  -->
      <!-- Flanquean la carretera a izquierda y derecha             -->
      <!-- ======================================================== -->
      <!-- Macizo Lateral Izquierdo (Pared alta del cañón) -->
      <polygon points="460,330 200,680 660,680 780,350" fill="url(#morrena-talud-l)" opacity="0.95" />
      <path d="M 460,330 L 610,220 L 780,350 Z" fill="url(#pico-fondo-luz)" />
      <path d="M 610,220 L 570,265 L 610,250 L 640,270 Z" fill="url(#nieve-cumbre)" />
      <!-- Etiqueta Flanco Izquierdo -->
      <g transform="translate(510, 175)">
        <rect x="0" y="0" width="180" height="30" rx="15" fill="#0f172a" stroke="#38bdf8" stroke-width="1.2" fill-opacity="0.9" />
        <circle cx="14" cy="15" r="3.5" fill="#38bdf8" />
        <text x="24" y="15" fill="#ffffff" font-size="10.5" font-weight="800" font-family="sans-serif">Pared Glaciar Huandoy</text>
        <text x="24" y="24" fill="#94a3b8" font-size="8.5" font-weight="600" font-family="sans-serif">6,395 m · Cañón de Llanganuco</text>
      </g>

      <!-- Macizo Lateral Derecho (Paredes rocosas de avance) -->
      <polygon points="1020,350 1140,680 1400,680 1340,330" fill="url(#morrena-talud-r)" opacity="0.95" />
      <path d="M 1020,350 L 1180,210 L 1340,330 Z" fill="url(#pico-fondo-sombra)" />
      <path d="M 1180,210 L 1140,260 L 1180,245 L 1220,265 Z" fill="url(#nieve-cumbre)" />
      <!-- Etiqueta Flanco Derecho -->
      <g transform="translate(1090, 165)">
        <rect x="0" y="0" width="180" height="30" rx="15" fill="#0f172a" stroke="#10b981" stroke-width="1.2" fill-opacity="0.9" />
        <circle cx="14" cy="15" r="3.5" fill="#10b981" />
        <text x="24" y="15" fill="#ffffff" font-size="10.5" font-weight="800" font-family="sans-serif">Macizo Chopicalqui</text>
        <text x="24" y="24" fill="#34d399" font-size="8.5" font-weight="600" font-family="sans-serif">6,354 m · Paso Portachuelo</text>
      </g>

      <!-- ======================================================== -->
      <!-- CAPA 3: LA CARRETERA ANDINA Y AVANCE HACIA EL FRENTE      -->
      <!-- Converge en el punto de fuga (900, 350) y se ensancha    -->
      <!-- ======================================================== -->
      <!-- Superficie de la calzada -->
      <polygon points="892,348 908,348 1160,680 660,680" fill="url(#carretera-grad)" />

      <!-- Bordes / Bermas de la carretera con perspectiva -->
      <line x1="892" y1="348" x2="660" y2="680" stroke="#f59e0b" stroke-width="3.5" opacity="0.8" />
      <line x1="908" y1="348" x2="1160" y2="680" stroke="#f59e0b" stroke-width="3.5" opacity="0.8" />

      <!-- Guías de curvas de nivel / franjas laterales de avance (animadas) -->
      <g class="anim-franjas-camino">
        <!-- Línea central discontinua acelerada hacia el frente -->
        <line x1="900" y1="348" x2="910" y2="680" stroke="#ffffff" stroke-width="5" stroke-linecap="round" class="linea-eje-carretera" />
      </g>

      <!-- Postes / Balizas reflectivas andinas a los lados de la carretera -->
      <g class="anim-balizas-avance">
        <!-- Balizas lado izquierdo -->
        <circle cx="875" cy="375" r="2" fill="#38bdf8" />
        <circle cx="845" cy="425" r="3" fill="#38bdf8" />
        <circle cx="795" cy="500" r="4.5" fill="#38bdf8" />
        <circle cx="720" cy="610" r="6" fill="#38bdf8" />

        <!-- Balizas lado derecho -->
        <circle cx="925" cy="375" r="2" fill="#38bdf8" />
        <circle cx="955" cy="425" r="3" fill="#38bdf8" />
        <circle cx="1010" cy="500" r="4.5" fill="#38bdf8" />
        <circle cx="1090" cy="610" r="6" fill="#38bdf8" />
      </g>

      <!-- Laguna turquesa visible en una curva del desfiladero -->
      <ellipse cx="780" cy="375" rx="45" ry="12" fill="#0284c7" opacity="0.8" />
      <text x="780" y="378" fill="#e0f2fe" font-size="8" font-weight="700" text-anchor="middle" font-family="sans-serif">Lag. Llanganuco</text>

    </svg>

    <!-- Indicador de Cota / Altimetría Dinámica en vivo (Ascenso continuo) -->
    <div class="absolute bottom-6 right-6 z-20 flex items-center gap-3 bg-slate-950/85 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-slate-700/70 text-xs shadow-2xl">
      <div class="flex flex-col">
        <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Perfil Altimétrico en Ruta</span>
        <span id="indicador-altitud-dinamica" class="font-mono font-bold text-sky-400 text-sm">3,850 m s.n.m. · Quebrada Llanganuco</span>
      </div>
      <div class="h-8 w-px bg-slate-800"></div>
      <div class="flex items-center gap-1.5 text-emerald-400 font-mono text-xs font-semibold">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Rumbo 042° NE</span>
      </div>
    </div>

  </div>

  <!-- ======================================================== -->
  <!-- MÁSCARA GRADUAL DE DIFUMINADO (BLANCO A ALTA MONTAÑA)     -->
  <!-- ======================================================== -->
  <div class="absolute inset-y-0 left-0 w-full lg:w-[65%] xl:w-[58%] 2xl:w-[52%] bg-gradient-to-r from-white via-white via-70% to-transparent pointer-events-none z-10 hidden lg:block"></div>
  <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-white via-white/90 to-transparent pointer-events-none z-10 lg:hidden"></div>

  <!-- ======================================================== -->
  <!-- CONTENIDO FRONTAL (IZQUIERDA): PREGUNTA Y BUSCADOR        -->
  <!-- En fondo blanco puro, sobrio, institucional y limpio     -->
  <!-- ======================================================== -->
  <div class="relative z-20 w-full px-4 sm:px-8 lg:px-12 xl:px-16 2xl:px-20 py-8 lg:py-16">
    <div class="max-w-xl xl:max-w-2xl bg-white/95 lg:bg-transparent p-6 sm:p-8 lg:p-0 rounded-3xl lg:rounded-none shadow-xl lg:shadow-none border border-slate-200/80 lg:border-none backdrop-blur-md lg:backdrop-blur-none space-y-6">
      
      <!-- Pastilla Institucional -->
      <div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 text-xs text-slate-700 shadow-xs">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-semibold text-slate-900">398 Informes oficiales digitalizados</span>
        <span class="text-slate-300">|</span>
        <span>Evidencia con trazabilidad científica</span>
      </div>

      <!-- Título de impacto -->
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl 2xl:text-6xl font-black tracking-tight text-slate-950 leading-[1.12]">
          ¿Hay riesgo donde vives?
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl">
          Escribe tu pueblo, departamento o una laguna: te mostramos qué glaciares hay aguas arriba, qué desniveles existen y de qué informe técnico oficial proviene cada evidencia.
        </p>
      </div>

      <!-- Buscador Institucional con Icono -->
      <div class="space-y-3">
        <div class="relative max-w-lg">
          <input 
            id="hero-search-input"
            type="text" 
            placeholder="Escribe tu pueblo, departamento o una laguna..." 
            class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 pl-11 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-slate-950 focus:outline-none focus:ring-2 focus:ring-slate-950/10 transition"
          />
          <svg class="absolute left-3.5 top-4 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Consultas rápidas recomendadas -->
        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
          <span class="font-medium text-slate-400">O prueba con:</span>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-2xs">Huaraz</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-2xs">Laguna 513</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-2xs">Parón</button>
          <button type="button" class="btn-sugerencia rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:bg-slate-100 transition shadow-2xs">Cusco</button>
        </div>
      </div>

      <!-- Enlace directo al simulador de cuencas -->
      <div class="pt-2 flex items-center gap-3">
        <a 
          href="#simulador-cordillera" 
          class="inline-flex items-center gap-2 text-xs font-bold text-slate-800 hover:text-sky-600 bg-slate-100 hover:bg-slate-200/80 px-3.5 py-2 rounded-xl transition border border-slate-200 shadow-2xs"
        >
          <span>Ver anatomía de un aluvión en 5 escenas</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
        </a>
      </div>

    </div>
  </div>

</section>

<!-- ======================================================== -->
<!-- ESTILOS Y ANIMACIONES CSS DE PERSPECTIVA HACIA EL FRENTE -->
<!-- ======================================================== -->
<style>
  /* Línea central de la carretera: simula velocidad continua hacia adelante */
  .linea-eje-carretera {
    stroke-dasharray: 24 36;
    animation: avanzarCarretera 0.75s linear infinite;
  }

  @keyframes avanzarCarretera {
    0% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -60;
    }
  }

  /* Balizas reflectivas que aumentan de escala y avanzan */
  @keyframes pulsoHorizonte {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.02);
    }
  }

  .anim-pulso-horizonte {
    transform-origin: 900px 350px;
    animation: pulsoHorizonte 8s ease-in-out infinite;
  }
</style>

<script>
  // Altimetría dinámica simulando el avance por la cordillera
  const altitudEl = document.getElementById('indicador-altitud-dinamica');
  const cotasRuta = [
    { cota: "3,050 m s.n.m.", hito: "Valle del Callejón de Huaylas" },
    { cota: "3,420 m s.n.m.", hito: "Inicio Quebrada de Llanganuco" },
    { cota: "3,850 m s.n.m.", hito: "Laguna Chinancocha" },
    { cota: "4,210 m s.n.m.", hito: "Curva de los Seracs de Huandoy" },
    { cota: "4,767 m s.n.m.", hito: "Paso Abra Portachuelo" },
  ];

  let rutaIdx = 0;
  setInterval(() => {
    rutaIdx = (rutaIdx + 1) % cotasRuta.length;
    if (altitudEl) {
      altitudEl.style.opacity = '0';
      setTimeout(() => {
        altitudEl.textContent = `${cotasRuta[rutaIdx].cota} · ${cotasRuta[rutaIdx].hito}`;
        altitudEl.style.opacity = '1';
      }, 200);
    }
  }, 4500);

  // Buscador sugerencias
  const searchInput = document.getElementById('hero-search-input') as HTMLInputElement | null;
  const sugerencias = document.querySelectorAll('.btn-sugerencia');
  sugerencias.forEach(btn => {
    btn.addEventListener('click', () => {
      if (searchInput && btn.textContent) {
        searchInput.value = btn.textContent.trim();
        window.location.hash = 'buscar';
      }
    });
  });
</script>
