    // Helper para mantener coordenadas Z dentro del ciclo periódico
    function wrapZ(z: number, length: number): number {
      const m = z % length;
      return m <= 0 ? m : m - length;
    }

    // 4. Función de Elevación Continua y Fotorrealista del Terreno
    function getTerrainElevation(worldX: number, worldZ: number): number {
      const cycleZ = wrapZ(worldZ, LONGITUD_TOTAL);

      // Valle central y relieve base
      const distValle = Math.abs(worldX - 5);
      const factorFlancos = Math.min(1.0, Math.pow(distValle / 75, 1.3));

      // Armónicos ridged multifractal para crestas afiladas reales
      const r1 = 1.0 - Math.abs(Math.sin(worldX * 0.018 + cycleZ * 0.009));
      const r2 = 1.0 - Math.abs(Math.sin(worldX * 0.038 - cycleZ * 0.016 + 0.5));
      const r3 = 1.0 - Math.abs(Math.cos(worldX * 0.075 + cycleZ * 0.035));
      const r4 = 1.0 - Math.abs(Math.sin(worldX * 0.15 - cycleZ * 0.08));

      // Relieve base de valles y cordones secundarios (entre 18 y 58 de altura)
      const aristas = Math.pow(r1, 2.0) * 22 + Math.pow(r2, 1.6) * 14 + r3 * 7 + r4 * 3;
      let elevation = 16 + factorFlancos * 26 + aristas;

      // Colosos Emblemáticos del RAG con crestas piramidales y aristas dominantes
      for (const n of NEVADOS_RAG) {
        const dx = worldX - n.x;
        const dz = cycleZ - n.z;
        const distSq = dx * dx + dz * dz;
        const rSq = n.radio * n.radio;

        if (distSq < rSq) {
          const dist = Math.sqrt(distSq);
          const u = 1.0 - dist / n.radio;
          const angle = Math.atan2(dz, dx);

          let crestFactor = 1.0;
          if (n.perfil === 'pyramid') {
            // Pirámide con 4 aristas afiladas (como Alpamayo y Artesonraju)
            const ridges = Math.pow(Math.abs(Math.cos(angle * 2)), 1.5);
            crestFactor = 0.72 + 0.38 * ridges;
          } else if (n.perfil === 'massive') {
            // Macizo imponente con arista principal (como Huascarán, Yerupajá, Ausangate)
            const ridges = Math.pow(Math.abs(Math.cos(angle * 1.5 + 0.4)), 1.3);
            crestFactor = 0.78 + 0.32 * ridges;
          } else if (n.perfil === 'ridge') {
            // Cresta afilada longitudinal
            const ridges = Math.pow(Math.abs(Math.sin(angle)), 1.6);
            crestFactor = 0.75 + 0.35 * ridges;
          } else {
            // Casquete/domo glaciar
            crestFactor = 1.0;
          }

          const shape = Math.pow(u, 1.6) * crestFactor;
          const boost = (n.altura - elevation) * shape;
          if (boost > 0) {
            elevation += boost;
          }
        }
      }

      return Math.max(6, elevation);
    }

    // 5. Balizas 3D en la Cumbre de cada Nevado
    const beaconsGroup = new THREE.Group();
    scene.add(beaconsGroup);

    const beaconsMeshList = NEVADOS_RAG.map(n => {
      const bGroup = new THREE.Group();

      // Esfera luminosa de cumbre
      const orbGeo = new THREE.SphereGeometry(1.6, 16, 16);
      const orbMat = new THREE.MeshBasicMaterial({ color: n.colorPunto });
      const orbMesh = new THREE.Mesh(orbGeo, orbMat);
      bGroup.add(orbMesh);

      // Anillo halo horizontal de telemetría
      const ringGeo = new THREE.RingGeometry(1.8, 2.7, 32);
      ringGeo.rotateX(-Math.PI / 2);
      const ringMat = new THREE.MeshBasicMaterial({
        color: n.colorPunto,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.85
      });
      const ringMesh = new THREE.Mesh(ringGeo, ringMat);
      bGroup.add(ringMesh);

      // Destello láser vertical tenue que corona la cumbre
      const beamGeo = new THREE.CylinderGeometry(0.08, 0.35, 14, 8);
      beamGeo.translate(0, 7, 0);
      const beamMat = new THREE.MeshBasicMaterial({
        color: '#ffffff',
        transparent: true,
        opacity: 0.45
      });
      const beamMesh = new THREE.Mesh(beamGeo, beamMat);
      bGroup.add(beamMesh);

      beaconsGroup.add(bGroup);
      return { data: n, group: bGroup, ring: ringMesh };
    });

    // 6. Elementos DOM para Etiquetas de Cumbres con Anclaje 1:1 y Badge Semántico
    const etiquetasDOM = NEVADOS_RAG.map((n, idx) => {
      const el = document.createElement('div');
      el.className = 'absolute top-0 left-0 transition-opacity duration-300 flex flex-col items-center pointer-events-none opacity-0 select-none';
      el.innerHTML = `
        <div class="flex flex-col items-center">
          <!-- Tarjeta HUD de telemetría cartográfica con clasificación científica -->
          <div class="bg-slate-950/90 border border-white/20 rounded-2xl px-3.5 py-2 shadow-[0_12px_36px_rgba(0,0,0,0.65)] backdrop-blur-md flex flex-col items-center text-center ring-1 ring-white/10 min-w-[160px]">
            <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[8px] font-mono font-bold uppercase border ${n.badgeBg} mb-1">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: ${n.colorPunto}"></span>
              <span>${n.tipoLabel}</span>
            </div>
            <div class="flex items-center gap-1.5 mb-0.5">
              <svg class="w-3 h-3 text-sky-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L1 21h22L12 2zm0 4.5l6.5 11.5h-13L12 6.5z"/>
              </svg>
              <span class="text-[10px] tracking-wider font-black text-white uppercase">${n.nombre}</span>
            </div>
            <span class="text-[13px] font-mono font-black text-sky-300 leading-tight">${n.cota}</span>
            <span class="text-[9px] text-slate-300 font-medium">${n.cordillera}</span>
          </div>
          <!-- Pin vertical indicador conectado al punto de cumbre -->
          <div class="w-[1.5px] h-7 bg-gradient-to-b from-sky-300 to-sky-400 shadow-[0_0_8px_#38bdf8]"></div>
          <!-- Punto de anclaje de cumbre en pantalla -->
          <div class="relative flex items-center justify-center">
            <span class="absolute w-4 h-4 rounded-full border border-sky-300 animate-ping opacity-60"></span>
            <span class="w-2.5 h-2.5 rounded-full" style="background-color: ${n.colorPunto}; box-shadow: 0 0 12px ${n.colorPunto};"></span>
          </div>
        </div>
      `;
      containerEtiquetas.appendChild(el);
      return { data: n, dom: el, beacon: beaconsMeshList[idx] };
    });

    // 7. Textura Procedural de Roca Andina y Estrías Metamórficas
    function createAlpineTexture(): THREE.CanvasTexture {
      const texCanvas = document.createElement('canvas');
      texCanvas.width = 1024;
      texCanvas.height = 1024;
      const ctx = texCanvas.getContext('2d')!;

      // Base mineral de roca andina
      ctx.fillStyle = '#443e39';
      ctx.fillRect(0, 0, 1024, 1024);

      // Estrías y canales de erosión vertical
      for (let i = 0; i < 20000; i++) {
        const x = Math.random() * 1024;
        const y = Math.random() * 1024;
        const w = Math.random() * 2.5 + 1;
        const h = Math.random() * 26 + 6;
        ctx.fillStyle = Math.random() > 0.45 ? 'rgba(240,248,255,0.08)' : 'rgba(25,20,16,0.12)';
        ctx.fillRect(x, y, w, h);
      }

      const texture = new THREE.CanvasTexture(texCanvas);
      texture.wrapS = THREE.RepeatWrapping;
      texture.wrapT = THREE.RepeatWrapping;
      texture.repeat.set(16, 90);
      return texture;
    }

    const alpineTexture = createAlpineTexture();

    // 8. Construcción de la Geometría del Terreno (Malla Continua)
    const terrainGeo = new THREE.PlaneGeometry(ANCHO_CORREDOR, LONGITUD_TOTAL, SEG_X, SEG_Z);
    terrainGeo.rotateX(-Math.PI / 2);

    const posAttr = terrainGeo.attributes.position;

    for (let i = 0; i < posAttr.count; i++) {
      const localX = posAttr.getX(i);
      const localZ = posAttr.getZ(i);
      // En world space: terrainMesh está en Z = -LONGITUD_TOTAL / 2
      const worldZ = localZ - LONGITUD_TOTAL / 2;
      posAttr.setY(i, getTerrainElevation(localX, worldZ));
    }

    terrainGeo.computeVertexNormals();

    // 9. Coloración de Nieve y Roca según Cota y Pendiente (Fotorrealismo)
    const normalAttr = terrainGeo.attributes.normal;
    const colors: number[] = [];

    const cRocaOscura = new THREE.Color('#2d2621'); // Granito pardo/gris oscuro
    const cRocaMedia = new THREE.Color('#4a4038');  // Roca mineral cálida
    const cTaludGris = new THREE.Color('#6b635b');  // Talud de morrena
    const cHieloAzulado = new THREE.Color('#8dc8ea'); // Hielo glaciar
    const cNievePura = new THREE.Color('#fcfdff');   // Nieve blanca brillante

    for (let i = 0; i < posAttr.count; i++) {
      const y = posAttr.getY(i);
      const ny = normalAttr.getY(i);

      const col = new THREE.Color();

      if (y < 42) {
        // Fondo del valle y morrenas bajas: roca oscura y talud mineral
        const t = Math.max(0, Math.min(1, (y - 12) / 30));
        col.copy(cRocaOscura).lerp(cRocaMedia, t);
        if (ny > 0.75) {
          col.lerp(cTaludGris, 0.35);
        }
      } else if (y < 85) {
        // Zona intermedia: roca con canales de deshielo y neveros
        const tAlt = (y - 42) / 43;
        if (ny < 0.45) {
          col.copy(cRocaOscura).lerp(cRocaMedia, tAlt);
        } else if (ny < 0.68) {
          col.copy(cRocaMedia).lerp(cTaludGris, 0.7);
        } else {
          col.copy(cTaludGris).lerp(cHieloAzulado, tAlt * 0.8);
        }
      } else {
        // Alta montaña y cumbres glaciares (Y >= 85)
        const tCumbre = Math.min(1.0, (y - 85) / 50);
        if (ny < 0.32) {
          // Paredes verticales de roca expuesta
          col.copy(cRocaMedia).lerp(cTaludGris, 0.4);
        } else if (ny < 0.52) {
          // Canales mixtos de roca y hielo azul
          col.copy(cTaludGris).lerp(cHieloAzulado, tCumbre);
        } else {
          // Glaciares colosales, cornisas y cumbres: blanco resplandeciente
          const tNieve = (ny - 0.52) / 0.48;
          col.copy(cHieloAzulado).lerp(cNievePura, Math.min(1.0, tNieve * 1.25 + tCumbre * 0.35));
        }
      }

      // Oclusión ambiental sutil en quebradas profundas
      const ao = Math.min(1.0, Math.max(0.40, Math.pow(y / 60, 0.35)));
      col.multiplyScalar(ao);

      colors.push(col.r, col.g, col.b);
    }

    terrainGeo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));

    const terrainMat = new THREE.MeshStandardMaterial({
      vertexColors: true,
      map: alpineTexture,
      roughness: 0.78,
      metalness: 0.06,
      flatShading: false
    });

    const terrainMesh = new THREE.Mesh(terrainGeo, terrainMat);
    terrainMesh.position.set(0, 0, -LONGITUD_TOTAL / 2);
    scene.add(terrainMesh);

    // Malla gemela continua para vuelo infinito
    const terrainMesh2 = new THREE.Mesh(terrainGeo, terrainMat);
    terrainMesh2.position.set(0, 0, -LONGITUD_TOTAL / 2 - LONGITUD_TOTAL);
    scene.add(terrainMesh2);

    // Espejos de agua de lagunas glaciares en circos de morrena
    function createGlacialLake(x: number, y: number, z: number, w: number, h: number) {
      const lagoGeo = new THREE.PlaneGeometry(w, h);
      lagoGeo.rotateX(-Math.PI / 2);
      const lagoMat = new THREE.MeshStandardMaterial({
        color: '#13405c',
        roughness: 0.12,
        metalness: 0.88
      });
      const lake = new THREE.Mesh(lagoGeo, lagoMat);
      lake.position.set(x, y, z);
      scene.add(lake);
      return lake;
    }

    createGlacialLake(15, 17, -980, 140, 190);
    createGlacialLake(-20, 17, -3200, 160, 220);
    createGlacialLake(25, 17, -4750, 150, 200);

    // 10. Cinemática de Vuelo Aéreo con Rumbo Diagonal y Ojo Vertical Dinámico
    const ALTURA_CRUCERO = 148; // Cota de crucero base
    const VELOCIDAD_AVION = 42; // Unidades por segundo
    let posCamZ = 0;
    let currentLookY = 104; // Altura de mirada dinámica inicial (lerp suave)
    const clock = new THREE.Clock();

    function resize() {
      if (!canvas) return;
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (canvas.width !== w || canvas.height !== h) {
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }
    }

    // 11. Ciclo de Animación a 60 FPS con Seguimiento de Cumbres Altas
    function animate() {
      requestAnimationFrame(animate);
      resize();

      const delta = Math.min(clock.getDelta(), 0.1);
      posCamZ -= VELOCIDAD_AVION * delta;

      // Trayectoria con rumbo diagonal hacia arriba y hacia la derecha (Rumbo 032° NNE)
      const curvePhase = posCamZ * 0.0018;
      // Posición de la aeronave con deriva lateral derecha para abrir campo respecto al cockpit izquierdo
      const camX = 14 + Math.sin(curvePhase) * 16;
      const camY = ALTURA_CRUCERO + Math.cos(curvePhase * 1.4) * 3.5;
      camera.position.set(camX, camY, posCamZ);

      // SEGUIMIENTO DINÁMICO DE MIRADA (OJO VERTICAL Y DIAGONAL):
      // Si se aproxima un nevado prominente o coloso, elevamos la mirada para contemplar su cumbre
      // con suficiente cielo arriba, y luego la mirada vuelve a descender al horizonte
      let targetLookY = 104;
      for (const item of etiquetasDOM) {
        const n = item.data;
        let aheadZ = (n.z - (posCamZ % LONGITUD_TOTAL)) % LONGITUD_TOTAL;
        if (aheadZ > 0) aheadZ -= LONGITUD_TOTAL;
        const distZ = -aheadZ;

        // Zona de aproximación visual (entre 70 y 480 unidades de distancia)
        if (distZ > 70 && distZ < 480 && n.altura > 124) {
          const excess = n.altura - 124;
          // Curva gaussiana suave de aproximación y alejamiento
          const bellCurve = Math.sin(((distZ - 70) / 410) * Math.PI);
          const elevacionOjo = excess * 0.85 * bellCurve;
          if (elevacionOjo > (targetLookY - 104)) {
            targetLookY = 104 + elevacionOjo;
          }
        }
      }

      // Interpolación suave y orgánica de la mirada vertical (sin saltos bruscos)
      currentLookY = THREE.MathUtils.lerp(currentLookY, targetLookY, delta * 2.8);

      // Punto focal hacia adelante con vector diagonal hacia arriba a la derecha
      const lookAheadX = camX + 16 + Math.cos(curvePhase) * 8;
      camera.lookAt(lookAheadX, currentLookY, posCamZ - 260);

      // Alabeo aerodinámico natural (roll de avión en curvas suaves)
      camera.rotation.z = -Math.cos(curvePhase) * 0.035;

      // Mantener la esfera celeste acompañando la posición de la cámara
      skyMesh.position.set(camera.position.x, 0, camera.position.z);

      // Reciclaje infinito de vuelo
      if (posCamZ < -LONGITUD_TOTAL) {
        posCamZ += LONGITUD_TOTAL;
      }

      // 12. Proyección Matemática y Visibilidad de Etiquetas y Balizas
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      const cockpitCard = document.getElementById('hero-cockpit-card');
      const cockpitRect = cockpitCard ? cockpitCard.getBoundingClientRect() : null;

      let closestNevado: { nombre: string; cota: string; tipoLabel: string } | null = null;
      let minDistance = Infinity;

      for (const item of etiquetasDOM) {
        const n = item.data;

        // Calcular posición en el ciclo relativa a la aeronave
        let aheadZ = (n.z - (posCamZ % LONGITUD_TOTAL)) % LONGITUD_TOTAL;
        if (aheadZ > 0) aheadZ -= LONGITUD_TOTAL;
        const distZ = -aheadZ; // Distancia hacia adelante (positiva)

        // Posición física exacta de la cumbre en el espacio 3D
        const summitWorldPos = new THREE.Vector3(n.x, n.altura, posCamZ + aheadZ);

        // Posicionar la baliza 3D exactamente en la cumbre
        item.beacon.group.position.copy(summitWorldPos);
        item.beacon.ring.rotation.z += 0.02;

        // Rango de visibilidad óptimo (aproximación visual de 25 a 820 unidades)
        if (distZ >= 25 && distZ <= 820) {
          item.beacon.group.visible = true;

          // Proyección matemática 3D -> 2D
          const proj = summitWorldPos.clone().project(camera);

          // Verificar si está dentro del frustum de la cámara
          if (proj.z < 1.0 && proj.x >= -1.05 && proj.x <= 1.05 && proj.y >= -1.05 && proj.y <= 1.05) {
            const screenX = (proj.x * 0.5 + 0.5) * w;
            const screenY = (-proj.y * 0.5 + 0.5) * h;

            // Bounding box en pantalla
            if (screenX > 25 && screenX < w - 25 && screenY > 30 && screenY < h - 25) {
              
              // Verificar si colisiona con la tarjeta de la consola cockpit en el lado izquierdo
              let occludedByCockpit = false;
              if (cockpitRect) {
                if (
                  screenX >= cockpitRect.left - 20 &&
                  screenX <= cockpitRect.right + 20 &&
                  screenY >= cockpitRect.top - 20 &&
                  screenY <= cockpitRect.bottom + 20
                ) {
                  occludedByCockpit = true;
                }
              }

              if (occludedByCockpit) {
                item.dom.style.opacity = '0';
              } else {
                // Suavizado de opacidad por distancia de vuelo
                let opac = 1.0;
                if (distZ > 520) {
                  opac = (820 - distZ) / 300;
                } else if (distZ < 90) {
                  opac = (distZ - 25) / 65;
                }

                item.dom.style.transform = `translate3d(${screenX}px, ${screenY}px, 0) translate(-50%, -100%)`;
                item.dom.style.opacity = String(Math.max(0, Math.min(1, opac)));

                if (distZ < minDistance && distZ > 60) {
                  minDistance = distZ;
                  closestNevado = n;
                }
              }
            } else {
              item.dom.style.opacity = '0';
            }
          } else {
            item.dom.style.opacity = '0';
          }
        } else {
          item.beacon.group.visible = false;
          item.dom.style.opacity = '0';
        }
      }

      if (closestNevado && hudTelemetria && minDistance < 420) {
        hudTelemetria.textContent = `Aproximación: ${closestNevado.nombre} (${closestNevado.cota}) · ${closestNevado.tipoLabel}`;
      }

      renderer.render(scene, camera);
    }

    animate();
    window.addEventListener('resize', resize);
  }

  // Buscador sugerencias
  const searchInput = document.getElementById('hero-search-input') as HTMLInputElement | null;
  const sugerencias = document.querySelectorAll('.btn-sugerencia');
  sugerencias.forEach(btn => {
    btn.addEventListener('click', () => {
      if (searchInput && btn.textContent) {
        searchInput.value = btn.textContent.trim();
        window.location.hash = 'buscar';
      }
    });
  });
</script>
