---
import { DEPARTAMENTOS_RIESGO, LAGUNAS_DESTACADAS } from '../config/metrics.data';
import GlacierMap from './GlacierMap.astro';
---

<section id="buscar" class="border-b border-slate-200 bg-white py-14 w-full">
  <div class="w-full px-4 sm:px-8 lg:px-12 xl:px-16 2xl:px-20">
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Busca tu zona o una laguna</h2>
        <p class="text-sm text-slate-500 mt-1">Explora las lagunas de alta montaña y el nivel de riesgo por departamento</p>
      </div>

      <!-- Selector de departamento activo -->
      <div class="flex items-center gap-3">
        <label for="select-departamento" class="text-xs font-medium text-slate-600">Lugar elegido:</label>
        <select 
          id="select-departamento" 
          class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-800 shadow-sm focus:border-slate-900 focus:outline-none"
        >
          <option value="todos">Todo el Perú (19 lagunas en riesgo)</option>
          {DEPARTAMENTOS_RIESGO.map(d => (
            <option value={d.departamento.toLowerCase()}>{d.departamento} ({d.total} lagunas)</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Contenedor del Mapa y Panel de Resultados -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Lado Izquierdo: Resumen y Lista de Lugares -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Tarjeta de Información Territorial -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
          <div class="flex items-center justify-between">
            <h3 id="panel-titulo" class="font-bold text-slate-900 text-sm">Todo el Perú</h3>
            <span id="panel-badge" class="rounded-full bg-rose-100 text-rose-800 px-2.5 py-0.5 text-xs font-bold">19 lagunas críticas</span>
          </div>
          <p id="panel-descripcion" class="mt-2 text-xs text-slate-600 leading-relaxed">
            Áncash concentra la mayor cantidad de lagunas con riesgo muy alto de aluvión (9 lagunas), seguido por Huánuco (3) y Puno (2).
          </p>
          <div class="mt-3 pt-3 border-t border-slate-200 flex gap-2 text-xs">
            <span class="text-slate-500">¿Por dónde empezar?</span>
            <span class="font-medium text-slate-700">Áncash, Cusco, Huánuco</span>
          </div>
        </div>

        <!-- Lista de lagunas filtrables -->
        <div class="space-y-3">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Lagunas en la zona (clic para enfocar en mapa)</h4>
          <div id="lista-lagunas" class="space-y-2 max-h-80 overflow-y-auto pr-1">
            {LAGUNAS_DESTACADAS.map(l => (
              <div 
                class="item-laguna block rounded-lg border border-slate-200 bg-white p-3.5 hover:border-slate-400 hover:shadow-xs transition cursor-pointer"
                data-id={l.id.toLowerCase()}
                data-dept={l.departamento.toLowerCase()}
                data-lat={l.lat}
                data-lng={l.lng}
              >
                <div class="flex items-center justify-between">
                  <span class="font-bold text-slate-900 text-sm">Laguna {l.nombre}</span>
                  <span class={`rounded px-2 py-0.5 text-[10px] font-bold ${l.riesgo === 'Muy alto' ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'bg-amber-50 text-amber-700 border border-amber-200'}`}>
                    {l.riesgo}
                  </span>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-xs text-slate-500">
                  <span>{l.departamento} · Cordillera {l.cordillera}</span>
                  <span>Amenaza a: <strong class="text-slate-700">{l.poblado_amenazado}</strong></span>
                </div>
                <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
                  <span class="text-cyan-700 font-medium">Ver en mapa ↗</span>
                  <a href={`/buscar?id=${l.id}`} class="text-slate-500 hover:text-slate-900 font-semibold underline" onclick="event.stopPropagation()">Ficha técnica →</a>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- Lado Derecho: Mapa Territorial Interactivo con Leaflet -->
      <div class="lg:col-span-7">
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
          <div class="flex items-center justify-between pb-2.5 px-1 text-xs">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span>
              <span class="font-bold text-slate-800">Mapa Territorial de Lagunas en Riesgo</span>
            </div>
            <span class="text-[11px] text-slate-400">Haz clic en un punto para ver ficha técnica</span>
          </div>
          <GlacierMap mapId="home-glacier-map" heightClass="h-[440px]" mode="navigate" />
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { ApiService } from '../services/api';
  import { DEPARTAMENTOS_RIESGO, LAGUNAS_DESTACADAS } from '../config/metrics.data';

  const selectDept = document.getElementById('select-departamento') as HTMLSelectElement | null;
  const panelTitulo = document.getElementById('panel-titulo');
  const panelBadge = document.getElementById('panel-badge');
  const listaLagunasCont = document.getElementById('lista-lagunas');

  let deptosMemoria = [...DEPARTAMENTOS_RIESGO];
  let lagunasMemoria: any[] = [...LAGUNAS_DESTACADAS];

  const norm = (s: string) => (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  function renderLagunasHtml(lagunas: any[]) {
    if (!listaLagunasCont) return;
    if (lagunas.length === 0) {
      listaLagunasCont.innerHTML = `
        <div class="p-4 text-center text-xs text-slate-400 bg-slate-50 rounded-lg border border-slate-200">
          No hay lagunas en riesgo crítico registradas en este catálogo para la zona seleccionada.
        </div>
      `;
      return;
    }

    listaLagunasCont.innerHTML = lagunas.map((l: any) => `
      <div 
        class="item-laguna block rounded-lg border border-slate-200 bg-white p-3.5 hover:border-slate-400 hover:shadow-xs transition cursor-pointer"
        data-id="${(l.id || '').toLowerCase()}"
        data-dept="${(l.departamento || '').toLowerCase()}"
        data-lat="${l.lat ?? ''}"
        data-lng="${l.lng ?? ''}"
      >
        <div class="flex items-center justify-between">
          <span class="font-bold text-slate-900 text-sm">Laguna ${l.nombre}</span>
          <span class="rounded px-2 py-0.5 text-[10px] font-bold ${l.riesgo === 'Muy alto' ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'bg-amber-50 text-amber-700 border border-amber-200'}">
            ${l.riesgo}
          </span>
        </div>
        <div class="mt-1.5 flex items-center justify-between text-xs text-slate-500">
          <span>${l.departamento} · Cordillera ${l.cordillera || 'Andina'}</span>
          <span>Amenaza a: <strong class="text-slate-700">${l.poblado_amenazado || 'Población local'}</strong></span>
        </div>
        <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
          <span class="text-cyan-700 font-medium">Ver en mapa ↗</span>
          <a href="/buscar?id=${encodeURIComponent(l.id)}" class="text-slate-500 hover:text-slate-900 font-semibold underline" onclick="event.stopPropagation()">Ficha técnica →</a>
        </div>
      </div>
    `).join('');
  }

  function filtrarPorDepartamento(dept: string) {
    const deptNorm = norm(dept);
    const filtered = (deptNorm === 'todos')
      ? lagunasMemoria
      : lagunasMemoria.filter((l: any) => norm(l.departamento) === deptNorm);

    renderLagunasHtml(filtered);

    if (panelTitulo) panelTitulo.textContent = dept === 'todos' ? 'Todo el Perú' : dept.toUpperCase();
    if (panelBadge) {
      if (deptNorm === 'todos') {
        const total = deptosMemoria.reduce((acc: number, d: any) => acc + (d.total || 0), 0);
        panelBadge.textContent = `${total} lagunas críticas`;
      } else {
        const dObj = deptosMemoria.find(d => norm(d.departamento) === deptNorm);
        if (dObj) {
          panelBadge.textContent = `${dObj.total} ${dObj.total === 1 ? 'laguna crítica' : 'lagunas críticas'}`;
        } else {
          panelBadge.textContent = '0 lagunas críticas';
        }
      }
    }

    document.dispatchEvent(new CustomEvent('bg:map-filter', { detail: { dept } }));
  }

  // Interacción al hacer clic en una tarjeta de laguna para enfocar el mapa
  listaLagunasCont?.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.item-laguna') as HTMLElement | null;
    if (!target) return;
    const id = target.dataset.id;
    const lat = target.dataset.lat ? parseFloat(target.dataset.lat) : undefined;
    const lng = target.dataset.lng ? parseFloat(target.dataset.lng) : undefined;
    const dept = target.dataset.dept || 'todos';

    document.querySelectorAll('.item-laguna').forEach(el => {
      el.classList.remove('border-cyan-500', 'bg-cyan-50/70', 'ring-1', 'ring-cyan-400');
      el.classList.add('border-slate-200', 'bg-white');
    });
    target.classList.remove('border-slate-200', 'bg-white');
    target.classList.add('border-cyan-500', 'bg-cyan-50/70', 'ring-1', 'ring-cyan-400');

    document.dispatchEvent(new CustomEvent('bg:map-focus', {
      detail: { id, lat, lng, dept, zoom: 13 }
    }));
  });

  // Escuchar cuando el usuario hace clic en un punto del mapa para resaltar la tarjeta en la lista
  document.addEventListener('bg:map-active-laguna', ((e: CustomEvent) => {
    const { id } = e.detail || {};
    if (!id) return;
    const clean = id.toLowerCase().replace(/^laguna:/i, '').trim();
    const card = document.querySelector(`.item-laguna[data-id="${clean}"]`) as HTMLElement | null;
    if (card) {
      document.querySelectorAll('.item-laguna').forEach(el => {
        el.classList.remove('border-cyan-500', 'bg-cyan-50/70', 'ring-1', 'ring-cyan-400');
        el.classList.add('border-slate-200', 'bg-white');
      });
      card.classList.remove('border-slate-200', 'bg-white');
      card.classList.add('border-cyan-500', 'bg-cyan-50/70', 'ring-1', 'ring-cyan-400');
      card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }) as EventListener);

  // Sincronizar catálogo ampliado desde el backend
  ApiService.getCatalogo(120).then((data) => {
    const catalogo = data?.lagunas;
    if (Array.isArray(catalogo) && catalogo.length > 0) {
      lagunasMemoria = catalogo;
      const deptActual = selectDept ? selectDept.value : 'todos';
      filtrarPorDepartamento(deptActual);
    }
  }).catch(() => {});

  // Sincronizar departamentos y conteos territoriales desde el backend
  ApiService.getDepartamentosRiesgo().then((deptos) => {
    if (deptos && deptos.length > 0) {
      deptosMemoria = deptos;
      if (selectDept) {
        const valActual = selectDept.value;
        const totalPais = deptos.reduce((acc: number, d: any) => acc + (d.total || 0), 0);
        selectDept.innerHTML = `
          <option value="todos">Todo el Perú (${totalPais} lagunas en riesgo)</option>
          ${deptos.map((d: any) => `<option value="${d.departamento.toLowerCase()}">${d.departamento} (${d.total} lagunas)</option>`).join('')}
        `;
        if (deptos.some((d: any) => d.departamento.toLowerCase() === valActual)) {
          selectDept.value = valActual;
        }
      }
      if (panelBadge && (!selectDept || selectDept.value === 'todos')) {
        const total = deptos.reduce((acc: number, d: any) => acc + (d.total || 0), 0);
        panelBadge.textContent = `${total} lagunas críticas`;
      }
    }
  }).catch(() => {});

  if (selectDept) {
    selectDept.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      filtrarPorDepartamento(val);
    });
  }
</script>
