---
import { SITE_CONFIG } from '../config/site.config';
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
  <div class="w-full flex h-16 items-center justify-between px-4 sm:px-8 lg:px-12 xl:px-16 2xl:px-20">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 transition-opacity hover:opacity-90">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-900 text-white font-semibold text-sm tracking-wider shadow-sm">
          BG
        </div>
        <div class="flex flex-col">
          <span class="text-sm font-bold tracking-tight text-slate-900">{SITE_CONFIG.name}</span>
          <span class="text-[10px] text-slate-500 font-medium tracking-wide">UNMSM · FISI · G8</span>
        </div>
      </a>

      <div class="hidden lg:flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50/80 px-3 py-1 text-xs text-slate-600">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span class="font-medium text-slate-700">398</span> informes oficiales
        <span class="text-slate-300">|</span>
        <span>Citas con evidencia</span>
      </div>
    </div>

    <!-- Navegación sobria -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600">
      {SITE_CONFIG.navigation.map(item => (
        <a 
          href={item.href} 
          class="transition-colors hover:text-slate-900 hover:border-b-2 hover:border-slate-900 py-1"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Acceso rápido al Asistente -->
    <div class="flex items-center gap-3">
      <button 
        id="btn-abrir-asistente"
        type="button"
        class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2"
      >
        <svg class="h-3.5 w-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
        <span>Consultar</span>
      </button>
    </div>
  </div>
</header>
