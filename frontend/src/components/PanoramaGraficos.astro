---
import { LAGUNAS_DESTACADAS } from '../config/metrics.data';

// 1) Burbujas: altitud (x) vs volumen (y), tamaño = informes que la respaldan, color = riesgo
const L = LAGUNAS_DESTACADAS.filter((l) => l.altitud_msnm && l.volumen_hm3);
const altMin = 3800, altMax = 5100;
const volMax = Math.max(...L.map((l) => l.volumen_hm3));
const docsMax = Math.max(...L.map((l) => l.total_documentos || 1));
const W = 640, H = 340, PX = 52, PY = 24;
const X = (a: number) => PX + ((Math.min(altMax, Math.max(altMin, a)) - altMin) / (altMax - altMin)) * (W - PX - 20);
// Escala raíz cuadrada para que las lagunas chicas no queden aplastadas
const Y = (v: number) => H - PY - (Math.sqrt(v) / Math.sqrt(volMax)) * (H - PY * 2 - 10);
const R = (d: number) => 6 + Math.sqrt((d || 1) / docsMax) * 18;
const color = (r: string) => (r === 'Muy alto' ? '#e11d48' : r === 'Alto' ? '#f97316' : r === 'Medio' ? '#eab308' : r === 'Bajo' ? '#16a34a' : '#94a3b8');
const ticksV = [1, 5, 15, 30, 55].filter((v) => v <= volMax + 1);
const ticksA = [3800, 4100, 4400, 4700, 5000];
const etiquetar = new Set([...L].sort((a, b) => b.volumen_hm3 - a.volumen_hm3).slice(0, 4).map((l) => l.id));

// 2) Obras por nivel de riesgo
const NIVELES = ['Muy alto', 'Alto', 'Medio', 'Bajo'];
const obras = NIVELES.map((n) => {
  const g = LAGUNAS_DESTACADAS.filter((l) => l.riesgo === n);
  return { n, con: g.filter((l) => l.tiene_obras).length, sin: g.filter((l) => !l.tiene_obras).length };
}).filter((o) => o.con + o.sin > 0);
const maxObras = Math.max(...obras.map((o) => o.con + o.sin));
const totalSin = obras.reduce((a, o) => a + o.sin, 0), totalObr = obras.reduce((a, o) => a + o.con + o.sin, 0);
---

<section class="w-full pb-12">
  <div class="mx-auto grid w-full max-w-[1400px] gap-5 px-4 sm:px-8 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:px-12">
    <article class="tarjeta tarjeta-hielo tejida flex flex-col p-5">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h3 class="font-display text-lg font-bold text-noche-900">Altura, agua y evidencia</h3>
        <div class="flex flex-wrap gap-3 text-xs text-slate-600">
          {['Muy alto', 'Alto', 'Medio', 'Bajo'].map((r) => <span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded-full" style={`background:${color(r)}`}></i>{r}</span>)}
        </div>
      </div>
      <p class="mt-1 text-sm text-slate-600">Cada burbuja es una laguna. Más grande, más informes la estudian. Tócala para preguntar.</p>
      <svg class="mt-3 h-auto w-full" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Lagunas según altitud y volumen">
        {ticksV.map((v) => (<g><line x1={PX} x2={W - 20} y1={Y(v)} y2={Y(v)} stroke="#dbeafe" /><text x={PX - 8} y={Y(v) + 4} text-anchor="end" font-size="11" fill="#64748b" font-family="IBM Plex Mono">{v}</text></g>))}
        {ticksA.map((a) => (<text x={X(a)} y={H - 4} text-anchor="middle" font-size="11" fill="#64748b" font-family="IBM Plex Mono">{a.toLocaleString('es-PE')} m</text>))}
        <text x="10" y={PY - 6} font-size="11" fill="#475569">hm³</text>
        {[...L].sort((a, b) => (b.total_documentos || 0) - (a.total_documentos || 0)).map((l) => (
          <g data-arqen-grafico="altitud-volumen" data-arqen-valor={l.nombre} data-arqen-laguna={l.nombre} data-arqen-laguna-id={l.id} role="button" tabindex="0" aria-label={`${l.nombre}: ${l.altitud_msnm} m, ${l.volumen_hm3} hm³, riesgo ${l.riesgo}`}>
            <title>{`${l.nombre} · ${l.altitud_msnm.toLocaleString('es-PE')} m · ${l.volumen_hm3} hm³ · ${l.total_documentos} informes`}</title>
            <circle cx={X(l.altitud_msnm)} cy={Y(l.volumen_hm3)} r={R(l.total_documentos)} fill={color(l.riesgo)} fill-opacity=".72" stroke="#fff" stroke-width="1.5" />
            {etiquetar.has(l.id) && <text x={X(l.altitud_msnm) + R(l.total_documentos) + 4} y={Y(l.volumen_hm3) + 4} font-size="11.5" font-weight="600" fill="#0b1838" paint-order="stroke" stroke="#f0f9ff" stroke-width="4" stroke-linejoin="round">{l.nombre}</text>}
          </g>
        ))}
      </svg>
      <p class="fuente mt-3">Catálogo de lagunas INAIGEM / ANA · {L.length} lagunas</p>
    </article>

    <article class="tarjeta tarjeta-laguna tejida flex flex-col p-5">
      <h3 class="font-display text-lg font-bold text-noche-900">¿Están protegidas?</h3>
      <p class="mt-1 text-sm text-slate-600">Lagunas con y sin obras de seguridad, por nivel de riesgo.</p>
      <div class="mt-4 flex items-end gap-3 rounded-2xl bg-white/80 p-4 ring-1 ring-cochinilla-100">
        <span class="font-display text-5xl font-bold leading-none text-cochinilla-600 tabular">{totalSin}</span>
        <span class="pb-1 text-sm text-slate-700">de {totalObr} lagunas del catálogo <b>no tienen obras</b> de seguridad registradas.</span>
      </div>
      <ul class="mt-5 flex flex-1 flex-col justify-evenly gap-4">
        {obras.map((o) => (
          <li>
            <button type="button" data-arqen-grafico="obras" data-arqen-valor={o.n} class="w-full text-left">
              <div class="flex items-center justify-between text-sm"><span class="font-semibold text-noche-900">{o.n}</span><span class="font-mono text-xs text-slate-500">{o.con + o.sin} {o.con + o.sin === 1 ? 'laguna' : 'lagunas'}</span></div>
              <div class="mt-1.5 flex h-6 overflow-hidden rounded-lg bg-white ring-1 ring-slate-100" style={`width:${Math.max(30, ((o.con + o.sin) / maxObras) * 100)}%`}>
                {o.con > 0 && <span class="flex items-center justify-center bg-laguna-600 text-[11px] font-semibold text-white" style={`flex:${o.con}`}>{o.con}</span>}
                {o.sin > 0 && <span class="flex items-center justify-center bg-cochinilla-500 text-[11px] font-semibold text-white" style={`flex:${o.sin}`}>{o.sin}</span>}
              </div>
            </button>
          </li>
        ))}
      </ul>
      <div class="mt-5 flex gap-4 text-xs text-slate-600">
        <span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded bg-laguna-600"></i>Con obras</span>
        <span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded bg-cochinilla-500"></i>Sin obras</span>
      </div>
      <p class="fuente mt-3">Inventario de obras · catálogo oficial</p>
    </article>
  </div>
</section>
