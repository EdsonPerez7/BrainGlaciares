---
// Perspectiva BSC "Base de conocimiento": calculado por
// frontend/scripts/generar_indicadores.mjs desde nodos.csv/relaciones.csv (Semana 7).
import FuenteCorte from './FuenteCorte.astro';
import { formatoEs } from './formato';
import grafo from '../../../public/data/grafo_indicadores.json';

const { calculado, nota_discrepancia_relaciones: discrepancia, citado_de_docs: citado, fecha_corte, archivos_origen } = grafo;

const nodosPorTipo = (Object.entries(calculado.nodos_por_tipo) as [string, number][]).sort((a, b) => b[1] - a[1]).slice(0, 8);
const maxNodo = Math.max(...nodosPorTipo.map(([, n]) => n));

const relPorTipo = (Object.entries(calculado.relaciones_por_tipo) as [string, number][]).sort((a, b) => b[1] - a[1]).slice(0, 6);
const maxRel = Math.max(...relPorTipo.map(([, n]) => n));
---
<article class="tarjeta tarjeta-laguna tejida flex flex-col p-5">
  <h3 class="font-display text-lg font-bold text-noche-900">{formatoEs(calculado.nodos_total)} nodos · {formatoEs(calculado.relaciones_total)} relaciones</h3>
  <p class="mt-1 text-sm text-slate-600">Grafo de conocimiento (Semana 7), tal como está en el CSV fuente hoy.</p>

  <div class="mt-4 grid gap-5 sm:grid-cols-2">
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Nodos por tipo (top 8)</h4>
      <ul class="mt-2 space-y-1.5">
        {nodosPorTipo.map(([tipo, n]) => (
          <li class="flex items-center gap-2 text-sm">
            <span class="w-28 flex-none truncate text-slate-700">{tipo}</span>
            <span class="flex h-3 flex-1 overflow-hidden rounded-full bg-white"><span style={`width:${(n / maxNodo) * 100}%; background:#0f766e`}></span></span>
            <span class="w-12 flex-none text-right font-mono text-xs text-slate-700">{formatoEs(n)}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Relaciones por tipo (top 6)</h4>
      <ul class="mt-2 space-y-1.5">
        {relPorTipo.map(([tipo, n]) => (
          <li class="flex items-center gap-2 text-sm">
            <span class="w-28 flex-none truncate text-slate-700">{tipo}</span>
            <span class="flex h-3 flex-1 overflow-hidden rounded-full bg-white"><span style={`width:${(n / maxRel) * 100}%; background:#d97706`}></span></span>
            <span class="w-12 flex-none text-right font-mono text-xs text-slate-700">{formatoEs(n)}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="mt-4 rounded-xl bg-rose-50 p-3 text-sm text-slate-700 ring-1 ring-rose-100">
    <b class="text-rose-800">Tres cifras distintas de "relaciones del grafo":</b> este CSV dice {formatoEs(discrepancia.este_csv_semana_7)}; el README/presentación dice {formatoEs(discrepancia.readme_presentacion.valor)}; Neo4j Aura en producción dice {formatoEs(discrepancia.neo4j_aura_produccion.valor)}. No se eligió una "correcta": se muestran las tres.
  </div>

  <div class="mt-3 rounded-xl bg-white/70 p-3 text-sm text-slate-600 ring-1 ring-slate-100">
    <b class="text-slate-800">Ontología OWL (calculado desde <code>glaciares.owl</code>):</b> {formatoEs(calculado.owl_clases)} clases,
    {formatoEs(calculado.owl_propiedades_total)} propiedades ({calculado.owl_propiedades_objeto} de objeto + {calculado.owl_propiedades_dato} de dato).
    La revisión con OOPS! (<code>revision_ontologia.md</code>) encontró {calculado.owl_categorias_pitfalls_v1_0} categorías de problemas en la versión 1.0,
    corregidas en la versión 1.1 ({calculado.owl_categorias_pitfalls_v1_1} categorías pendientes).
  </div>

  <div class="mt-3 rounded-xl bg-white/70 p-3 text-sm text-slate-600 ring-1 ring-slate-100">
    <b class="text-slate-800">Citado de otro archivo del repo (no calculable desde estos CSV):</b>
    <ul class="mt-1.5 list-disc space-y-0.5 pl-4">
      <li>{formatoEs(citado.hechos_tripletas.valor)} hechos (tripletas) y {formatoEs(citado.entidades_unicas.valor)} entidades únicas.</li>
      <li>{formatoEs(citado.hechos_confirmados_2_o_mas_documentos.valor)} hechos confirmados por 2 o más documentos.</li>
    </ul>
  </div>

  <FuenteCorte
    fuente={`Calculado desde ${archivos_origen.join(', ')}`}
    corte={fecha_corte}
    nota={`Hechos/entidades citados desde ${citado.hechos_tripletas.fuente}.`}
  />
</article>
