# Copia este archivo como .env y completa tus claves. El .env nunca se sube a GitHub (está en .gitignore).

# --- LLM: se necesita al menos una clave. Sin ninguna, el agente responde en modo evidencia (hechos con fuente, sin redactar) ---
GROQ_API_KEY=
GOOGLE_API_KEY=
# Orden de uso; si uno falla o agota su cuota se pasa al siguiente. Se omiten los proveedores sin clave.
# AGENTE_MODELOS=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-flash-lite-latest,gemini:gemini-flash-latest

# --- Grafo: Neo4j Aura (el mismo de las semanas 7 y 10). Sin esto o con la instancia en pausa, se usa la copia embebida ---
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Opcional: protege la API con una clave (los clientes la envían en la cabecera X-API-Key) ---
# AGENTE_API_KEY=

# --- Opcional: trazas de cada ejecución en LangSmith ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agente-glaciares

# --- Ajustes (estos son los valores por defecto) ---
# EMBEDDER=BAAI/bge-m3            # "ninguno" = solo BM25, para servidores con menos de 4 GB
# MAX_ITER=5                      # rondas máximas de herramientas por pregunta
# TIMEOUT_PREGUNTA=120            # segundos por pregunta
# MAX_CONCURRENCIA=4              # preguntas simultáneas
# LIMITE_IP_MIN=12                # preguntas por minuto de cada IP
# LIMITE_GLOBAL_MIN=40            # preguntas por minuto en total
# CORS_ORIGENES=                  # orígenes permitidos, separados por comas (vacío = solo el mismo sitio)
