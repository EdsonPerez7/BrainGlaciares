    <rdfs:label xml:lang="es">fuente</rdfs:label>
    <rdfs:comment xml:lang="es">Institución o repositorio de donde proviene el documento.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia#Hecho">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
