  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia#anioImagenes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/g8-glaciares/ontologia#Inventario"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="es">año de las imágenes</rdfs:label>
    <rdfs:comment xml:lang="es">Año de las imágenes satelitales usadas por el inventario.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="es">Ontología Enterprise Brain Glaciares (G8)</rdfs:label>
    <dcterms:description xml:lang="es">Riesgo glaciar en el Perú: glaciares, lagunas, poblados expuestos, eventos, obras, monitoreo y procedencia de cada hecho. Alineada a GeoSPARQL (lugares), SOSA/SSN (mediciones y métodos) y PROV-O (procedencia).</dcterms:description>
    <rdfs:seeAlso rdf:resource="http://www.opengis.net/ont/geosparql"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov-o"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:creator xml:lang="es">Grupo G8 · Gestión del Conocimiento · UNMSM 2026-II</dcterms:creator>
    <owl:versionInfo>1.1</owl:versionInfo>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</dcterms:created>
    <dcterms:source xml:lang="es">Informes técnicos de INAIGEM, ANA y SENAMHI</dcterms:source>
    <owl:versionIRI rdf:resource="https://w3id.org/g8-glaciares/ontologia/1.1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia#ubicadaEn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="es">ubicada en</rdfs:label>
    <rdfs:comment xml:lang="es">Está dentro de (laguna → subcuenca → provincia → departamento).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia#afectoA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="es">afecto a</rdfs:label>
    <rdfs:comment xml:lang="es">Poblado o zona afectada por el evento.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/g8-glaciares/ontologia#Evento"/>
    <rdfs:range rdf:resource="https://w3id.org/g8-glaciares/ontologia#UnidadTerritorial"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia#mencionadoEn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/g8-glaciares/ontologia#menciona"/>
    <rdfs:label xml:lang="es">mencionado en</rdfs:label>
    <rdfs:comment xml:lang="es">Inversa de 'menciona': la misma relación leída en sentido contrario.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="https://w3id.org/g8-glaciares/ontologia#Documento"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia#ocurrioEn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="es">ocurrio en</rdfs:label>
    <rdfs:comment xml:lang="es">Lugar de origen del evento.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/g8-glaciares/ontologia#Evento"/>
    <rdfs:range rdf:resource="https://w3id.org/g8-glaciares/ontologia#RasgoGeografico"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#atLocation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia#valor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/g8-glaciares/ontologia#Medicion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/hasSimpleResult"/>
    <rdfs:label xml:lang="es">valor</rdfs:label>
    <rdfs:comment xml:lang="es">Valor numérico de la medición.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia#inventarioDe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="es">inventario de</rdfs:label>
    <rdfs:comment xml:lang="es">Cordillera que describe el inventario.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/g8-glaciares/ontologia#Inventario"/>
    <rdfs:range rdf:resource="https://w3id.org/g8-glaciares/ontologia#Cordillera"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia#tieneNivelRiesgo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="es">tiene nivel riesgo</rdfs:label>
    <rdfs:comment xml:lang="es">Nivel de riesgo de desborde citado en un documento.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/g8-glaciares/ontologia#Laguna"/>
    <rdfs:range rdf:resource="https://w3id.org/g8-glaciares/ontologia#NivelRiesgo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia#amenazaA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="es">amenaza a</rdfs:label>
    <rdfs:comment xml:lang="es">Un desborde podría afectar a este poblado (aguas abajo).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/g8-glaciares/ontologia#RasgoGeografico"/>
    <rdfs:range rdf:resource="https://w3id.org/g8-glaciares/ontologia#UnidadTerritorial"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia#Documento">
