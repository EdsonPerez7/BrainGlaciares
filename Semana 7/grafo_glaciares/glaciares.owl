    <owl:disjointWith rdf:resource="https://w3id.org/g8-glaciares/ontologia#RasgoGeografico"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/g8-glaciares/ontologia#escenarioDe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/g8-glaciares/ontologia#ocurrioEn"/>
    <rdfs:label xml:lang="es">fue escenario de</rdfs:label>
    <rdfs:comment xml:lang="es">Inversa de 'ocurrioEn': la misma relación leída en sentido contrario.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/g8-glaciares/ontologia#RasgoGeografico"/>
    <rdfs:range rdf:resource="https://w3id.org/g8-glaciares/ontologia#Evento"/>
  </rdf:Description>
